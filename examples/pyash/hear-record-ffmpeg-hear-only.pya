exists su name ffmpeg input ob text "lavfi" be default ya
exists su name ffmpeg input device ob text "anullsrc=r=16000:cl=mono" be default ya
exists su hear be default ob name hear ya
su name prompt ob text "Generating /tmp/pyash-hear-input.wav and transcribing it with hear." be write do
su name cmd ob text "ffmpeg -y -f " to name cmd be plus do
su name cmd ob name ffmpeg input to name cmd be plus do
su name cmd ob text " -i " to name cmd be plus do
su name cmd ob name ffmpeg input device to name cmd be plus do
su name cmd ob text " -t 1 /tmp/pyash-hear-input.wav" to name cmd be plus do
su name run ob text of cmd be command do
exists su name output ob text "" be text ya
from filename "/tmp/pyash-hear-input.wav" to name output be hear do
ob name output be write do
