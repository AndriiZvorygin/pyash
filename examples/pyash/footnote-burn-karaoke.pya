from filename "../../module/footnote_video.pya" ob name footnote to name footnote be import do
ob text "ffmpeg -y -f lavfi -i color=c=black:s=720x1280:d=3 -f lavfi -i anullsrc=r=44100:cl=stereo -shortest -c:v libx264 -pix_fmt yuv420p -c:a aac /workplace/examples/out/footnote-base.mp4" be command do
ob text "1
00:00:00,000 --> 00:00:01,500
Love God with your whole heart.

2
00:00:01,500 --> 00:00:03,000
Trust Him in every decision.
" to filename "/workplace/examples/out/footnote-base.srt" be write do
from filename "/workplace/examples/out/footnote-base.srt" fromstate wo srt with filename "/workplace/examples/out/footnote-base.mp4" become wo video to filename "/workplace/examples/out/footnote-karaoke.mp4" as wo karaoke be footnote do
ob text "created /workplace/examples/out/footnote-karaoke.mp4" be write do
