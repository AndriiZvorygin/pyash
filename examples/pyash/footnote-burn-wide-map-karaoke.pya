from filename "../../module/brief_video.pya" to name brief video be import do
from filename "../../module/footnote_video.pya" ob name footnote to name footnote be import do

ob text "mkdir -p /workplace/examples/out" be command do
ob text "ffmpeg -y -f lavfi -i color=c=#101820:s=1280x720:d=4 -f lavfi -i anullsrc=r=44100:cl=stereo -shortest -c:v libx264 -pix_fmt yuv420p -c:a aac /workplace/examples/out/footnote-wide-base.mp4" be command do
ob text "ffmpeg -y -f lavfi -i color=c=#201010:s=720x1280:d=4 -f lavfi -i anullsrc=r=44100:cl=stereo -shortest -c:v libx264 -pix_fmt yuv420p -c:a aac /workplace/examples/out/footnote-tall-base.mp4" be command do

ob text "1
00:00:00,000 --> 00:00:02,000
Athens nearly collapsed under elite debt control.

2
00:00:02,000 --> 00:00:04,000
Solon restored ownership and social stability.
" to filename "/workplace/examples/out/footnote-wide-base.srt" be write do

ob text "1
00:00:00,000 --> 00:00:02,000
Small families lost farms and freedom.

2
00:00:02,000 --> 00:00:04,000
Reform can restore shared stability.
" to filename "/workplace/examples/out/footnote-tall-base.srt" be write do

su name wide mode stage to name text widescreen footnote mode be widescreen footnote mode do
su name wide margin stage to name num widescreen subtitle margin ratio be widescreen subtitle margin ratio do
ob text of ob of wide mode stage to name text wide mode be text do
ob text "wide map mode:" be write do
ob name text wide mode be write do
ob text "wide map margin:" be write do
ob num of ob of wide margin stage be write do
ob name text wide mode be equally from text "karaoke" then from filename "/workplace/examples/out/footnote-wide-base.srt" fromstate wo srt with filename "/workplace/examples/out/footnote-wide-base.mp4" become wo video to filename "/workplace/examples/out/footnote-wide-karaoke-map.mp4" as wo karaoke by num of ob of wide margin stage be footnote do
ob name text wide mode be equally from text "wordflow" then from filename "/workplace/examples/out/footnote-wide-base.srt" fromstate wo srt with filename "/workplace/examples/out/footnote-wide-base.mp4" become wo video to filename "/workplace/examples/out/footnote-wide-wordflow-map.mp4" as wo wordflow by num of ob of wide margin stage be footnote do

su name tall mode stage to name text shorts footnote mode be shorts footnote mode do
su name tall margin stage to name num shorts subtitle margin ratio be shorts subtitle margin ratio do
ob text of ob of tall mode stage to name text tall mode be text do
ob text "tall map mode:" be write do
ob name text tall mode be write do
ob text "tall map margin:" be write do
ob num of ob of tall margin stage be write do
ob name text tall mode be equally from text "karaoke" then from filename "/workplace/examples/out/footnote-tall-base.srt" fromstate wo srt with filename "/workplace/examples/out/footnote-tall-base.mp4" become wo video to filename "/workplace/examples/out/footnote-tall-karaoke-map.mp4" as wo karaoke by num of ob of tall margin stage be footnote do
ob name text tall mode be equally from text "wordflow" then from filename "/workplace/examples/out/footnote-tall-base.srt" fromstate wo srt with filename "/workplace/examples/out/footnote-tall-base.mp4" become wo video to filename "/workplace/examples/out/footnote-tall-wordflow-map.mp4" as wo wordflow by num of ob of tall margin stage be footnote do

ob text "created map-driven footnote outputs under /workplace/examples/out" be write do
