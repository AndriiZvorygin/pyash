ob filename text source be input ya

from filename "../../module/read_html_markdown.pya" ob name read to name read be import do
from filename "../../module/chip_refinery.pya" ob name chip to name chip be import do

exists su name confederation session chip style prompt ob text quoted.text.Create wise chips where each chip contains one full question and its full corresponding answer from this channeling session. Preserve complete question and answer units. Do not split a question away from its answer. Prefer chip boundaries at the beginning of each new question..text.quoted be text ya

exists su name text confederation artifacts segment ob text "artifacts" be text ya
exists su name text confederation stage segment ob text "/chip-stage-1" be text ya
exists su name text confederation produce segment ob text "know/produce" be text ya

su name confederation run root to name text confederation run root be ceremony def
  ob name run id to name text confederation run id be text do
  ob ve name "text confederation artifacts segment" "text confederation run id" to name text confederation run root be concatenate become wo filename do
  su name confederation run root ret
prah

su name confederation stage filename from text leaf to name filename output be ceremony def
  su name run root stage to name text confederation run root be confederation run root do
  ob ve name "text confederation run root" "text confederation stage segment" "text of from of this" to name filename output be concatenate become wo filename do
  su name output ret
prah

su name confederation final filename from text leaf to name filename output be ceremony def
  su name run root stage to name text confederation run root be confederation run root do
  ob ve name "text confederation run root" "text of from of this" to name filename output be concatenate become wo filename do
  su name output ret
prah

su name confederation produce filename from text leaf to name filename output be ceremony def
  ob ve name "text confederation produce segment" "text of from of this" to name filename output be concatenate become wo filename do
  su name output ret
prah

su name confederation qa wise chips be refinery def
  su name stage dir stage from text "" to name filename stage dir be confederation stage filename do
  su name stage directory ensure stage ob filename of ob of stage dir stage be directory do
  su name produce directory ensure stage ob name text confederation produce segment be directory do

  ob text "/source.html" to name text html leaf be text do
  su name html filename stage from text of ob of html leaf to name filename html filename be confederation stage filename do

  ob text "/source.md" to name text markdown leaf be text do
  su name markdown filename stage from text of ob of markdown leaf to name filename markdown filename be confederation stage filename do

  ob text "/session.md" to name text session leaf be text do
  su name session filename stage from text of ob of session leaf to name filename session filename be confederation stage filename do

  ob text "/wise_chips.series.pya" to name text wise leaf be text do
  su name stage wise filename stage from text of ob of wise leaf to name filename stage wise filename be confederation stage filename do
  su name final wise filename stage from text "/wise_chips.series.pya" to name filename final wise filename be confederation final filename do
  su name produce wise filename stage from text "/confederation-qa-wise_chips.series.pya" to name filename produce wise filename be confederation produce filename do

  su name download stage from filename of ob of source as wo web fromstate name https to filename of ob of html filename stage be download do
  from filename of ob of html filename stage fromstate wo html become wo markdown to name text markdown source be read do
  su name markdown write stage ob name markdown source to filename of ob of markdown filename stage be write do

  from name markdown source since text "# " to name text session markdown source be extract do
  su name session write stage ob name session markdown source to filename of ob of session filename stage be write do

  from name text session markdown source ob name text confederation session chip style prompt to name text confederation wise chips be chip do
  su name stage wise write stage ob name confederation wise chips to filename of ob of stage wise filename stage be write do
  su name final wise copy stage ob filename of ob of stage wise filename stage to filename of ob of final wise filename stage be copy do
  su name produce wise copy stage ob filename of ob of final wise filename stage to filename of ob of produce wise filename stage be copy do

  su name result out ob filename of ob of final wise filename stage be write do
prah

from name confederation qa wise chips be refinery do
