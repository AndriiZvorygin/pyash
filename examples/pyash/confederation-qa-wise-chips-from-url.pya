ob filename text source be input ya

from filename "../../module/extract_contents.pya" ob name extract to name extract be import do
from filename "../../module/read_html_markdown.pya" ob name read to name read be import do
from filename "../../module/chip_refinery.pya" ob name chip to name chip be import do

exists su name confederation session chip style prompt ob text quoted.text.Create wise chips where each chip contains one full question and its full corresponding answer from this channeling session. Preserve complete question and answer units. Do not split a question away from its answer. Prefer chip boundaries at the beginning of each new question..text.quoted be text ya

exists su name text confederation artifacts segment ob text "artifacts" be text ya
exists su name text confederation stage segment ob text "chip-stage-1" be text ya
exists su name text confederation produce segment ob text "know/produce" be text ya

su name confederation run root to name text confederation run root be ceremony def
  ob name run id to name text confederation run id be text do
  ob ve name "text confederation artifacts segment" "text confederation run id" to name text confederation run root be concatenate become wo filename do
  su name confederation run root ret
prah

su name confederation stage filename from name text leaf to name filename output be ceremony def
  su name run root stage to name text confederation run root be confederation run root do
  ob text of from of this to name text confederation leaf segment be text do
  ob ve name "text confederation run root" "text confederation stage segment" "text confederation leaf segment" to name text confederation stage path be concatenate become wo filename do
  su name output stage ob name text confederation stage path to name filename output be filename do
  su name output stage ret
prah

su name confederation final filename from name text leaf to name filename output be ceremony def
  su name run root stage to name text confederation run root be confederation run root do
  ob text of from of this to name text confederation leaf segment be text do
  ob ve name "text confederation run root" "text confederation leaf segment" to name text confederation final path be concatenate become wo filename do
  su name output stage ob name text confederation final path to name filename output be filename do
  su name output stage ret
prah

su name confederation produce filename from name text leaf to name filename output be ceremony def
  ob text of from of this to name text confederation leaf segment be text do
  ob ve name "text confederation produce segment" "text confederation leaf segment" to name text confederation produce path be concatenate become wo filename do
  su name output stage ob name text confederation produce path to name filename output be filename do
  su name output stage ret
prah

su name confederation qa wise chips be refinery def
  ob text "" to name text stage dir leaf be text do
  su name stage dir stage from name text stage dir leaf to name filename stage dir be confederation stage filename do
  su name stage directory ensure stage ob filename of ob of stage dir stage be directory do
  su name produce directory ensure stage ob name text confederation produce segment be directory do

  ob text "source.html" to name text html leaf be text do
  su name html filename stage from name text html leaf to name filename html filename be confederation stage filename do

  ob text "source.md" to name text markdown leaf be text do
  su name markdown filename stage from name text markdown leaf to name filename markdown filename be confederation stage filename do

  ob text "session.md" to name text session markdown leaf be text do
  su name session markdown filename stage from name text session markdown leaf to name filename session markdown filename be confederation stage filename do

  ob text "contents.html" to name text contents html leaf be text do
  su name contents html filename stage from name text contents html leaf to name filename contents html filename be confederation stage filename do

  ob text "wise_chips.series.pya" to name text wise leaf be text do
  su name stage wise filename stage from name text wise leaf to name filename stage wise filename be confederation stage filename do
  ob text "wise_chips-trimmed.series.pya" to name text wise trimmed leaf be text do
  su name stage wise trimmed filename stage from name text wise trimmed leaf to name filename stage wise trimmed filename be confederation stage filename do
  su name final wise filename stage from name text wise leaf to name filename final wise filename be confederation final filename do
  ob text "confederation-qa-wise_chips.series.pya" to name text produce wise leaf be text do
  su name produce wise filename stage from name text produce wise leaf to name filename produce wise filename be confederation produce filename do

  su name download stage from filename of ob of source as wo web fromstate name https to filename of ob of html filename stage be download do
  from filename of ob of html filename stage fromstate wo html become wo html as wo contents to filename of ob of contents html filename stage be extract do
  from filename of ob of contents html filename stage fromstate wo html become wo markdown to name text markdown source be read do
  su name markdown write stage ob name markdown source to filename of ob of markdown filename stage be write do
  from name text markdown source since text "Topics:" until text "------------------------------------------------------------------------" to name text session markdown source be extract do
  su name session markdown write stage ob name text session markdown source to filename of ob of session markdown filename stage be write do

  from name text session markdown source with name text confederation session chip style prompt to name series confederation wise chips be chip do
  su name stage wise write stage ob name confederation wise chips to filename of ob of stage wise filename stage be write do
  ob filename of ob of stage wise filename stage to name text stage wise path be text do
  ob filename of ob of stage wise trimmed filename stage to name text stage wise trimmed path be text do
  ob text "node command/trim_confederation_qa_series.mjs \"" to name text trim wise command be text do
  ob name text stage wise path to name text trim wise command be plus do
  ob text "\" \"" to name text trim wise command be plus do
  ob name text stage wise trimmed path to name text trim wise command be plus do
  ob text "\"" to name text trim wise command be plus do
  su name trim wise stage ob name text trim wise command be command do
  su name final wise copy stage ob filename of ob of stage wise trimmed filename stage to filename of ob of final wise filename stage be copy do
  su name produce wise copy stage ob filename of ob of final wise filename stage to filename of ob of produce wise filename stage be copy do

  ob filename of ob of final wise filename stage to name text result out be text do
  su name result out ob name text result out be write do
prah

from name confederation qa wise chips be refinery do
