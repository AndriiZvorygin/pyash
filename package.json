{
  "name": "pyash",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node command/run-tests.mjs",
    "test:houses": "PYASH_INCLUDE_HOUSE_TESTS=1 node command/run-tests.mjs",
    "test:ci": "node --test --test-concurrency=1 quiz/core.test.mjs quiz/codex_account_cli.test.mjs quiz/runtime/*.test.mjs",
    "quiz": "node command/run-tests.mjs",
    "bootstrap": "node command/bootstrap_caterer.mjs",
    "package:check": "node command/check_package_size.mjs",
    "config:safety": "node command/check_local_config_safety.mjs",
    "doc:prose": "node command/check_doc_prose.mjs",
    "measure:balance": "node command/measure_code_balance.mjs",
    "examples:audit": "node command/audit_examples.mjs",
    "android:default": "node command/android_default_device.mjs",
    "android:worker": "node command/android_host_worker.mjs",
    "android:bridge": "node command/android_host_listener.mjs",
    "work:supervisor": "node command/work_supervisor.mjs",
    "work:smoke": "node command/run_work_supervisor_smoke.mjs",
    "repl": "node program/main.mjs",
    "run": "node command/run_pya_program.mjs",
    "trace": "node command/read_pya_trace.mjs",
    "criterion": "node command/criterion.mjs",
    "compile": "node command/run_pya_program.mjs --gross",
    "push:all": "bash command/push_all.sh",
    "smoke:wide-teaching-video": "bash command/smoke_wide_teaching_video.sh"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "csv-parse": "^7.0.3",
    "jsdom": "^28.1.0",
    "markdown-it": "^14.1.1",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.63",
    "eslint": "^9.32.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "bin": {
    "pyash": "command/pyash.mjs",
    "wordsuggest": "command/vocab_suggest.mjs",
    "kwon": "command/vocab_suggest.mjs",
    "print-audit": "command/print_audit_report.mjs",
    "print-audit-reconcile": "command/print_audit_reconcile.mjs"
  },
  "files": [
    "program/",
    "command/",
    "criterion/",
    "module/",
    "documentation/",
    "configure/",
    "examples/pyash/",
    "examples/TEMPLATE.md",
    "caterer/cjson/",
    "caterer/curl/include/",
    "caterer/pyac/lyac/",
    "caterer/quickjs-wasi/",
    "caterer/zsv/include/",
    "caterer/zsv/src/",
    "skills/",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ]
}
