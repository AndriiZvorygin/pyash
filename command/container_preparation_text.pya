su name container preparation text be map def
  su name title ob text "Pyash container preparation" be text ya
  su name intro ob text "This wizard prepares a Docker environment for Pyash." be text ya
  su name docker_missing ob text "Docker is not installed. Please install Docker and re-run this preparation." be text ya
  su name docker_not_running ob text "Docker is installed but not running. Start the Docker service and re-run this preparation." be text ya
  su name preflight_title ob text "System check" be text ya
  su name preflight_intro ob text "Preflight summary (non-blocking):" be text ya
  su name preflight_gpu ob text "GPU detected" be text ya
  su name preflight_gpu_missing ob text "GPU not detected" be text ya
  su name preflight_ram ob text "RAM (GiB)" be text ya
  su name preflight_disk ob text "Free disk (GiB)" be text ya
  su name preflight_vram ob text "VRAM (GiB)" be text ya
  su name preflight_cores ob text "CPU cores" be text ya
  su name preflight_bogomips ob text "Bogomips" be text ya
  su name preflight_note ob text "Use these numbers to pick smaller models if performance is slow." be text ya
  su name preflight_guidance ob text "Guidance:" be text ya
  su name enable_gpu ob text "Enable GPU support (NVIDIA)?" be text ya
  su name enable_audio ob text "Enable PulseAudio passthrough?" be text ya
  su name enable_vnc ob text "Expose VNC/noVNC ports (5900/6080)?" be text ya
  su name audio_missing ob text "Audio was requested but PulseAudio files were not found. Ensure /run/user/<uid>/pulse/native and ~/.config/pulse/cookie exist." be text ya
  su name gpu_missing ob text "GPU was requested but no NVIDIA device was detected. Continue without GPU?" be text ya
  su name build_cmd ob text "Build command:" be text ya
  su name run_cmd ob text "Run command:" be text ya
  su name run_now ob text "Run build + container now?" be text ya
prah
