# Example environment variables for Pyash
# Copy to a local .env or export as needed.

# Mind / Ollama
# Base URL for Ollama HTTP API when using the mind verb.
OLLAMA_HOST="http://localhost:11434"
# Optional model name used by Ollama stream quizzes.
OLLAMA_TEST_MODEL=""
# Fixture response for mind (string or JSON); bypasses live Ollama.
PYA_MIND_RESPONSE=""
# When set to 1, stream mind chunks or hear stream lines to stdout as they arrive.
PYA_STREAM_STDOUT=0
# Enable live Ollama streaming quiz (set to 1 to run).
PYA_OLLAMA_STREAM_TEST=0

# Command fixtures
# Fixture output for `be command do` to avoid shelling out.
PYA_COMMAND_RESPONSE=""

# Say / Piper
# Override piper binary path.
PYA_PIPER_BIN=""
# Override voice id for piper.
PYA_PIPER_VOICE=""
# Fixture audio bytes for piper (text is written as bytes).
PYA_PIPER_FIXTURE=""
# Override audio player command (e.g., aplay/afplay).
PYA_AUDIO_PLAYER=""
# Disable speaker playback for piper (1 = silent).
PYA_SAY_SILENT=0
# Treat audio playback failures as errors (1 = strict).
PYA_SAY_STRICT_AUDIO=0

# Hear / Whisper
# Override whisper-main binary path.
PYA_HEAR_BIN=""
# Override whisper-stream binary path.
PYA_HEAR_STREAM_BIN=""
# Override whisper model path.
PYA_HEAR_MODEL=""
# Override language (auto, en, ru, ...).
PYA_HEAR_LANGUAGE="auto"
# Capture device id for whisper-stream (default 0).
PYA_HEAR_CAPTURE=0
# Fixture transcript for hear (used by eval/stream tests).
PYA_HEAR_FIXTURE=""

# Replay / checkpoints
# Override checkpoint reuse directory for --again / refinery runs.
PYA_CHECKPOINTS=""
# Disable checkpoint reuse when running compiled refinery binaries.
PYA_NO_CHECKPOINT=0

# Run recording / newspapers
# Enable newspaper emission from compiled runs.
PYA_NEWSPAPER=0
# Override run id for compiled exchange recording.
PYA_RUN_ID=""

# Refinery runners (compiled JS/C)
# When set, compiled binaries run the named refinery instead of the main module.
PYA_REFINERY=""
