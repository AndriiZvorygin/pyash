# Example environment variables for Pyash
# Copy to a local .env or export as needed.
#
# Env values are imported into memory as defaults (e.g., `exists exists su name ... be default ya`)
# and are overridden by `configure/default.pya` or any sentence that sets the same `su`.

# Mind / Ollama
# Base URL for Ollama HTTP API when using the mind verb.
# Memory: `exists su name ollama host ob text "<url>" be default ya`
OLLAMA_HOST="http://localhost:11434"
# Optional model name used by Ollama stream quizzes.
# Memory: `exists su name ollama test model ob text "<model>" be default ya`
OLLAMA_TEST_MODEL=""
# Fixture response for mind (string or JSON); bypasses live Ollama.
# Memory: `exists su name mind response ob text "<response>" be default ya`
PYA_MIND_RESPONSE=""
# Stream mind chunks or hear stream lines to stdout as they arrive.
# Default: enabled when stdout is a TTY (set to 0 to force off, 1 to force on).
# Memory: `exists su name stream stdout ob bool <truth|lie> be default ya`
PYA_STREAM_STDOUT=0
# Enable live Ollama streaming quiz (set to 1 to run).
# Memory: `exists su name ollama stream test ob bool <truth|lie> be default ya`
PYA_OLLAMA_STREAM_TEST=0

# Command fixtures
# Fixture output for `be command do` to avoid shelling out.
# Memory: `exists su name command response ob text "<output>" be default ya`
PYA_COMMAND_RESPONSE=""

# Say / Piper
# Override piper binary path.
# Memory: `exists su name piper bin ob text "<path>" be default ya`
PYA_PIPER_BIN=""
# Override voice id for piper.
# Memory: `exists su name piper voice ob text "<voice>" be default ya`
PYA_PIPER_VOICE=""
# Fixture audio bytes for piper (text is written as bytes).
# Memory: `exists su name piper fixture ob text "<bytes>" be default ya`
PYA_PIPER_FIXTURE=""
# Override audio player command (e.g., aplay/afplay).
# Memory: `exists su name audio player ob text "<player>" be default ya`
PYA_AUDIO_PLAYER=""
# Disable speaker playback for piper (1 = silent).
# Memory: `exists su name say silent ob bool <truth|lie> be default ya`
PYA_SAY_SILENT=0
# Treat audio playback failures as errors (1 = strict).
# Memory: `exists su name say strict audio ob bool <truth|lie> be default ya`
PYA_SAY_STRICT_AUDIO=0
# Override espeak-ng binary path.
# Memory: `exists su name espeak bin ob text "<path>" be default ya`
PYA_ESPEAK_BIN=""
# Delay (ms) before flushing partial TTS when streaming (default 150).
# Memory: `exists su name say stream delay ob num <ms> be default ya`
PYA_SAY_STREAM_DELAY_MS=300

# Hear / Whisper
# Override whisper-main binary path.
# Memory: `exists su name hear bin ob text "<path>" be default ya`
PYA_HEAR_BIN=""
# Override whisper-stream binary path.
# Memory: `exists su name hear stream bin ob text "<path>" be default ya`
PYA_HEAR_STREAM_BIN=""
# Override whisper model path.
# Memory: `exists su name hear model ob text "<path>" be default ya`
PYA_HEAR_MODEL=""
# Override language (auto, en, ru, ...).
# Memory: `exists su name hear language ob text "<lang>" be default ya`
PYA_HEAR_LANGUAGE="auto"
# Capture device id for whisper-stream (default 0).
# Memory: `exists su name hear capture ob num <id> be default ya`
PYA_HEAR_CAPTURE=0
# Fixture transcript for hear (used by eval/stream tests).
# Memory: `exists su name hear fixture ob text "<transcript>" be default ya`
PYA_HEAR_FIXTURE=""

# Keyboard output
# Override keyboard injection binary (default: xdotool).
# Memory: `exists su name keyboard bin ob text "<path>" be default ya`
PYA_KEYBOARD_BIN=""

# Replay / checkpoints
# Override checkpoint reuse directory for --again / refinery runs.
# Memory: `exists su name checkpoint seed ob text "<path>" be default ya`
PYA_CHECKPOINTS=""
# Disable checkpoint reuse when running compiled refinery binaries.
# Memory: `exists su name checkpoint disabled ob bool <truth|lie> be default ya`
PYA_NO_CHECKPOINT=0

# Run recording / newspapers
# Enable newspaper emission from compiled runs.
# Memory: `exists su name newspaper enabled ob bool <truth|lie> be default ya`
PYA_NEWSPAPER=0
# Override run id for compiled exchange recording.
# Memory: `exists su name run id ob text "<id>" be default ya`
PYA_RUN_ID=""

# Refinery runners (compiled JS/C)
# When set, compiled binaries run the named refinery instead of the main module.
# Memory: `exists su name refinery name ob text "<name>" be default ya`
PYA_REFINERY=""
