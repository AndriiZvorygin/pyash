#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: ./crun <path/to/file.pya>" >&2
  exit 2
fi

SRC="$1"
if [[ ! -f "$SRC" ]]; then
  echo "crun: file not found: $SRC" >&2
  exit 2
fi

BASE="$(basename "$SRC")"
NAME="${BASE%.*}"
TMP_C="/tmp/${NAME}-pyash.c"
TMP_EXE="/tmp/${NAME}-pyash"

./compile from filename "$SRC" become c to filename "$TMP_C"
gcc -std=c11 -O0 -o "$TMP_EXE" "$TMP_C" -lm
"$TMP_EXE"
