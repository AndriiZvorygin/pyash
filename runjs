#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: ./runjs [--again] [--newspaper] [--run-id <id>] [--run-time <iso>] [--refinery <name>] <path/to/file.pya>" >&2
  exit 2
fi

NEWSPAPER=0
RUN_ID=""
RUN_TIME=""
REFINERY=""
AGAIN=0
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --again)
      AGAIN=1
      shift
      ;;
    --newspaper)
      NEWSPAPER=1
      shift
      ;;
    --run-id)
      RUN_ID="$2"
      shift 2
      ;;
    --run-time)
      RUN_TIME="$2"
      shift 2
      ;;
    --run-id=*)
      RUN_ID="${1#*=}"
      shift
      ;;
    --run-time=*)
      RUN_TIME="${1#*=}"
      shift
      ;;
    --refinery)
      REFINERY="$2"
      shift 2
      ;;
    --refinery=*)
      REFINERY="${1#*=}"
      shift
      ;;
    --*)
      shift
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="${POSITIONAL[0]:-}"
if [[ ! -f "$SRC" ]]; then
  echo "runjs: file not found: $SRC" >&2
  exit 2
fi

if [[ "$AGAIN" -eq 1 ]]; then
  NEWSPAPER=1
fi

BASE="$(basename "$SRC")"
NAME="${BASE%.*}"
TMP_JS="$(mktemp "/tmp/${NAME}-pyash-XXXXXX.mjs")"

"$SCRIPT_DIR/compile" from filename "$SRC" become javascript to filename "$TMP_JS" > /tmp/pyash-compile-runjs.log
if [[ "$NEWSPAPER" -eq 1 ]]; then
  RUN_ARGS=()
  if [[ -n "$RUN_ID" ]]; then
    RUN_ARGS+=(--run-id "$RUN_ID")
  fi
  if [[ -n "$RUN_TIME" ]]; then
    RUN_ARGS+=(--run-time "$RUN_TIME")
  fi
  if [[ "$AGAIN" -eq 1 ]]; then
    RUN_ARGS+=(--again)
  fi
  if [[ -n "$REFINERY" ]]; then
    PYA_REFINERY="$REFINERY" node "$SCRIPT_DIR/program/command/run_with_newspaper.mjs" --source "$SRC" "${RUN_ARGS[@]}" -- node "$TMP_JS"
  else
    node "$SCRIPT_DIR/program/command/run_with_newspaper.mjs" --source "$SRC" "${RUN_ARGS[@]}" -- node "$TMP_JS"
  fi
else
  if [[ -n "$REFINERY" ]]; then
    PYA_REFINERY="$REFINERY" node "$TMP_JS"
  else
    node "$TMP_JS"
  fi
fi
