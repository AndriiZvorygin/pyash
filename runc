#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: ./runc [--again] [--newspaper] [--no-checkpoint] [--run-id <id>] [--run-time <iso>] [--refinery <name>] <path/to/file.pya>" >&2
  exit 2
fi

NEWSPAPER=0
RUN_ID=""
RUN_TIME=""
REFINERY=""
AGAIN=0
NO_CHECKPOINT=0
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --again)
      AGAIN=1
      shift
      ;;
    --newspaper)
      NEWSPAPER=1
      shift
      ;;
    --no-checkpoint)
      NO_CHECKPOINT=1
      shift
      ;;
    --run-id)
      RUN_ID="$2"
      shift 2
      ;;
    --run-time)
      RUN_TIME="$2"
      shift 2
      ;;
    --run-id=*)
      RUN_ID="${1#*=}"
      shift
      ;;
    --run-time=*)
      RUN_TIME="${1#*=}"
      shift
      ;;
    --refinery)
      REFINERY="$2"
      shift 2
      ;;
    --refinery=*)
      REFINERY="${1#*=}"
      shift
      ;;
    --*)
      shift
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="${POSITIONAL[0]:-}"
if [[ ! -f "$SRC" ]]; then
  echo "crun: file not found: $SRC" >&2
  exit 2
fi

if [[ "$AGAIN" -eq 1 ]]; then
  NEWSPAPER=1
fi

BASE="$(basename "$SRC")"
NAME="${BASE%.*}"
TMP_C="$(mktemp "/tmp/${NAME}-pyash-XXXXXX.c")"
TMP_EXE="$(mktemp "/tmp/${NAME}-pyash-XXXXXX")"

"$SCRIPT_DIR/compile" from filename "$SRC" become c to filename "$TMP_C" > /tmp/pyash-compile-runc.log
ZSV_SRC=()
ZSV_FLAGS=()
if rg -q "PYA_CSV_RUNTIME" "$TMP_C"; then
  ZSV_SRC=("caterer/zsv/src/zsv.c")
  ZSV_FLAGS=("-Icaterer/zsv/include" "-Icaterer/zsv/src")
fi
CURL_FLAGS=()
CURL_LIBS=()
if rg -q "PYA_MIND_RUNTIME" "$TMP_C"; then
  CURL_FLAGS=("-Icaterer/curl/include")
  CURL_LIBS=("-lcurl")
fi
YAML_LIB=()
if rg -q "PYA_YAML_RUNTIME" "$TMP_C"; then
  YAML_LIB=("-lyaml")
fi
gcc -std=c11 -O0 -o "$TMP_EXE" "${ZSV_FLAGS[@]}" "${CURL_FLAGS[@]}" "$TMP_C" "${ZSV_SRC[@]}" -lm "${YAML_LIB[@]}" "${CURL_LIBS[@]}"
if [[ "$NEWSPAPER" -eq 1 ]]; then
  RUN_ARGS=()
  if [[ -n "$RUN_ID" ]]; then
    RUN_ARGS+=(--run-id "$RUN_ID")
  fi
  if [[ -n "$RUN_TIME" ]]; then
    RUN_ARGS+=(--run-time "$RUN_TIME")
  fi
  if [[ "$NO_CHECKPOINT" -eq 1 ]]; then
    RUN_ARGS+=(--no-checkpoint)
  fi
  if [[ "$AGAIN" -eq 1 ]]; then
    RUN_ARGS+=(--again)
  fi
  if [[ -n "$REFINERY" ]]; then
    PYA_REFINERY="$REFINERY" node "$SCRIPT_DIR/program/command/run_with_newspaper.mjs" --source "$SRC" "${RUN_ARGS[@]}" -- "$TMP_EXE"
  else
    node "$SCRIPT_DIR/program/command/run_with_newspaper.mjs" --source "$SRC" "${RUN_ARGS[@]}" -- "$TMP_EXE"
  fi
else
  if [[ -n "$REFINERY" ]]; then
    PYA_REFINERY="$REFINERY" "$TMP_EXE"
  else
    "$TMP_EXE"
  fi
fi
