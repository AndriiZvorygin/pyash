#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: ./crun <path/to/file.pya>" >&2
  exit 2
fi

SRC="$1"
if [[ ! -f "$SRC" ]]; then
  echo "crun: file not found: $SRC" >&2
  exit 2
fi

BASE="$(basename "$SRC")"
NAME="${BASE%.*}"
TMP_C="/tmp/${NAME}-pyash.c"
TMP_EXE="/tmp/${NAME}-pyash"

./compile from filename "$SRC" become c to filename "$TMP_C"
ZSV_SRC=()
ZSV_FLAGS=()
if rg -q "PYA_CSV_RUNTIME" "$TMP_C"; then
  ZSV_SRC=("caterer/zsv/src/zsv.c")
  ZSV_FLAGS=("-Icaterer/zsv/include" "-Icaterer/zsv/src")
fi
YAML_LIB=()
if rg -q "PYA_YAML_RUNTIME" "$TMP_C"; then
  YAML_LIB=("-lyaml")
fi
gcc -std=c11 -O0 -o "$TMP_EXE" "${ZSV_FLAGS[@]}" "$TMP_C" "${ZSV_SRC[@]}" -lm "${YAML_LIB[@]}"
"$TMP_EXE"
