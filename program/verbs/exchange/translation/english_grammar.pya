su text "anybody" ob text "{\"surface\":\"anybody\",\"kind\":\"pronoun\",\"components\":[\"person_\",\"elective_quantifier_\"],\"pyashSequence\":[\"cyah\",\"tlah\"],\"position\":\"standalone\",\"evidence\":\"same person_ plus elective_quantifier_ construction as anyone\"}" ya
