su name translation_english_grammar be map def
su text "format" ob text "english-grammar-v1" ya
su text "source" ob text "lwonprom/documentation/grammaticalCase.tex and lwonprom/program/pyashWords.h" ya
su text "i" ob text "{\"surface\":\"i\",\"kind\":\"pronoun\",\"components\":[\"me_\"],\"pyashSequence\":[\"mi\"],\"position\":\"standalone\",\"evidence\":\"lwonprom person-deixis grammar particle me_ is mi; lexical me root remains hman for compound words.\"}" ya
su text "me" ob text "{\"surface\":\"me\",\"kind\":\"pronoun\",\"components\":[\"me_\"],\"pyashSequence\":[\"mi\"],\"position\":\"standalone\",\"evidence\":\"lwonprom person-deixis grammar particle me_ is mi; lexical me root remains hman for compound words.\"}" ya
su text "we" ob text "{\"surface\":\"we\",\"kind\":\"pronoun\",\"components\":[\"us_\"],\"pyashSequence\":[\"nyah\"],\"position\":\"standalone\",\"evidence\":\"lwonprom person-deixis grammar particle us_ is nyah; lexical us root remains hwam for compound words.\"}" ya
su text "us" ob text "{\"surface\":\"us\",\"kind\":\"pronoun\",\"components\":[\"us_\"],\"pyashSequence\":[\"nyah\"],\"position\":\"standalone\",\"evidence\":\"lwonprom person-deixis grammar particle us_ is nyah; lexical us root remains hwam for compound words.\"}" ya
su text "you" ob text "{\"surface\":\"you\",\"kind\":\"pronoun\",\"components\":[\"you_\"],\"pyashSequence\":[\"sa\"],\"position\":\"standalone\",\"evidence\":\"lwonprom person-deixis grammar particle you_ is sa; lexical you root remains hnan for compound words.\"}" ya
su text "our" ob text "{\"surface\":\"our\",\"kind\":\"possessive-determiner\",\"components\":[\"us_\",\"possessive_marker_\"],\"pyashSequence\":[\"nyah\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"lwonprom person-deixis grammar particle us_ is nyah; possessive_marker_ is ye. The lexical us root remains hwam for compound words.\"}" ya
su text "your" ob text "{\"surface\":\"your\",\"kind\":\"possessive-determiner\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"lwonprom person-deixis grammar particle you_ is sa; possessive_marker_ is ye. The lexical you root remains hnan for compound words.\"}" ya
su text "thy" ob text "{\"surface\":\"thy\",\"kind\":\"possessive-determiner\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"English archaic possessive determiner thy follows the you_ plus possessive_marker_ construction.\"}" ya
su text "thine" ob text "{\"surface\":\"thine\",\"kind\":\"possessive-pronoun\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"standalone\",\"evidence\":\"English archaic possessive pronoun thine follows the you_ plus possessive_marker_ construction.\"}" ya
su text "my" ob text "{\"surface\":\"my\",\"kind\":\"possessive-determiner\",\"components\":[\"me_\",\"possessive_marker_\"],\"pyashSequence\":[\"mi\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"lwonprom person-deixis grammar particle me_ is mi; possessive_marker_ is ye. The lexical me root remains hman for compound words.\"}" ya
su text "ours" ob text "{\"surface\":\"ours\",\"kind\":\"possessive-pronoun\",\"components\":[\"us_\",\"possessive_marker_\"],\"pyashSequence\":[\"nyah\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"same grammar construction as our: us_ is nyah followed by possessive_marker_ ye; lexical us remains hwam for compound words.\"}" ya
su text "yours" ob text "{\"surface\":\"yours\",\"kind\":\"possessive-pronoun\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"standalone\",\"evidence\":\"same grammar construction as your: you_ is sa followed by possessive_marker_ ye; lexical you root remains hnan for compound words.\"}" ya
su text "and" ob text "{\"surface\":\"and\",\"kind\":\"conjunction\",\"components\":[\"and_\"],\"pyashSequence\":[\"wa\"],\"position\":\"link\",\"evidence\":\"lwonprom conjunction grammar particle and_ is wa; lexical and root remains hwan for compound words.\"}" ya
su text "also" ob text "{\"surface\":\"also\",\"kind\":\"conjunction\",\"components\":[\"also_\"],\"pyashSequence\":[\"pcah\"],\"position\":\"link\",\"evidence\":\"lwonprom conjunction grammar particle also_ is pcah; lexical also root remains hyac for compound words.\"}" ya
su text "but" ob text "{\"surface\":\"but\",\"kind\":\"conjunction\",\"components\":[\"but_\"],\"pyashSequence\":[\"pyuh\"],\"position\":\"link\",\"evidence\":\"lwonprom conjunction grammar particle but_ is pyuh; lexical but root remains hlan for compound words.\"}" ya
su text "not" ob text "{\"surface\":\"not\",\"kind\":\"negation\",\"components\":[\"negatory_quantifier_\"],\"pyashSequence\":[\"no\"],\"position\":\"prefix\",\"evidence\":\"lwonprom negatory quantifier grammar particle negatory_quantifier_ is no.\"}" ya
su text "never" ob text "{\"surface\":\"never\",\"kind\":\"negation\",\"components\":[\"negatory_quantifier_\"],\"pyashSequence\":[\"no\"],\"position\":\"prefix\",\"evidence\":\"English negative adverb never lowers to the negatory quantifier particle no for this sentence layer.\"}" ya
su text "plural" ob text "{\"surface\":\"plural\",\"kind\":\"number-marker\",\"components\":[\"plural_number_\"],\"pyashSequence\":[\"pu\"],\"position\":\"suffix\",\"evidence\":\"lwonprom noun phrase grammar uses plural-number as the noun suffix; current grammar marker is pu\"}" ya
su text "possessive" ob text "{\"surface\":\"possessive\",\"kind\":\"case-marker\",\"components\":[\"possessive_marker_\"],\"pyashSequence\":[\"ye\"],\"position\":\"suffix\",\"evidence\":\"current Pyash grammar marker possessive_marker_ is ye\"}" ya
su text "genitive" ob text "{\"surface\":\"genitive\",\"kind\":\"case-marker\",\"components\":[\"genitive_case_\"],\"pyashSequence\":[\"ti\"],\"position\":\"link\",\"evidence\":\"lwonprom grammaticalCase.tex assigns genitive case to ti\"}" ya
su text "of" ob text "{\"surface\":\"of\",\"kind\":\"case-marker\",\"components\":[\"genitive_case_\"],\"pyashSequence\":[\"ti\"],\"position\":\"link\",\"evidence\":\"English of-phrases use the lwonprom genitive case marker ti unless the source explicitly marks possession\"}" ya
su text "it" ob text "{\"surface\":\"it\",\"kind\":\"pronoun\",\"components\":[\"it_\"],\"pyashSequence\":[\"ya\"],\"position\":\"standalone\",\"evidence\":\"lwonprom it_ grammar particle is ya; lexical it root remains htit for compound words\"}" ya
su text "thing" ob text "{\"surface\":\"thing\",\"kind\":\"pronoun\",\"components\":[\"it_\"],\"pyashSequence\":[\"ya\"],\"position\":\"standalone\",\"evidence\":\"generic English thing uses the lwonprom it_ pro-form ya at the sentence layer\"}" ya
su text "things" ob text "{\"surface\":\"things\",\"kind\":\"pronoun\",\"components\":[\"it_\",\"plural_number_\"],\"pyashSequence\":[\"ya\",\"pu\"],\"position\":\"standalone\",\"evidence\":\"generic English things composes the it_ pro-form ya with plural-number pu\"}" ya
su text "this" ob text "{\"surface\":\"this\",\"kind\":\"pronoun\",\"components\":[\"demonstrative_\"],\"pyashSequence\":[\"tsah\"],\"position\":\"standalone\",\"evidence\":\"English proximal or default demonstrative uses the lwonprom demonstrative_ grammar particle tsah\"}" ya
su text "within" ob text "{\"surface\":\"within\",\"kind\":\"case-marker\",\"components\":[\"perlative_case_\"],\"pyashSequence\":[\"lwah\"],\"position\":\"link\",\"evidence\":\"English spatial within uses the interior-context way axis and perlative case lwah\"}" ya
su text "someone" ob text "{\"surface\":\"someone\",\"kind\":\"pronoun\",\"components\":[\"person_\",\"assertive_quantifier_\"],\"pyashSequence\":[\"cyah\",\"tlih\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes person_ cyah with assertive_quantifier_ tlih for a specific indefinite person\"}" ya
su text "somebody" ob text "{\"surface\":\"somebody\",\"kind\":\"pronoun\",\"components\":[\"person_\",\"assertive_quantifier_\"],\"pyashSequence\":[\"cyah\",\"tlih\"],\"position\":\"standalone\",\"evidence\":\"same person_ plus assertive_quantifier_ construction as someone\"}" ya
su text "anyone" ob text "{\"surface\":\"anyone\",\"kind\":\"pronoun\",\"components\":[\"person_\",\"elective_quantifier_\"],\"pyashSequence\":[\"cyah\",\"tlah\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes person_ cyah with elective_quantifier_ tlah for an unrestricted possible person\"}" ya
su text "anybody" ob text "{\"surface\":\"anybody\",\"kind\":\"pronoun\",\"components\":[\"person_\",\"elective_quantifier_\"],\"pyashSequence\":[\"cyah\",\"tlah\"],\"position\":\"standalone\",\"evidence\":\"same person_ plus elective_quantifier_ construction as anyone\"}" ya
su text "everyone" ob text "{\"surface\":\"everyone\",\"kind\":\"pronoun\",\"components\":[\"person_\",\"universal_quantifier_\"],\"pyashSequence\":[\"cyah\",\"wi\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes person_ cyah with universal_quantifier_ wi for every person\"}" ya
su text "everybody" ob text "{\"surface\":\"everybody\",\"kind\":\"pronoun\",\"components\":[\"person_\",\"universal_quantifier_\"],\"pyashSequence\":[\"cyah\",\"wi\"],\"position\":\"standalone\",\"evidence\":\"same person_ plus universal_quantifier_ construction as everyone\"}" ya
su text "nobody" ob text "{\"surface\":\"nobody\",\"kind\":\"pronoun\",\"components\":[\"person_\",\"negatory_quantifier_\"],\"pyashSequence\":[\"cyah\",\"no\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes person_ cyah with negatory_quantifier_ no for no person\"}" ya
su text "something" ob text "{\"surface\":\"something\",\"kind\":\"pronoun\",\"components\":[\"it_\",\"assertive_quantifier_\"],\"pyashSequence\":[\"ya\",\"tlih\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes it_ ya with assertive_quantifier_ tlih for a specific indefinite thing\"}" ya
su text "anything" ob text "{\"surface\":\"anything\",\"kind\":\"pronoun\",\"components\":[\"it_\",\"elective_quantifier_\"],\"pyashSequence\":[\"ya\",\"tlah\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes it_ ya with elective_quantifier_ tlah for any possible thing\"}" ya
su text "everything" ob text "{\"surface\":\"everything\",\"kind\":\"pronoun\",\"components\":[\"it_\",\"universal_quantifier_\"],\"pyashSequence\":[\"ya\",\"wi\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes it_ ya with universal_quantifier_ wi for every thing\"}" ya
su text "nothing" ob text "{\"surface\":\"nothing\",\"kind\":\"pronoun\",\"components\":[\"it_\",\"negatory_quantifier_\"],\"pyashSequence\":[\"ya\",\"no\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes it_ ya with negatory_quantifier_ no for no thing\"}" ya
su text "other" ob text "{\"surface\":\"other\",\"kind\":\"pronoun\",\"components\":[\"other_\"],\"pyashSequence\":[\"clah\"],\"position\":\"standalone\",\"evidence\":\"lwonprom other_ pro-form is clah; lexical other root remains tcan for compounds\"}" ya
su text "another" ob text "{\"surface\":\"another\",\"kind\":\"pronoun\",\"components\":[\"other_\",\"assertive_quantifier_\"],\"pyashSequence\":[\"clah\",\"tlih\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes other_ clah with assertive_quantifier_ tlih for one other item\"}" ya
