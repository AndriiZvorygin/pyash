su text "me" ob text "{\"surface\":\"me\",\"kind\":\"pronoun\",\"components\":[\"me_\"],\"pyashSequence\":[\"mi\"],\"position\":\"standalone\",\"evidence\":\"lwonprom person-deixis grammar particle me_ is mi; lexical me root remains hman for compound words.\"}" ya
su text "we" ob text "{\"surface\":\"we\",\"kind\":\"pronoun\",\"components\":[\"us_\"],\"pyashSequence\":[\"nyah\"],\"position\":\"standalone\",\"evidence\":\"lwonprom person-deixis grammar particle us_ is nyah; lexical us root remains hwam for compound words.\"}" ya
su text "us" ob text "{\"surface\":\"us\",\"kind\":\"pronoun\",\"components\":[\"us_\"],\"pyashSequence\":[\"nyah\"],\"position\":\"standalone\",\"evidence\":\"lwonprom person-deixis grammar particle us_ is nyah; lexical us root remains hwam for compound words.\"}" ya
su text "you" ob text "{\"surface\":\"you\",\"kind\":\"pronoun\",\"components\":[\"you_\"],\"pyashSequence\":[\"sa\"],\"position\":\"standalone\",\"evidence\":\"lwonprom person-deixis grammar particle you_ is sa; lexical you root remains hnan for compound words.\"}" ya
su text "our" ob text "{\"surface\":\"our\",\"kind\":\"possessive-determiner\",\"components\":[\"us_\",\"possessive_marker_\"],\"pyashSequence\":[\"nyah\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"lwonprom person-deixis grammar particle us_ is nyah; possessive_marker_ is ye. The lexical us root remains hwam for compound words.\"}" ya
su text "your" ob text "{\"surface\":\"your\",\"kind\":\"possessive-determiner\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"lwonprom person-deixis grammar particle you_ is sa; possessive_marker_ is ye. The lexical you root remains hnan for compound words.\"}" ya
su text "thy" ob text "{\"surface\":\"thy\",\"kind\":\"possessive-determiner\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"English archaic possessive determiner thy follows the you_ plus possessive_marker_ construction.\"}" ya
su text "thine" ob text "{\"surface\":\"thine\",\"kind\":\"possessive-pronoun\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"standalone\",\"evidence\":\"English archaic possessive pronoun thine follows the you_ plus possessive_marker_ construction.\"}" ya
su text "my" ob text "{\"surface\":\"my\",\"kind\":\"possessive-determiner\",\"components\":[\"me_\",\"possessive_marker_\"],\"pyashSequence\":[\"mi\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"lwonprom person-deixis grammar particle me_ is mi; possessive_marker_ is ye. The lexical me root remains hman for compound words.\"}" ya
su text "ours" ob text "{\"surface\":\"ours\",\"kind\":\"possessive-pronoun\",\"components\":[\"us_\",\"possessive_marker_\"],\"pyashSequence\":[\"nyah\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"same grammar construction as our: us_ is nyah followed by possessive_marker_ ye; lexical us remains hwam for compound words.\"}" ya
su text "yours" ob text "{\"surface\":\"yours\",\"kind\":\"possessive-pronoun\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"standalone\",\"evidence\":\"same grammar construction as your: you_ is sa followed by possessive_marker_ ye; lexical you root remains hnan for compound words.\"}" ya
su text "and" ob text "{\"surface\":\"and\",\"kind\":\"conjunction\",\"components\":[\"and_\"],\"pyashSequence\":[\"wa\"],\"position\":\"link\",\"evidence\":\"lwonprom conjunction grammar particle and_ is wa; lexical and root remains hwan for compound words.\"}" ya
su text "also" ob text "{\"surface\":\"also\",\"kind\":\"conjunction\",\"components\":[\"also_\"],\"pyashSequence\":[\"pcah\"],\"position\":\"link\",\"evidence\":\"lwonprom conjunction grammar particle also_ is pcah; lexical also root remains hyac for compound words.\"}" ya
su text "but" ob text "{\"surface\":\"but\",\"kind\":\"conjunction\",\"components\":[\"but_\"],\"pyashSequence\":[\"pyuh\"],\"position\":\"link\",\"evidence\":\"lwonprom conjunction grammar particle but_ is pyuh; lexical but root remains hlan for compound words.\"}" ya
su text "not" ob text "{\"surface\":\"not\",\"kind\":\"negation\",\"components\":[\"negatory_quantifier_\"],\"pyashSequence\":[\"no\"],\"position\":\"prefix\",\"evidence\":\"lwonprom negatory quantifier grammar particle negatory_quantifier_ is no.\"}" ya
su text "never" ob text "{\"surface\":\"never\",\"kind\":\"negation\",\"components\":[\"negatory_quantifier_\"],\"pyashSequence\":[\"no\"],\"position\":\"prefix\",\"evidence\":\"English negative adverb never lowers to the negatory quantifier particle no for this sentence layer.\"}" ya
su text "plural" ob text "{\"surface\":\"plural\",\"kind\":\"number-marker\",\"components\":[\"plural_number_\"],\"pyashSequence\":[\"pu\"],\"position\":\"suffix\",\"evidence\":\"lwonprom noun phrase grammar uses plural-number as the noun suffix; current grammar marker is pu\"}" ya
su text "possessive" ob text "{\"surface\":\"possessive\",\"kind\":\"case-marker\",\"components\":[\"possessive_marker_\"],\"pyashSequence\":[\"ye\"],\"position\":\"suffix\",\"evidence\":\"current Pyash grammar marker possessive_marker_ is ye\"}" ya
