su text "these" ob text "{\"surface\":\"these\",\"kind\":\"pronoun\",\"components\":[\"demonstrative_\",\"plural_number_\"],\"pyashSequence\":[\"tsah\",\"pu\"],\"position\":\"standalone\",\"evidence\":\"English proximal demonstrative these composes demonstrative_ tsah with plural-number pu\"}" ya
