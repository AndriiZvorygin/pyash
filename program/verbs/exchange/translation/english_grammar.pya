su text "of" ob text "{\"surface\":\"of\",\"kind\":\"case-marker\",\"components\":[\"genitive_case_\"],\"pyashSequence\":[\"ti\"],\"position\":\"link\",\"evidence\":\"English of-phrases use the lwonprom genitive case marker ti unless the source explicitly marks possession\"}" ya
su text "it" ob text "{\"surface\":\"it\",\"kind\":\"pronoun\",\"components\":[\"it_\"],\"pyashSequence\":[\"ya\"],\"position\":\"standalone\",\"evidence\":\"lwonprom it_ grammar particle is ya; lexical it root remains htit for compound words\"}" ya
su text "example" ob text "{\"surface\":\"example\",\"kind\":\"referential\",\"components\":[\"example_\"],\"pyashSequence\":[\"fluh\"],\"position\":\"standalone\",\"evidence\":\"example_ uses fluh, a CCVh long grammar form generated from pyachso2n weighted multilingual phonetics; lexical example_WORD tlam remains separate for root and compound use\"}" ya
su text "such as" ob text "{\"surface\":\"such as\",\"kind\":\"exemplifier\",\"components\":[\"example_\",\"way_case_\"],\"pyashSequence\":[\"fluh\",\"ga\"],\"position\":\"link\",\"evidence\":\"the English exemplifier such as lowers to the referential example_ head fluh with the space-way case ga, whose established glosses are at and via; lexical example remains tlam when a root noun is required\"}" ya
su text "thing" ob text "{\"surface\":\"thing\",\"kind\":\"pronoun\",\"components\":[\"it_\"],\"pyashSequence\":[\"ya\"],\"position\":\"standalone\",\"evidence\":\"generic English thing uses the lwonprom it_ pro-form ya at the sentence layer\"}" ya
