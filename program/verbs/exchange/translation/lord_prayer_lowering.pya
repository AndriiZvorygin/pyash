su text "clause:Matthew 6:9a" ob text "{\"locator\":\"Matthew 6:9a\",\"source\":\"Our Father in heaven, may your name be kept holy.\",\"sequence\":[{\"term\":\"our\"},{\"term\":\"father\",\"markers\":[\"wu\"]},{\"term\":\"heaven\",\"markers\":[\"te\"]},{\"term\":\"yours\"},{\"term\":\"name\",\"markers\":[\"na\"]},{\"term\":\"holy\",\"markers\":[\"pyoh\",\"jwih\"]}]}" ya
su text "clause:Matthew 6:10a" ob text "{\"locator\":\"Matthew 6:10a\",\"source\":\"Let your Kingdom come.\",\"sequence\":[{\"term\":\"yours\"},{\"term\":\"kingdom\",\"markers\":[\"na\"]},{\"term\":\"come\",\"markers\":[\"jwih\"]}]}" ya
su text "clause:Matthew 6:10b" ob text "{\"locator\":\"Matthew 6:10b\",\"source\":\"Let your will be done, as in heaven, so on earth.\",\"sequence\":[{\"term\":\"yours\"},{\"term\":\"will\",\"markers\":[\"na\"]},{\"term\":\"heaven\",\"markers\":[\"te\",\"swih\"]},{\"term\":\"earth\",\"markers\":[\"ta\"]},{\"pya\":\"tcun\"},{\"pya\":\"jwih\"}]}" ya
su text "clause:Matthew 6:11" ob text "{\"locator\":\"Matthew 6:11\",\"source\":\"Give us today our daily bread.\",\"sequence\":[{\"term\":\"our\",\"take\":1,\"markers\":[\"yi\"]},{\"term\":\"today\",\"markers\":[\"myah\"]},{\"term\":\"our\"},{\"term\":\"daily\"},{\"term\":\"give\",\"markers\":[\"pcih\"]}]}" ya
su text "clause:Matthew 6:12a" ob text "{\"locator\":\"Matthew 6:12a\",\"source\":\"Forgive us our debts.\",\"sequence\":[{\"term\":\"our\",\"take\":1,\"markers\":[\"yi\"]},{\"term\":\"our\"},{\"term\":\"debts\",\"markers\":[\"ka\"]},{\"term\":\"forgive\",\"markers\":[\"pcih\"]}]}" ya
su text "clause:Matthew 6:12b" ob text "{\"locator\":\"Matthew 6:12b\",\"source\":\"As we also forgive our debtors.\",\"sequence\":[{\"term\":\"our\",\"take\":1,\"markers\":[\"na\"]},{\"pya\":\"pcah\"},{\"term\":\"our\"},{\"term\":\"debtors\",\"markers\":[\"ka\"]},{\"term\":\"forgive\",\"markers\":[\"ra\",\"li\"]}]}" ya
su text "clause:Matthew 6:13a" ob text "{\"locator\":\"Matthew 6:13a\",\"source\":\"Bring us not into temptation.\",\"sequence\":[{\"term\":\"our\",\"take\":1,\"markers\":[\"yi\"]},{\"pya\":\"no\"},{\"term\":\"temptation\",\"markers\":[\"ma\"]},{\"term\":\"bring\",\"markers\":[\"pcih\"]}]}" ya
su text "clause:Matthew 6:13b" ob text "{\"locator\":\"Matthew 6:13b\",\"source\":\"But deliver us from the evil one.\",\"sequence\":[{\"pya\":\"pyuh\"},{\"term\":\"our\",\"take\":1,\"markers\":[\"yi\"]},{\"term\":\"evil\",\"markers\":[\"so\"]},{\"term\":\"deliver\",\"markers\":[\"pcih\"]}]}" ya
