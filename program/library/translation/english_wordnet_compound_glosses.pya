su text "sense-compound-ff7125d1adbe4b8ace170fdd" ob text "{\"senseId\":\"n:06336819-n\",\"target\":\"conjunction\",\"partOfSpeech\":\"n\",\"lemmas\":[\"conjunction\",\"conjunctive\",\"connective\",\"continuative\"],\"definition\":\"an uninflected function word that serves to conjoin words or phrases or clauses or sentences\",\"pyashSequence\":[\"gyon\",\"djos\"],\"decisionId\":\"sense-compound-ff7125d1adbe4b8ace170fdd\"}" ya
su text "sense-compound-9b8d85400b12d991dc56a57e" ob text "{\"senseId\":\"n:06337047-n\",\"target\":\"coordinating conjunction\",\"partOfSpeech\":\"n\",\"lemmas\":[\"coordinating conjunction\"],\"definition\":\"a conjunction (like ‘and’ or ‘or’) that connects two identically constructed grammatical constituents\",\"pyashSequence\":[\"htap\",\"djos\"],\"decisionId\":\"sense-compound-9b8d85400b12d991dc56a57e\"}" ya
su text "sense-compound-daec23481c1d47596e2f3cd4" ob text "{\"senseId\":\"n:06337219-n\",\"target\":\"subordinate conjunction\",\"partOfSpeech\":\"n\",\"lemmas\":[\"subordinate conjunction\",\"subordinating conjunction\"],\"definition\":\"a conjunction (like ‘since’ or ‘that’ or ‘who’) that introduces a dependent clause\",\"pyashSequence\":[\"drat\",\"djos\"],\"decisionId\":\"sense-compound-daec23481c1d47596e2f3cd4\"}" ya
su text "sense-compound-79b1e2c1885a9c6c944cbf56" ob text "{\"senseId\":\"n:06338129-n\",\"target\":\"personal pronoun\",\"partOfSpeech\":\"n\",\"lemmas\":[\"personal pronoun\"],\"definition\":\"a pronoun expressing a distinction of person\",\"pyashSequence\":[\"hpaf\",\"hpat\"],\"decisionId\":\"sense-compound-79b1e2c1885a9c6c944cbf56\"}" ya
su text "derived-compound-f85236f97b358757aa953076" ob text "{\"senseId\":\"n:06338711-n\",\"target\":\"first person\",\"partOfSpeech\":\"n\",\"lemmas\":[\"first person\"],\"definition\":\"pronouns and verbs used to refer to the speaker or writer of the language in which they occur\",\"pyashSequence\":[\"hpam\",\"hpat\"],\"decisionId\":\"derived-compound-f85236f97b358757aa953076\"}" ya
su text "derived-compound-f160079d3ef392770ad45cbf" ob text "{\"senseId\":\"n:06338863-n\",\"target\":\"second person\",\"partOfSpeech\":\"n\",\"lemmas\":[\"second person\"],\"definition\":\"pronouns and verbs used to refer to the person addressed by the language in which they occur\",\"pyashSequence\":[\"tlit\",\"hpat\"],\"decisionId\":\"derived-compound-f160079d3ef392770ad45cbf\"}" ya
