su text "sense-compound-d2ac0cd82e8ee570b0c33d6e" ob text "{\"senseId\":\"n:06335468-n\",\"target\":\"determinative\",\"partOfSpeech\":\"n\",\"lemmas\":[\"determinative\",\"determiner\"],\"definition\":\"one of a limited class of noun modifiers that determine the referents of noun phrases\",\"pyashSequence\":[\"pfok\",\"hgaf\"],\"decisionId\":\"sense-compound-d2ac0cd82e8ee570b0c33d6e\"}" ya
su text "sense-compound-a441924d14e17fc64161d158" ob text "{\"senseId\":\"n:06336363-n\",\"target\":\"pronoun\",\"partOfSpeech\":\"n\",\"lemmas\":[\"pronoun\"],\"definition\":\"a function word that is used in place of a noun or noun phrase\",\"pyashSequence\":[\"txi7t\",\"hran\"],\"decisionId\":\"sense-compound-a441924d14e17fc64161d158\"}" ya
