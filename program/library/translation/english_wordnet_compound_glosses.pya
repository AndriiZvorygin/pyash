su text "sense-compound-527d765d6510b33103a18afe" ob text "{\"senseId\":\"n:06573933-n\",\"target\":\"charge\",\"partOfSpeech\":\"n\",\"lemmas\":[\"charge\",\"complaint\"],\"definition\":\"(criminal law) a pleading describing some wrong or offense\",\"pyashSequence\":[\"blan\",\"dwut\"],\"decisionId\":\"sense-compound-527d765d6510b33103a18afe\"}" ya
su text "sense-compound-f819c07e299039a5351cde82" ob text "{\"senseId\":\"n:06574208-n\",\"target\":\"complaint\",\"partOfSpeech\":\"n\",\"lemmas\":[\"complaint\"],\"definition\":\"(civil law) the first pleading of the plaintiff setting out the facts on which the claim for relief is based\",\"pyashSequence\":[\"hfas\",\"blan\"],\"decisionId\":\"sense-compound-f819c07e299039a5351cde82\"}" ya
su text "sense-compound-45f7c1ed2708ac195b418b34" ob text "{\"senseId\":\"n:06574427-n\",\"target\":\"libel\",\"partOfSpeech\":\"n\",\"lemmas\":[\"libel\"],\"definition\":\"the written statement of a plaintiff explaining the cause of action (the defamation) and any relief they seek\",\"pyashSequence\":[\"fyak\",\"tya7s\"],\"decisionId\":\"sense-compound-45f7c1ed2708ac195b418b34\"}" ya
