su text "sense-compound-2edaea53290eb3ff71c18f06" ob text "{\"senseId\":\"n:06326089-n\",\"target\":\"relative clause\",\"partOfSpeech\":\"n\",\"lemmas\":[\"relative clause\"],\"definition\":\"a clause introduced by a relative pronoun\",\"pyashSequence\":[\"drat\",\"fyak\"],\"decisionId\":\"sense-compound-2edaea53290eb3ff71c18f06\"}" ya
su text "sense-compound-29aa341c0a70a9d4d73d8d47" ob text "{\"senseId\":\"n:06326294-n\",\"target\":\"restrictive clause\",\"partOfSpeech\":\"n\",\"lemmas\":[\"restrictive clause\"],\"definition\":\"a subordinate clause that limits or restricts the meaning of the noun phrase it modifies\",\"pyashSequence\":[\"hyan\",\"tyaf\"],\"decisionId\":\"sense-compound-29aa341c0a70a9d4d73d8d47\"}" ya
