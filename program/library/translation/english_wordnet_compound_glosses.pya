su text "sense-compound-db6ec3edc9e1669d5ee1ac32" ob text "{\"senseId\":\"n:06037143-n\",\"target\":\"multiple correlation\",\"partOfSpeech\":\"n\",\"lemmas\":[\"multiple correlation\",\"multiple regression\"],\"definition\":\"a statistical technique that predicts values of one variable on the basis of two or more other variables\",\"pyashSequence\":[\"prif\",\"hwuc\"],\"decisionId\":\"sense-compound-db6ec3edc9e1669d5ee1ac32\"}" ya
su text "sense-compound-2f217611ac949bb1e30614ce" ob text "{\"senseId\":\"n:06038096-n\",\"target\":\"regression coefficient\",\"partOfSpeech\":\"n\",\"lemmas\":[\"regression coefficient\"],\"definition\":\"when the regression line is linear (y = ax + b) the regression coefficient is the constant (a) that represents the rate of change of one variable (y) as a function of changes in the other (x)\",\"pyashSequence\":[\"hwit\",\"hgus\"],\"decisionId\":\"sense-compound-2f217611ac949bb1e30614ce\"}" ya
