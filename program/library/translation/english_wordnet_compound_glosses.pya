su text "derived-compound-594e6b8b2b690786f5d7a3f3" ob text "{\"senseId\":\"n:06332925-n\",\"target\":\"descriptive adjective\",\"partOfSpeech\":\"n\",\"lemmas\":[\"descriptive adjective\",\"qualifying adjective\"],\"definition\":\"an adjective that ascribes to its noun the value of an attribute of that noun (e.g., ‘a nervous person’ or ‘a musical speaking voice’)\",\"pyashSequence\":[\"drut\",\"hcit\"],\"decisionId\":\"derived-compound-594e6b8b2b690786f5d7a3f3\"}" ya
