su text "sense-compound-0ccbb1203cbf6fb6a578520b" ob text "{\"senseId\":\"n:05893343-n\",\"target\":\"law of segregation\",\"partOfSpeech\":\"n\",\"lemmas\":[\"law of segregation\"],\"definition\":\"members of a pair of homologous chromosomes separate during the formation of gametes and are distributed to different gametes so that every gamete receives only one member of the pair\",\"pyashSequence\":[\"klis\",\"hfaf\"],\"decisionId\":\"sense-compound-0ccbb1203cbf6fb6a578520b\"}" ya
