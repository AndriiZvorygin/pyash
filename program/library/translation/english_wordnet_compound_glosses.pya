su text "sense-compound-bd9ced2cfeb4ab3441311fea" ob text "{\"senseId\":\"n:06039726-n\",\"target\":\"factor analysis\",\"partOfSpeech\":\"n\",\"lemmas\":[\"factor analysis\"],\"definition\":\"any of several methods for reducing correlational data to a smaller number of dimensions or factors\",\"pyashSequence\":[\"hgus\",\"prif\"],\"decisionId\":\"sense-compound-bd9ced2cfeb4ab3441311fea\"}" ya
