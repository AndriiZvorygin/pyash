su text "sense-compound-c47e89cbaac944839e18e1eb" ob text "{\"senseId\":\"n:06045687-n\",\"target\":\"spurious correlation\",\"partOfSpeech\":\"n\",\"lemmas\":[\"spurious correlation\"],\"definition\":\"a correlation between two variables (e.g., between the number of electric motors in the home and grades at school) that does not result from any direct relation between them (buying electric motors will not raise grades) but from their relation to other variables\",\"pyashSequence\":[\"swi2k\",\"hwuc\"],\"decisionId\":\"sense-compound-c47e89cbaac944839e18e1eb\"}" ya
