su text "sense-compound-5f9282bc18ff02dfdd968ffd" ob text "{\"senseId\":\"n:06341757-n\",\"target\":\"phrasal verb\",\"partOfSpeech\":\"n\",\"lemmas\":[\"phrasal verb\"],\"definition\":\"an English verb followed by one or more particles where the combination behaves as a syntactic and semantic unit\",\"pyashSequence\":[\"kres\",\"dwa7t\"],\"decisionId\":\"sense-compound-5f9282bc18ff02dfdd968ffd\"}" ya
su text "derived-compound-4b2db010facfaedce6ec354e" ob text "{\"senseId\":\"n:06342147-n\",\"target\":\"perfect participle\",\"partOfSpeech\":\"n\",\"lemmas\":[\"past participle\",\"perfect participle\"],\"definition\":\"a participle that expresses completed action\",\"pyashSequence\":[\"hwaf\",\"pfas\"],\"decisionId\":\"derived-compound-4b2db010facfaedce6ec354e\"}" ya
su text "derived-compound-0b0e30e912384264f2675734" ob text "{\"senseId\":\"n:06342274-n\",\"target\":\"transitive verb\",\"partOfSpeech\":\"n\",\"lemmas\":[\"transitive\",\"transitive verb\",\"transitive verb form\"],\"definition\":\"a verb (or verb construction) that requires an object in order to be grammatical\",\"pyashSequence\":[\"tsom\",\"kres\"],\"decisionId\":\"derived-compound-0b0e30e912384264f2675734\"}" ya
su text "sense-compound-25ba46f1831afc8cb2f60c82" ob text "{\"senseId\":\"n:06342470-n\",\"target\":\"doubly transitive verb\",\"partOfSpeech\":\"n\",\"lemmas\":[\"doubly transitive verb\",\"doubly transitive verb form\"],\"definition\":\"a transitive verb that takes both a direct and an indirect object\",\"pyashSequence\":[\"twas\",\"tfif\"],\"decisionId\":\"sense-compound-25ba46f1831afc8cb2f60c82\"}" ya
su text "sense-compound-590dff0fec281e69e4318ed6" ob text "{\"senseId\":\"n:06343129-n\",\"target\":\"affected role\",\"partOfSpeech\":\"n\",\"lemmas\":[\"affected role\",\"patient\",\"patient role\"],\"definition\":\"the semantic role of an entity that is not the agent but is directly involved in or affected by the happening denoted by the verb in the clause\",\"pyashSequence\":[\"hyik\",\"hfic\"],\"decisionId\":\"sense-compound-590dff0fec281e69e4318ed6\"}" ya
