su text "sense-compound-29bdf7eb989bf7553bad30fe" ob text "{\"senseId\":\"n:06325134-n\",\"target\":\"clause\",\"partOfSpeech\":\"n\",\"lemmas\":[\"clause\"],\"definition\":\"(grammar) an expression including a subject and predicate functioning as a part of a complex sentence\",\"pyashSequence\":[\"myoc\",\"drat\"],\"decisionId\":\"sense-compound-29bdf7eb989bf7553bad30fe\"}" ya
