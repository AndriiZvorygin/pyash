su text "sense-compound-3b69701151af16ce0425f717" ob text "{\"senseId\":\"n:06334815-n\",\"target\":\"dangling modifier\",\"partOfSpeech\":\"n\",\"lemmas\":[\"dangling modifier\",\"misplaced modifier\"],\"definition\":\"a word or phrase apparently modifying an unintended word because of its placement in a sentence: e.g., ‘when young’ in ‘when young, circuses appeal to all of us’\",\"pyashSequence\":[\"pfok\",\"hko2k\"],\"decisionId\":\"sense-compound-3b69701151af16ce0425f717\"}" ya
