su text "sense-compound-94dd30868f16ac1c95cf6fb5" ob text "{\"senseId\":\"n:06575941-n\",\"target\":\"plea bargain\",\"partOfSpeech\":\"n\",\"lemmas\":[\"plea bargain\",\"plea bargaining\"],\"definition\":\"(criminal law) a negotiation in which the defendant agrees to enter a plea of guilty to a lesser charge and the prosecutor agrees to drop a more serious charge\",\"pyashSequence\":[\"krak\",\"tyot\"],\"decisionId\":\"sense-compound-94dd30868f16ac1c95cf6fb5\"}" ya
