su text "sense-compound-29d074c76c0a564b1464dbf5" ob text "{\"senseId\":\"n:06042957-n\",\"target\":\"pearson product moment correlation coefficient\",\"partOfSpeech\":\"n\",\"lemmas\":[\"pearson product moment correlation coefficient\",\"product moment correlation coefficient\"],\"definition\":\"the most commonly used method of computing a correlation coefficient between variables that are linearly related\",\"pyashSequence\":[\"tras\",\"hwuc\"],\"decisionId\":\"sense-compound-29d074c76c0a564b1464dbf5\"}" ya
