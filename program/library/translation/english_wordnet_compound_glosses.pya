su text "sense-compound-86b81b366c2e26b20df10357" ob text "{\"senseId\":\"n:06324641-n\",\"target\":\"construction\",\"partOfSpeech\":\"n\",\"lemmas\":[\"construction\",\"expression\",\"grammatical construction\"],\"definition\":\"a group of words that form a constituent of a sentence and are considered as a single unit\",\"pyashSequence\":[\"nyaf\",\"plit\"],\"decisionId\":\"sense-compound-86b81b366c2e26b20df10357\"}" ya
