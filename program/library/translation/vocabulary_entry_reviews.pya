su text "vocabulary-review-a688ce01c93a2d7d9d5e3e94" ob text "{\"reviewId\":\"vocabulary-review-a688ce01c93a2d7d9d5e3e94\",\"target\":\"identifier\",\"gloss\":\"a symbol that establishes the identity of the one bearing it\",\"pyashSequence\":[\"hdif\",\"tyec\"],\"senseId\":\"n:07285306-n\",\"targetPartOfSpeech\":\"n\",\"reviewStatus\":\"accepted-curated\",\"modelStatus\":\"accepted-llm\",\"evidence\":\"The identifier is an identity tag: the symbol establishes the identity of the person or thing bearing it. The compound is head-final, identity + tag.\",\"coverageTarget\":\"identifier\",\"bridgeManaged\":true}" ya
su text "vocabulary-review-a81493a5e37aa2c7fbfb7fac" ob text "{\"reviewId\":\"vocabulary-review-a81493a5e37aa2c7fbfb7fac\",\"target\":\"question\",\"gloss\":\"an instance of questioning; there was a question about my training; we made inquiries of all those who were present\",\"pyashSequence\":[\"hwas\"],\"senseId\":\"n:07208256-n\",\"targetPartOfSpeech\":\"n\",\"reviewStatus\":\"accepted-curated\",\"evidence\":\"IWSP query representation uses the existing hwas atom. This exact WordNet sense has lemmas query and question; the bridge target is question. The curated review resolves only this sense-to-atom ambiguity without changing bridge target selection globally.\",\"coverageTarget\":\"question\",\"bridgeManaged\":false}" ya
