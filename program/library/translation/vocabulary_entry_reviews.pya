su text "vocabulary-review-a688ce01c93a2d7d9d5e3e94" ob text "{\"reviewId\":\"vocabulary-review-a688ce01c93a2d7d9d5e3e94\",\"target\":\"identifier\",\"gloss\":\"a symbol that establishes the identity of the one bearing it\",\"pyashSequence\":[\"hdif\",\"tyec\"],\"senseId\":\"n:07285306-n\",\"targetPartOfSpeech\":\"n\",\"reviewStatus\":\"accepted-curated\",\"modelStatus\":\"accepted-llm\",\"evidence\":\"The identifier is an identity tag: the symbol establishes the identity of the person or thing bearing it. The compound is head-final, identity + tag.\",\"coverageTarget\":\"identifier\",\"bridgeManaged\":true}" ya
su text "vocabulary-review-a81493a5e37aa2c7fbfb7fac" ob text "{\"reviewId\":\"vocabulary-review-a81493a5e37aa2c7fbfb7fac\",\"target\":\"question\",\"gloss\":\"an instance of questioning; there was a question about my training; we made inquiries of all those who were present\",\"pyashSequence\":[\"hwas\"],\"senseId\":\"n:07208256-n\",\"targetPartOfSpeech\":\"n\",\"reviewStatus\":\"accepted-curated\",\"evidence\":\"IWSP query representation uses the existing hwas atom. This exact WordNet sense has lemmas query and question; the bridge target is question. The curated review resolves only this sense-to-atom ambiguity without changing bridge target selection globally.\",\"coverageTarget\":\"question\",\"bridgeManaged\":false}" ya
su text "vocabulary-review-b79e65ad46088058ede546b7" ob text "{\"reviewId\":\"vocabulary-review-b79e65ad46088058ede546b7\",\"target\":\"divisions\",\"gloss\":\"an arithmetic operation that is the inverse of multiplication\",\"pyashSequence\":[\"dvis\"],\"senseId\":\"n:00872590-n\",\"targetPartOfSpeech\":\"n\",\"reviewStatus\":\"accepted-curated\",\"evidence\":\"dvis is the DIVIDE primitive the compiled runtime dispatches on (0x8893). A primitive must be one atom whose WordNet sense is the operation it performs, so the arithmetic division sense is bound to the dvis atom rather than the high-frequency army-unit sense.\",\"coverageTarget\":\"divisions\",\"bridgeManaged\":false}" ya
su text "vocabulary-review-5f19778a97873e14fca9c3fb" ob text "{\"reviewId\":\"vocabulary-review-5f19778a97873e14fca9c3fb\",\"target\":\"divisions\",\"gloss\":\"an army unit large enough to sustain combat\",\"pyashSequence\":[\"hyim\",\"dvis\"],\"senseId\":\"n:08230126-n\",\"targetPartOfSpeech\":\"n\",\"reviewStatus\":\"accepted-curated\",\"evidence\":\"The army-unit sense cannot own the dvis atom: dvis is the arithmetic DIVIDE primitive. It moves to the army + divisions compound so both senses stay addressable and the primitive keeps a single atom.\",\"coverageTarget\":\"divisions\",\"bridgeManaged\":false}" ya
su text "vocabulary-review-2156adbb60ced9dc817b7652" ob text "{\"reviewId\":\"vocabulary-review-2156adbb60ced9dc817b7652\",\"target\":\"plus\",\"gloss\":\"the arithmetic operation of summing\",\"pyashSequence\":[\"plus\"],\"senseId\":\"n:00873785-n\",\"targetPartOfSpeech\":\"n\",\"reviewStatus\":\"accepted-curated\",\"evidence\":\"plus is the primitive operator atom the compiled runtime dispatches on. A primitive must be one atom whose WordNet sense is the operation it performs, so this sense is bound to the atom rather than left to frequency order.\",\"coverageTarget\":\"plus\",\"bridgeManaged\":false}" ya
