su name translation_chinese_character_grammar_refinery_config be map def
su text "format" ob text "chinese-character-grammar-refinery-v1" ya
su text "model" ob text "qwen3.5:9b" ya
su text "prompt-revision" ob text "grammar-character-one-to-one-relevant-frequency-v2" ya
su text "generation-limit" ob num 86 ya
su text "housekeeper-duties-per-pass" ob num 64 ya
su text "housekeeper-parallelism" ob num 4 ya
su text "max-output-tokens" ob num 2048 ya
prah

su name translation chinese character grammar first pass be refinery def
su name build ranked grammar character worklist to name map character worklist be translation stage do
su name prepare grammar target matches from name map character worklist to name map grammar match candidates be translation stage do
su name review grammar target matches from ve name map character worklist name map grammar match candidates to name map grammar match decisions be translation stage do
su name record grammar character links from name map grammar match decisions to name map grammar character links be translation stage do
prah
