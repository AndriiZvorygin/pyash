 to\"],[0,11,5068750,12891,\"v:00025027-v | lave | wash one's face and hands\"],[0,11,5069071,12892,\"v:00025196-v | strain | cause to be tense and uneasy or nervous or anxious\"],[0,11,5069459,12893,\"v:00025647-v | loosen up | cause to feel relaxed\"],[0,11,5069836,12894,\"v:00026378-v | decompress | become less tense, rest, or take one's ease\"],[0,11,5070259,12895,\"v:00026934-v | sit back | settle into a comfortable sitting position\"],[0,11,5070631,12896,\"v:00027057-v | limber up | make one's body limber or suppler by stretching, as if to prepare for strenuous physical activity\"],[0,11,5071125,12897,\"v:00027261-v | extend | extend one's limbs or muscles, or the entire body\"],[0,11,5071500,12898,\"v:00027698-v | exsert | thrust or extend out\"],[0,11,5071875,12899,\"v:00029018-v | grin | to draw back the lips and reveal the teeth, in a smile, grimace, or snarl\"],[0,11,5072280,12900,\"v:00029329-v | simper | smile affectedly or derisively\"],[0,11,5072615,12901,\"v:00030003-v | snicker | laugh quietly\"],[0,11,5072922,12902,\"v:00031411-v | cackle | emit a loud, unpleasant kind of laughing\"],[0,11,5073267,12903,\"v:00031656-v | chortle | laugh quietly or with restraint\"],[0,11,5073626,12904,\"v:00032532-v | sneer | smile contemptuously\"],[0,11,5073928,12905,\"v:00032771-v | sneer | express through a scornful smile\"],[0,11,5074254,12906,\"v:00033196-v | glare | look at with a fixed gaze\"],[0,11,5074577,12907,\"v:00033845-v | scowl | frown with displeasure\"],[0,11,5074883,12908,\"v:00034941-v | blow | free of obstruction by blowing air through\"],[0,11,5075228,12909,\"v:00035769-v | clean | clean one's body or parts thereof, as by washing\"],[0,11,5075598,12910,\"v:00036773-v | scrub | wash thoroughly\"],[0,11,5075903,12911,\"v:00037291-v | shave | remove body hair with a razor\"],[0,11,5076223,12912,\"v:00038078-v | comb | smoothen and neaten with or as with a comb\"],[0,11,5076595,12913,\"v:00043414-v | dress | dress or groom with elaborate care\"],[0