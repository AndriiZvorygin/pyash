n | beachhead | a bridgehead on the enemy's shoreline seized by an amphibious operation\"],[0,11,3053498,7715,\"n:08708530-n | fringe | a part of the city far removed from the center\"],[0,11,3053868,7716,\"n:08709407-n | national capital | the capital city of a nation\"],[0,11,3054221,7717,\"n:08714745-n | european country | any one of the countries occupying the European continent\"],[0,11,3054650,7718,\"n:08715641-n | scandinavian country | any one of the countries occupying Scandinavia\"],[0,11,3055076,7719,\"n:08715940-n | balkan country | any one of the countries on the Balkan Peninsula\"],[0,11,3055499,7720,\"n:08764775-n | caribbean island | an island in the Caribbean Sea\"],[0,11,3055854,7721,\"n:08800479-n | aegean island | an island in the Aegean Sea\"],[0,11,3056194,7722,\"n:08959335-n | french region | a geographical subdivision of France\"],[0,11,3056554,7723,\"n:09201896-n | ground | a rational motive for a belief or action\"],[0,11,3056923,7724,\"n:09204454-n | cacoethes | an irrational but irresistible motive for a belief or action\"],[0,11,3057339,7725,\"n:09206152-n | compulsion | an irrational motive for performing trivial or repetitive actions, even against your will\"],[0,11,3057817,7726,\"n:09206868-n | hedonism | the pursuit of pleasure as a matter of ethical principle\"],[0,11,3058210,7727,\"n:09207302-n | small voice | an inner voice that judges your behavior\"],[0,11,3058623,7728,\"n:09207565-n | inner light | a divine presence believed by Quakers to enlighten and guide the soul\"],[0,11,3059088,7729,\"n:09208177-n | signal | any incitement to action\"],[0,11,3059401,7730,\"n:09221979-n | anthill | a mound of earth made by ants as they dig their nest\"],[0,11,3059789,7731,\"n:09229873-n | acclivity | an upward slope or grade (as in a road)\"],[0,11,3060194,7732,\"n:09236341-n | bank | a long ridge or pile\"],[0,11,3060493,7733,\"n:09238222-n | base | the bottom or lowest part\"],[0,11,3060802,7734,\"n:09240137-n | beach | an area of sand s