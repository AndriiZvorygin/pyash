su text "kwon-entry:n" ob text "[[0,11,292120,799,\"n:00001740-n | entity | that which is perceived or known or inferred to have its own distinct existence (living or nonliving)\"],[0,11,292587,800,\"n:00004258-n | animate thing | a living (or once living) entity\"],[0,11,292954,801,\"n:00006269-n | life | living things collectively\"],[0,11,293265,802,\"n:00006484-n | cell | (biology) the basic structural and functional unit of all organisms\"],[0,11,293658,803,\"n:00007347-n | causal agency | any entity that produces an effect or is responsible for events or results\"],[0,11,294119,804,\"n:00017402-n | flora | (botany) a living organism lacking the power of locomotion\"],[0,11,294522,805,\"n:00019793-n | substance | the real physical matter of which a person or thing consists\"],[0,11,294916,806,\"n:00021007-n | matter | that which has mass and occupies space\"],[0,11,295257,807,\"n:00023451-n | cognition | the psychological result of perception and learning and reasoning\"],[0,11,295686,808,\"n:00023953-n | motivation | the psychological feature that arouses an organism to action toward a desired goal\"],[0,11,296147,809,\"n:00024444-n | attribute | an abstraction belonging to or characteristic of an entity\"],[0,11,296537,810,\"n:00024900-n | state | the way something is with respect to its main attributes\"],[0,11,296911,811,\"n:00027365-n | location | a point or extent in space\"],[0,11,297234,812,\"n:00028005-n | form | the spatial arrangement of something as distinct from its substance\"],[0,11,297637,813,\"n:00028950-n | infinite | the unlimited expanse in which everything is located\"],[0,11,298022,814,\"n:00031563-n | group | any number of entities (members) considered as a unit\"],[0,11,298403,815,\"n:00032220-n | relation | an abstraction belonging to or characteristic of two entities or parts together\"],[0,11,298832,816,\"n:00032912-n | possession | anything owned or possessed\"],[0,11,299163,817,\"n:00033122-n | social relation | a relation between living organisms (especially between people)\"],[0,11,299581,818,\"n:00033319-n | communication | something that is communicated by or to or between people or groups\"],[0,11,300001,819,\"n:00035910-n | accomplishment | the action of accomplishing something\"],[0,11,300380,820,\"n:00037727-n | masterpiece | an outstanding achievement\"],[0,11,300722,821,\"n:00037921-n | credit | used in the phrase ‘to your credit’ in order to indicate an achievement deserving praise\"],[0,11,301171,822,\"n:00039000-n | course | a mode of action\"],[0,11,301490,823,\"n:00039759-n | interaction | a mutual or reciprocal action\"],[0,11,301828,824,\"n:00039949-n | interplay | reciprocal action and reaction\"],[0,11,302162,825,\"n:00040890-n | give and take | mutual interaction\"],[0,11,302518,826,\"n:00041926-n | playing | the action of taking part in a game or sport or other recreation\"],[0,11,302914,827,\"n:00043495-n | departure | the act of departing\"],[0,11,303265,828,\"n:00044640-n | hit | (baseball) when a batter strikes a pitched ball into fair territory and arrives safely on base (without an error or a fielder's choice being made by the defense)\"],[0,11,303844,829,\"n:00044888-n | effectuation | the act of implementing (providing a practical means for accomplishing something)\"],[0,11,304308,830,\"n:00046387-n | rally | the feat of mustering strength for a renewed effort\"],[0,11,304685,831,\"n:00046648-n | recovery | the act of regaining or saving something lost (or in danger of becoming lost)\"],[0,11,305124,832,\"n:00047085-n | stunt | a difficult or unusual or dangerous feat\"],[0,11,305466,833,\"n:00047263-n | touch | the act of putting two things together with no space between them\"],[0,11,305871,834,\"n:00047759-n | tour de force | a masterly or brilliant feat\"],[0,11,306213,835,\"n:00047847-n | performance | any recognized accomplishment\"],[0,11,306551,836,\"n:00048097-n | overachievement | better than expected performance (better than might have been predicted from intelligence tests)\"],[0,11,307035,837,\"n:00048486-n | record | the sum of recognized accomplishments\"],[0,11,307391,838,\"n:00048966-n | arrival | accomplishment of an objective\"],[0,11,307732,839,\"n:00049115-n | arrival | the act of arriving at a certain place\"],[0,11,308076,840,\"n:00049397-n | attainment | arrival at a new stage\"],[0,11,308397,841,\"n:00050103-n | incursion | the act of entering some territory or domain (often in large numbers)\"],[0,11,308809,842,\"n:00050289-n | intrusion | entrance by force or without permission or welcome\"],[0,11,309183,843,\"n:00050395-n | irruption | a sudden violent entrance\"],[0,11,309507,844,\"n:00050857-n | enrollment | the act of enrolling\"],[0,11,309855,845,\"n:00051015-n | appearance | the act of appearing in public view\"],[0,11,310202,846,\"n:00052012-n | homecoming | a coming to or returning home\"],[0,11,310548,847,\"n:00052345-n | penetration | the act of entering into or through something\"],[0,11,310918,848,\"n:00053917-n | farewell | the act of departing politely\"],[0,11,311295,849,\"n:00054429-n | disappearance | the act of leaving secretly or without explanation\"],[0,11,311698,850,\"n:00054733-n | withdrawal | the act of withdrawing\"],[0,11,312019,851,\"n:00055148-n | effacement | withdrawing into the background\"],[0,11,312378,852,\"n:00056907-n | emigration | migration from a place (especially migration from your native country in order to settle in another)\"],[0,11,312890,853,\"n:00057131-n | immigration | migration into a place (especially migration to a country of which you are not a native in order to settle there)\"],[0,11,313422,854,\"n:00057732-n | retreat | (military) withdrawal of troops to a more favorable position to escape the enemy's superior forces or after a defeat\"],[0,11,313922,855,\"n:00058477-n | sailing | the departure of a vessel from a port\"],[0,11,314264,856,\"n:00060548-n | clinch | (boxing) the act of one boxer holding onto the other to avoid being hit and to rest momentarily\"],[0,11,314719,857,\"n:00060715-n | dodge | a quick evasive movement\"],[0,11,315030,858,\"n:00061234-n | exodus | a journey by a large group to escape from a hostile environment\"],[0,11,315443,859,\"n:00062110-n | despatch | the act of sending off something\"],[0,11,315804,860,\"n:00063151-n | male orgasm | an orgasm accompanied by the sensation of ejaculation of semen\"],[0,11,316210,861,\"n:00063626-n | attainment | the act of achieving an aim\"],[0,11,316542,862,\"n:00063834-n | record | an extreme attainment\"],[0,11,316849,863,\"n:00064379-n | world record | the best record in the whole world\"],[0,11,317200,864,\"n:00064472-n | success | an attainment that is successful\"],[0,11,317532,865,\"n:00064838-n | winning | succeeding with great difficulty\"],[0,11,317864,866,\"n:00065324-n | bang | a conspicuous success\"],[0,11,318206,867,\"n:00065609-n | bell ringer | something that exactly succeeds in achieving its goal\"],[0,11,318629,868,\"n:00066036-n | conquest | success in mastering something difficult\"],[0,11,318980,869,\"n:00066156-n | coup | a brilliant and notable success\"],[0,11,319301,870,\"n:00066675-n | course credit | recognition by a college or university that a course of studies has been successfully completed\"],[0,11,319789,871,\"n:00066895-n | credit hour | a unit of academic credit\"],[0,11,320137,872,\"n:00067456-n | failure | an act that fails\"],[0,11,320439,873,\"n:00068217-n | default | loss due to not showing up\"],[0,11,320759,874,\"n:00068346-n | loss | the act of losing someone or something\"],[0,11,321094,875,\"n:00069721-n | breach | a failure to perform some promised act or obligation\"],[0,11,321463,876,\"n:00072888-n | error | (baseball) a failure of a defensive player to make an out when normal play would have sufficed\"],[0,11,321925,877,\"n:00073628-n | miscalculation | a mistake in calculating\"],[0,11,322297,878,\"n:00075344-n | lapse | a mistake resulting from inattention\"],[0,11,322645,879,\"n:00075610-