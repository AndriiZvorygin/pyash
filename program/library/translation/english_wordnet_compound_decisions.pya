su text "derived-compound-aa17850fa002d0305b7af774" ob text "{\"language\":\"canonical\",\"surface\":\"moral principle\",\"target\":\"moral principle\",\"sourceMorphemes\":[\"moral\",\"principle\"],\"morphemes\":[\"moral\",\"principle\"],\"componentGlosses\":[\"moral\",\"principle\"],\"pyashSequence\":[\"myut\",\"psip\"],\"componentLayers\":[16,16],\"maxLayer\":16,\"head\":\"principle\",\"modifiers\":[\"moral\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"moral principle\"},\"sourceMorphemesByLanguage\":{\"english\":[\"moral\",\"principle\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-aa17850fa002d0305b7af774\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":4,\"componentSenseEvidence\":[{\"component\":\"moral\",\"source\":\"a:01552360-a\",\"lemmas\":[\"moral\"],\"definition\":\"concerned with principles of right and wrong or conforming to standards of behavior and character based on those principles\"},{\"component\":\"moral\",\"source\":\"n:06618397-n\",\"lemmas\":[\"moral\",\"lesson\"],\"definition\":\"the significance of a story or event\"},{\"component\":\"moral\",\"source\":\"s:01785141-s\",\"lemmas\":[\"moral\"],\"definition\":\"psychological rather than physical or tangible in effect\"},{\"component\":\"principle\",\"source\":\"n:05964190-n\",\"lemmas\":[\"principle\"],\"definition\":\"a rule or standard especially of good behavior\"},{\"component\":\"principle\",\"source\":\"n:06668133-n\",\"lemmas\":[\"principle\",\"precept\"],\"definition\":\"rule of personal conduct\"},{\"component\":\"principle\",\"source\":\"n:05922132-n\",\"lemmas\":[\"principle\",\"rule\"],\"definition\":\"a basic generalization that is accepted as true and that can be