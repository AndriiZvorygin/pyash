su text "derived-compound-ab87e652928bcabe32916acb" ob text "{\"language\":\"canonical\",\"surface\":\"dog collar\",\"target\":\"dog collar\",\"sourceMorphemes\":[\"dog\",\"collar\"],\"morphemes\":[\"dog\",\"collar\"],\"componentGlosses\":[\"dog\",\"collar\"],\"pyashSequence\":[\"klak\",\"kloc\"],\"componentLayers\":[16,19],\"maxLayer\":19,\"head\":\"collar\",\"modifiers\":[\"dog\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"dog collar\"},\"sourceMorphemesByLanguage\":{\"english\":[\"dog\",\"collar\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-ab87e652928bcabe32916acb\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"dog\",\"source\":\"n:02086723-n\",\"lemmas\":[\"dog\",\"domestic dog\",\"canis familiaris\"],\"definition\":\"a member of the genus Canis (probably descended from the common wolf) that has been domesticated by man since prehistoric times\"},{\"component\":\"dog\",\"source\":\"v:02005890-v\",\"lemmas\":[\"chase\",\"chase after\",\"trail\",\"tail\",\"tag\",\"give chase\",\"dog\",\"go after\",\"track\"],\"definition\":\"go after with the intent to catch\"},{\"component\":\"dog\",\"source\":\"n:09905672-n\",\"lemmas\":[\"cad\",\"bounder\",\"blackguard\",\"dog\",\"hound\",\"heel\"],\"definition\":\"someone who is morally reprehensible\"},{\"component\":\"dog\",\"source\":\"n:02712903-n\",\"lemmas\":[\"andiron\",\"firedog\",\"dog\",\"dog iron\"],\"definition\":\"metal supports for logs in a fireplace\"},{\"component\":\"collar\",\"source\":\"n:03072185-n\",\"lemmas\":[\"collar\",\"neckband\"],\"definition\":\"a band that fits around the neck and is usually folded over\"},{\"component\":\"collar\"