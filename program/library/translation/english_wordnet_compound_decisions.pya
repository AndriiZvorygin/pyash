su text "derived-compound-8837b6af7e15b31f8c15f226" ob text "{\"language\":\"canonical\",\"surface\":\"leafstalk\",\"target\":\"leafstalk\",\"sourceMorphemes\":[\"leaf\",\"stalk\"],\"morphemes\":[\"leaf\",\"stalk\"],\"componentGlosses\":[\"leaf\",\"stalk\"],\"pyashSequence\":[\"dlit\",\"ht6c\"],\"componentLayers\":[24,28],\"maxLayer\":28,\"head\":\"stalk\",\"modifiers\":[\"leaf\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"chinese\":\"叶柄\",\"french\":\"pétiole\",\"hindi\":\"leafstalk\",\"russian\":\"черешок листа\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"叶柄\"],\"french\":[\"pétiole\"],\"hindi\":[\"leafstalk\"],\"russian\":[\"черешок\",\"листа\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"accepted-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-8837b6af7e15b31f8c15f226\",\"componentSenseEvidence\":[{\"component\":\"leaf\",\"source\":\"n:13173519-n\",\"lemmas\":[\"leaf\",\"leafage\",\"foliage\"],\"definition\":\"the main organ of photosynthesis and transpiration in higher plants\"},{\"component\":\"leaf\",\"source\":\"v:02157453-v\",\"lemmas\":[\"flick\",\"flip\",\"thumb\",\"riffle\",\"leaf\",\"riff\"],\"definition\":\"look through a book or other written material\"},{\"component\":\"leaf\",\"source\":\"n:03657552-n\",\"lemmas\":[\"leaf\"],\"definition\":\"hinged or detachable flat section (as of a table or door)\"},{\"component\":\"leaf\",\"source\":\"n:06266806-n\",\"lemmas\":[\"leaf\",\"folio\"],\"definition\":\"a sheet of any written or printed material (especially in a manuscript or book)\"},{\"component\":\"stalk\",\"source\":\"n:13149924-n\",\"lemmas\":[\"stalk\",\"stem\"],\"definition\":\"a slender or elongated structure that supports a