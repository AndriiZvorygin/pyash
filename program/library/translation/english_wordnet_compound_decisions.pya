su text "derived-compound-6db0b713e57e65ee2b3653b3" ob text "{\"language\":\"canonical\",\"surface\":\"flash frozen\",\"target\":\"flash frozen\",\"sourceMorphemes\":[\"flash\",\"frozen\"],\"morphemes\":[\"flash\",\"frozen\"],\"componentGlosses\":[\"flash\",\"frozen\"],\"pyashSequence\":[\"flac\",\"hgot\"],\"componentLayers\":[16,24],\"maxLayer\":24,\"head\":\"frozen\",\"modifiers\":[\"flash\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"flash frozen\"},\"sourceMorphemesByLanguage\":{\"english\":[\"flash\",\"frozen\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-6db0b713e57e65ee2b3653b3\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"flash\",\"source\":\"n:15271921-n\",\"lemmas\":[\"blink of an eye\",\"flash\",\"heartbeat\",\"instant\",\"jiffy\",\"split second\",\"trice\",\"twinkling\",\"wink\",\"new york minute\"],\"definition\":\"a very short time (as the time it takes the eye to blink or the heart to beat)\"},{\"component\":\"flash\",\"source\":\"v:02164320-v\",\"lemmas\":[\"flash\",\"blink\",\"wink\",\"twinkle\",\"winkle\"],\"definition\":\"gleam or glow intermittently\"},{\"component\":\"flash\",\"source\":\"n:07426692-n\",\"lemmas\":[\"flash\"],\"definition\":\"a sudden intense burst of radiant energy\"},{\"component\":\"flash\",\"source\":\"v:02065423-v\",\"lemmas\":[\"dart\",\"dash\",\"scoot\",\"scud\",\"flash\",\"shoot\"],\"definition\":\"run or move very quickly or hastily\"},{\"component\":\"frozen\",\"source\":\"s:01076274-s\",\"lemmas\":[\"flash frozen\",\"quick frozen\",\"frozen\"],\"definition\":\"(used of foods) preserved by freezing sufficiently rapidly to retain flavor and nutritional value\"},{\"component\":\"frozen\",\"source\":\"a:01081990-a\",\"lemmas\":[\"frozen\"],\"definition\":\"turned into ice\"},{\"component\":\"frozen\",\"source\":\"s:00348809-s\",\"lemmas\":[\"fixed\",\"frozen\"],\"definition\":\"incapable of being changed or moved or undone\"},{\"component\":\"frozen\",\"source\":\"s:01261336-s\",\"lemmas\":[\"frigid\",\"frosty\",\"frozen\",\"glacial\",\"icy\",\"wintry\"],\"definition\":\"devoid of warmth and cordiality\"}],\"targetSenseEvidence\":[{\"source\":\"s:01076274-s\",\"pos\":\"s\",\"lemmas\":[\"flash frozen\",\"frozen\",\"quick frozen\"],\"definition\":\"(used of foods) preserved by freezing sufficiently rapidly to retain flavor and nutritional value\",\"compatibleHeadSenseIds\":[\"s:01076274-s\"]}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"accepted-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1,\"verifier\":\"mind\",\"verificationRationale\":\"Modifier 'flash' (move quickly) literally modifies head 'frozen' to mean rapidly frozen food.\",\"verificationHeadKind\":\"lexical-head\",\"verificationSenseId\":\"s:01076274-s\",\"verificationHeadSenseId\":\"s:01076274-s\",\"verificationModifierSenseIds\":[\"v:02065423-v\"],\"verificationModifierEvidence\":[\"flash contributes the meaning of moving very quickly or hastily\"],\"verificationModifierRelations\":[\"literal\"],\"verificationHeadRelation\":\"supported\",\"verificationEvidence\":\"{\\\"model\\\":\\\"qwen3.5:9b\\\",\\\"created_at\\\":\\\"2026-11-02T03:01:10.309671Z\\\",\\\"response\\\":\\\"{\\\\\\\"verdict\\\\\\\":\\\\\\\"accept\\\\\\\",\\\\\\\"candidateId\\\\\\\":\\\\\\\"derived-compound-6db0b713e57e65ee2b3653b3\\\\\\\",\\\\\\\"headKind\\\\\\\":\\\\\\\"lexical-head\\\\\\\",\\\\\\\"target