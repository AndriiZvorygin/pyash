su text "derived-compound-32ddf5b8416f271c8951456f" ob text "{\"language\":\"canonical\",\"surface\":\"church building\",\"target\":\"church building\",\"sourceMorphemes\":[\"church\",\"building\"],\"morphemes\":[\"church\",\"building\"],\"componentGlosses\":[\"church\",\"building\"],\"pyashSequence\":[\"kyic\",\"plit\"],\"componentLayers\":[16,16],\"maxLayer\":16,\"head\":\"building\",\"modifiers\":[\"church\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"ending-overlap-review\",\"morphologySignals\":[{\"ending\":\"ing\",\"kind\":\"derivational-ending\",\"component\":\"building\",\"boundary\":\"inside-component\",\"evidence\":\"explicit Pyash affix marker in vocabulary row 6088\"},{\"ending\":\"ing\",\"kind\":\"grammatical-ending\",\"component\":\"building\",\"boundary\":\"inside-component\",\"evidence\":\"English progressive or participial ending\"}],\"sourceSurfaces\":{\"english\":\"church building\"},\"sourceMorphemesByLanguage\":{\"english\":[\"church\",\"building\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-32ddf5b8416f271c8951456f\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":59,\"componentSenseEvidence\":[{\"component\":\"church\",\"source\":\"n:08099479-n\",\"lemmas\":[\"church\",\"christian church\"],\"definition\":\"one of the groups of Christians who have their own beliefs and forms of worship\"},{\"component\":\"church\",\"source\":\"n:03031762-n\",\"lemmas\":[\"church\",\"church building\"],\"definition\":\"a place for public (especially Christian) worship\"},{\"component\":\"church\",\"source\":\"n:01034400-n\",\"lemmas\":[\"church service\",\"church\"],\"definition\":\"a service conducted in a house of worship\"},{\"component\":\"church\",\"source\":\"n:08099776-n\",\"lemmas\":[\"church\"],\"definition\":\"