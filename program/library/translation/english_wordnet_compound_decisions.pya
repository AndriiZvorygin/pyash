su text "derived-compound-8f362df7b9ffd322a1cee877" ob text "{\"language\":\"canonical\",\"surface\":\"cloudburst\",\"target\":\"cloudburst\",\"sourceMorphemes\":[\"cloud\",\"burst\"],\"morphemes\":[\"cloud\",\"burst\"],\"componentGlosses\":[\"cloud\",\"burst\"],\"pyashSequence\":[\"hyen\",\"plas\"],\"componentLayers\":[19,16],\"maxLayer\":19,\"head\":\"burst\",\"modifiers\":[\"cloud\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"chinese\":\"豪雨\",\"french\":\"trombe\",\"hindi\":\"मूसलधार बारिश\",\"russian\":\"ливень\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"豪雨\"],\"french\":[\"trombe\"],\"hindi\":[\"मूसलधार\",\"बारिश\"],\"russian\":[\"ливень\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"rejected-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-8f362df7b9ffd322a1cee877\",\"componentSenseEvidence\":[{\"component\":\"cloud\",\"source\":\"n:11459786-n\",\"lemmas\":[\"cloud\"],\"definition\":\"any collection of particles (e.g., smoke or dust) or gases that is visible\"},{\"component\":\"cloud\",\"source\":\"n:09270316-n\",\"lemmas\":[\"cloud\"],\"definition\":\"a visible mass of water or ice particles suspended at a considerable altitude\"},{\"component\":\"burst\",\"source\":\"v:00310092-v\",\"lemmas\":[\"burst\",\"split\",\"break open\"],\"definition\":\"come open suddenly and violently, as if from internal pressure\"},{\"component\":\"burst\",\"source\":\"n:00990406-n\",\"lemmas\":[\"fusillade\",\"salvo\",\"volley\",\"burst\"],\"definition\":\"rapid simultaneous discharge of firearms\"},{\"component\":\"burst\",\"source\":\"v:00306798-v\",\"lemmas\":[\"explode\",\"burst\"],\"definition\":\"burst outward, usually with noise\"},{\"component\":\"bur