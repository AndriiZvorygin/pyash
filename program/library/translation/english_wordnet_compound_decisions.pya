su text "derived-compound-0cdb995c7272e096185d3caa" ob text "{\"language\":\"canonical\",\"surface\":\"first base\",\"target\":\"first base\",\"sourceMorphemes\":[\"first\",\"base\"],\"morphemes\":[\"first\",\"base\"],\"componentGlosses\":[\"first\",\"base\"],\"pyashSequence\":[\"hpam\",\"hbis\"],\"componentLayers\":[16,24],\"maxLayer\":24,\"head\":\"base\",\"modifiers\":[\"first\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"first base\"},\"sourceMorphemesByLanguage\":{\"english\":[\"first\",\"base\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-0cdb995c7272e096185d3caa\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"first\",\"source\":\"a:01014459-a\",\"lemmas\":[\"first\",\"1st\"],\"definition\":\"preceding all others in time or space or degree\"},{\"component\":\"first\",\"source\":\"r:00103286-r\",\"lemmas\":[\"first\",\"firstly\",\"foremost\",\"first of all\",\"first off\"],\"definition\":\"before anything else\"},{\"component\":\"first\",\"source\":\"r:00104262-r\",\"lemmas\":[\"first\"],\"definition\":\"the initial time\"},{\"component\":\"first\",\"source\":\"n:13868396-n\",\"lemmas\":[\"first\",\"number one\"],\"definition\":\"the first or highest in an ordering or series\"},{\"component\":\"base\",\"source\":\"n:02801040-n\",\"lemmas\":[\"base\",\"bag\"],\"definition\":\"a place that the runner must touch before scoring\"},{\"component\":\"base\",\"source\":\"v:00638550-v\",\"lemmas\":[\"establish\",\"base\",\"ground\",\"found\"],\"definition\":\"use as a basis for\"},{\"component\":\"base\",\"source\":\"n:05801562-n\",\"lemmas\":[\"basis\",\"base\",\"foundation\",\"fundament\",\"groundwork\",