su text "derived-compound-0d60aeffc5fd473af98a5783" ob text "{\"language\":\"canonical\",\"surface\":\"church roll\",\"target\":\"church roll\",\"sourceMorphemes\":[\"church\",\"roll\"],\"morphemes\":[\"church\",\"roll\"],\"componentGlosses\":[\"church\",\"roll\"],\"pyashSequence\":[\"kyic\",\"hrun\"],\"componentLayers\":[16,19],\"maxLayer\":19,\"head\":\"roll\",\"modifiers\":[\"church\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"church roll\"},\"sourceMorphemesByLanguage\":{\"english\":[\"church\",\"roll\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-0d60aeffc5fd473af98a5783\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"church\",\"source\":\"n:08099479-n\",\"lemmas\":[\"church\",\"christian church\"],\"definition\":\"one of the groups of Christians who have their own beliefs and forms of worship\"},{\"component\":\"church\",\"source\":\"n:03031762-n\",\"lemmas\":[\"church\",\"church building\"],\"definition\":\"a place for public (especially Christian) worship\"},{\"component\":\"church\",\"source\":\"n:01034400-n\",\"lemmas\":[\"church service\",\"church\"],\"definition\":\"a service conducted in a house of worship\"},{\"component\":\"church\",\"source\":\"n:08099776-n\",\"lemmas\":[\"church\"],\"definition\":\"the body of people who attend or belong to a particular local church\"},{\"component\":\"roll\",\"source\":\"n:06506991-n\",\"lemmas\":[\"roll\",\"roster\"],\"definition\":\"a list of names\"},{\"component\":\"roll\",\"source\":\"v:01870178-v\",\"lemmas\":[\"roll\",\"turn over\"],\"definition\":\"move by turning over or rotating\"},{\"component\":\"roll\",\"source\":\"v:01885173-v\",\"lemma