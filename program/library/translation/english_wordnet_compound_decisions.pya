su text "derived-compound-39041d8fec9cd70bf02a65bb" ob text "{\"language\":\"canonical\",\"surface\":\"documentary film\",\"target\":\"documentary film\",\"sourceMorphemes\":[\"documentary\",\"film\"],\"morphemes\":[\"documentary\",\"film\"],\"componentGlosses\":[\"documentary\",\"film\"],\"pyashSequence\":[\"dwut\",\"flim\"],\"componentLayers\":[24,16],\"maxLayer\":24,\"head\":\"film\",\"modifiers\":[\"documentary\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"documentary film\"},\"sourceMorphemesByLanguage\":{\"english\":[\"documentary\",\"film\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-39041d8fec9cd70bf02a65bb\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":5,\"componentSenseEvidence\":[{\"component\":\"documentary\",\"source\":\"n:06629313-n\",\"lemmas\":[\"documentary\",\"docudrama\",\"documentary film\",\"infotainment\"],\"definition\":\"a film or TV program presenting the facts about a person or event\"},{\"component\":\"documentary\",\"source\":\"a:02908041-a\",\"lemmas\":[\"documentary\",\"documental\"],\"definition\":\"relating to or consisting of or derived from documents\"},{\"component\":\"documentary\",\"source\":\"s:01940473-s\",\"lemmas\":[\"documentary\"],\"definition\":\"(of film, television, radio, or photography) depicting a real-life event using images or interviews with people involved in the event\"},{\"component\":\"film\",\"source\":\"n:06626039-n\",\"lemmas\":[\"movie\",\"film\",\"picture\",\"moving picture\",\"moving picture show\",\"motion picture\",\"motion picture show\",\"picture show\",\"pic\",\"flick\"],\"definition\":\"a form of entertainment that enacts a story by sound and a sequence of images giving the illusion of continuous movement\"},{\"component\":\"film\",\"source\":\"n:06273220-n\",\"lemmas\":[\"film\",\"cinema\",\"celluloid\"],\"definition\":\"a medium that disseminates moving pictures\"},{\"component\":\"film\",\"source\":\"v:01004785-v\",\"lemmas\":[\"film\",\"shoot\",\"take\"],\"definition\":\"make a film or photograph of something\"},{\"component\":\"film\",\"source\":\"n:03343593-n\",\"lemmas\":[\"film\"],\"definition\":\"a thin coating or layer\"}],\"targetSenseEvidence\":[{\"source\":\"n:06629313-n\",\"pos\":\"n\",\"lemmas\":[\"docudrama\",\"documentary\",\"documentary film\",\"infotainment\"],\"definition\":\"a film or TV program presenting the facts about a person or event\",\"compatibleHeadSenseIds\":[\"n:06626039-n\"]}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"accepted-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1,\"verifier\":\"mind\",\"verificationRationale\":\"Modifier 'documentary' (film sense) combines with head 'film' to form target meaning literally.\",\"verificationHeadKind\":\"lexical-head\",\"verificationSenseId\":\"n:06629313-n\",\"verificationHeadSenseId\":\"n:06626039-n\",\"verificationModifierSenseIds\":[\"n:06629313-n\"],\"verificationModifierEvidence\":[\"documentary as a film presenting facts modifies film literally\"],\"verificationModifierRelations\":[\"literal\"],\"verificationHeadRelation\":\"supported\",\"verificationEvidence\":\"{\\\"model\\\":\\\"qwen3.5:9b\\\",\\\"created_at\\\":\\\"2026-11-02T02:41:46.222278Z\\\",\\\"response\\\":\\\"{\\\\\\\"verdict\\\\\\\":\\\\\\\"accept\\\\\\\",\\\\\\\"candidateId\\\\\\\":\\\\\\\"derived-compound-39041d8fec9cd70bf02a65bb\\\\\\\",\\\\\\\"headKind\\\\\\\":\\\\\\\"lexical-head\\\\\\\",\\\\\\\"targetSense