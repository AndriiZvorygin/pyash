su text "derived-compound-89268b0450b00a5b78580bb6" ob text "{\"language\":\"canonical\",\"surface\":\"brush wolf\",\"target\":\"brush wolf\",\"sourceMorphemes\":[\"brush\",\"wolf\"],\"morphemes\":[\"brush\",\"wolf\"],\"componentGlosses\":[\"brush\",\"wolf\"],\"pyashSequence\":[\"broc\",\"hwek\"],\"componentLayers\":[24,19],\"maxLayer\":24,\"head\":\"wolf\",\"modifiers\":[\"brush\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"brush wolf\"},\"sourceMorphemesByLanguage\":{\"english\":[\"brush\",\"wolf\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-89268b0450b00a5b78580bb6\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"brush\",\"source\":\"v:01874036-v\",\"lemmas\":[\"brush\",\"sweep\"],\"definition\":\"sweep across or over\"},{\"component\":\"brush\",\"source\":\"n:08454507-n\",\"lemmas\":[\"brush\",\"brushwood\",\"coppice\",\"copse\",\"thicket\"],\"definition\":\"a dense growth of bushes\"},{\"component\":\"brush\",\"source\":\"v:01246373-v\",\"lemmas\":[\"brush\"],\"definition\":\"rub with a brush, or as if with a brush\"},{\"component\":\"brush\",\"source\":\"v:01243284-v\",\"lemmas\":[\"brush\"],\"definition\":\"touch lightly and briefly\"},{\"component\":\"wolf\",\"source\":\"n:02116752-n\",\"lemmas\":[\"wolf\"],\"definition\":\"any of various predatory carnivorous canine mammals of North America and Eurasia that usually hunt in packs\"},{\"component\":\"wolf\",\"source\":\"n:09864997-n\",\"lemmas\":[\"beast\",\"wolf\",\"savage\",\"brute\",\"wildcat\"],\"definition\":\"a cruelly rapacious person\"},{\"component\":\"wolf\",\"source\":\"n:10806873-n\",\"lemmas\":[\"wolf\",\"woman chaser\",\"skirt chas