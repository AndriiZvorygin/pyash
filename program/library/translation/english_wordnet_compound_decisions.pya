su text "derived-compound-1d727cd6d2e414646bf466bf" ob text "{\"language\":\"canonical\",\"surface\":\"hunting expedition\",\"target\":\"hunting expedition\",\"sourceMorphemes\":[\"hunting\",\"expedition\"],\"morphemes\":[\"hunting\",\"expedition\"],\"componentGlosses\":[\"hunting\",\"expedition\"],\"pyashSequence\":[\"clik\",\"hsen\"],\"componentLayers\":[16,19],\"maxLayer\":19,\"head\":\"expedition\",\"modifiers\":[\"hunting\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"ending-overlap-review\",\"morphologySignals\":[{\"ending\":\"ion\",\"kind\":\"derivational-ending\",\"component\":\"expedition\",\"boundary\":\"inside-component\",\"evidence\":\"English nominalizing ending\"}],\"sourceSurfaces\":{\"english\":\"hunting expedition\"},\"sourceMorphemesByLanguage\":{\"english\":[\"hunting\",\"expedition\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-1d727cd6d2e414646bf466bf\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":2,\"componentSenseEvidence\":[{\"component\":\"hunting\",\"source\":\"n:00453279-n\",\"lemmas\":[\"hunt\",\"hunting\"],\"definition\":\"the pursuit and killing or capture of wild animals regarded as a sport\"},{\"component\":\"hunting\",\"source\":\"n:00947217-n\",\"lemmas\":[\"search\",\"hunt\",\"hunting\"],\"definition\":\"the activity of looking thoroughly in order to find something or someone\"},{\"component\":\"hunting\",\"source\":\"n:00623824-n\",\"lemmas\":[\"hunt\",\"hunting\"],\"definition\":\"the work of finding and killing or capturing animals for food or pelts\"},{\"component\":\"expedition\",\"source\":\"n:00310473-n\",\"lemmas\":[\"expedition\"],\"definition\":\"a journey organized for a particular purpose\"},{\"component\":\"expedition\",\"source\":\"n:00970583-n\",\"lemmas\":[\"expedition\",\"m