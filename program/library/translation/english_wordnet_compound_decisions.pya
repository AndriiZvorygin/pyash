su text "derived-compound-ed911dfb33a02e931b58469a" ob text "{\"language\":\"canonical\",\"surface\":\"second base\",\"target\":\"second base\",\"sourceMorphemes\":[\"second\",\"base\"],\"morphemes\":[\"second\",\"base\"],\"componentGlosses\":[\"second\",\"base\"],\"pyashSequence\":[\"tlit\",\"hbis\"],\"componentLayers\":[16,24],\"maxLayer\":24,\"head\":\"base\",\"modifiers\":[\"second\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"second base\"},\"sourceMorphemesByLanguage\":{\"english\":[\"second\",\"base\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-ed911dfb33a02e931b58469a\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":2,\"componentSenseEvidence\":[{\"component\":\"second\",\"source\":\"s:02209815-s\",\"lemmas\":[\"second\",\"2nd\",\"2d\"],\"definition\":\"coming next after the first in position in space or time or degree or magnitude\"},{\"component\":\"second\",\"source\":\"n:15269461-n\",\"lemmas\":[\"moment\",\"minute\",\"second\",\"instant\"],\"definition\":\"a particular point in time\"},{\"component\":\"second\",\"source\":\"n:15271664-n\",\"lemmas\":[\"moment\",\"mo\",\"minute\",\"second\",\"bit\"],\"definition\":\"an indefinitely short time\"},{\"component\":\"second\",\"source\":\"n:15259923-n\",\"lemmas\":[\"second\",\"sec\",\"s\"],\"definition\":\"1/60 of a minute\"},{\"component\":\"base\",\"source\":\"n:02801040-n\",\"lemmas\":[\"base\",\"bag\"],\"definition\":\"a place that the runner must touch before scoring\"},{\"component\":\"base\",\"source\":\"v:00638550-v\",\"lemmas\":[\"establish\",\"base\",\"ground\",\"found\"],\"definition\":\"use as a basis for\"},{\"component\":\"base\",\"source\":\"n:05801562-n\",\"lemmas\":[\"basis