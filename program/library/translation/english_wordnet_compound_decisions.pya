su text "derived-compound-2f7758e0548187b3998951c1" ob text "{\"language\":\"canonical\",\"surface\":\"high school\",\"target\":\"high school\",\"sourceMorphemes\":[\"high\",\"school\"],\"morphemes\":[\"high\",\"school\"],\"componentGlosses\":[\"high\",\"school\"],\"pyashSequence\":[\"hkuc\",\"kcuk\"],\"componentLayers\":[16,16],\"maxLayer\":16,\"head\":\"school\",\"modifiers\":[\"high\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"high school\"},\"sourceMorphemesByLanguage\":{\"english\":[\"high\",\"school\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-2f7758e0548187b3998951c1\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":37,\"componentSenseEvidence\":[{\"component\":\"high\",\"source\":\"a:01213526-a\",\"lemmas\":[\"high\"],\"definition\":\"greater than normal in quantity or amount\"},{\"component\":\"high\",\"source\":\"a:01207229-a\",\"lemmas\":[\"high\"],\"definition\":\"(literal meaning) being at or having a relatively great or specific elevation or upward extension (sometimes used in combinations like ‘knee-high’)\"},{\"component\":\"high\",\"source\":\"n:08426574-n\",\"lemmas\":[\"senior high school\",\"senior high\",\"high\",\"highschool\",\"high school\"],\"definition\":\"a public secondary school usually including grades 9 through 12\"},{\"component\":\"high\",\"source\":\"s:02347190-s\",\"lemmas\":[\"eminent\",\"high\"],\"definition\":\"standing above others in quality or position\"},{\"component\":\"school\",\"source\":\"n:08293641-n\",\"lemmas\":[\"school\"],\"definition\":\"an educational institution\"},{\"component\":\"school\",\"source\":\"n:04153115-n\",\"lemmas\":[\"school\",\"schoolhouse\"],\"definition\":\"a building where you