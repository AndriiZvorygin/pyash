su text "derived-compound-b26468e5b580d8996680390b" ob text "{\"language\":\"canonical\",\"surface\":\"fireball\",\"target\":\"fireball\",\"sourceMorphemes\":[\"fire\",\"ball\"],\"morphemes\":[\"fire\",\"ball\"],\"componentGlosses\":[\"fire\",\"ball\"],\"pyashSequence\":[\"hfuk\",\"hbot\"],\"componentLayers\":[16,24],\"maxLayer\":24,\"head\":\"ball\",\"modifiers\":[\"fire\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"chinese\":\"火球\",\"french\":\"boule de feu\",\"hindi\":\"आग का गोला\",\"russian\":\"огненный шар\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"火球\"],\"french\":[\"boule\",\"de\",\"feu\"],\"hindi\":[\"आग\",\"का\",\"गोला\"],\"russian\":[\"огненный\",\"шар\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"accepted-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-b26468e5b580d8996680390b\",\"componentSenseEvidence\":[{\"component\":\"fire\",\"source\":\"n:07317454-n\",\"lemmas\":[\"fire\"],\"definition\":\"the event of something burning (often destructive)\"},{\"component\":\"fire\",\"source\":\"v:01138209-v\",\"lemmas\":[\"open fire\",\"fire\"],\"definition\":\"start firing a weapon\"},{\"component\":\"fire\",\"source\":\"n:00989024-n\",\"lemmas\":[\"fire\",\"firing\"],\"definition\":\"the act of firing weapons or artillery at an enemy\"},{\"component\":\"fire\",\"source\":\"v:01136251-v\",\"lemmas\":[\"fire\",\"discharge\"],\"definition\":\"cause to go off\"},{\"component\":\"ball\",\"source\":\"n:13922097-n\",\"lemmas\":[\"ball\",\"globe\",\"orb\"],\"definition\":\"an object with a spherical shape\"},{\"component\":\"ball\",\"source\":\"n:02781674-n\",\"lemmas\":[\"ball\"],\"definition\":\"round object that is hit or thrown or kicked in ga