su text "derived-compound-6993a4a12b787547ef651122" ob text "{\"language\":\"canonical\",\"surface\":\"country club\",\"target\":\"country club\",\"sourceMorphemes\":[\"country\",\"club\"],\"morphemes\":[\"country\",\"club\"],\"componentGlosses\":[\"country\",\"club\"],\"pyashSequence\":[\"klac\",\"klup\"],\"componentLayers\":[16,16],\"maxLayer\":16,\"head\":\"club\",\"modifiers\":[\"country\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"country club\"},\"sourceMorphemesByLanguage\":{\"english\":[\"country\",\"club\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-6993a4a12b787547ef651122\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"country\",\"source\":\"n:08514304-n\",\"lemmas\":[\"area\",\"country\"],\"definition\":\"a particular geographical region of indefinite boundary (usually serving some special purpose or distinguished by its people or culture or geography)\"},{\"component\":\"country\",\"source\":\"n:08185877-n\",\"lemmas\":[\"state\",\"nation\",\"country\",\"land\",\"commonwealth\",\"res publica\",\"body politic\"],\"definition\":\"a politically organized body of people under a single government\"},{\"component\":\"country\",\"source\":\"n:08562388-n\",\"lemmas\":[\"country\",\"state\",\"land\"],\"definition\":\"the territory occupied by a nation\"},{\"component\":\"country\",\"source\":\"n:08183451-n\",\"lemmas\":[\"nation\",\"land\",\"country\"],\"definition\":\"the people who live in a nation or country\"},{\"component\":\"club\",\"source\":\"n:08244135-n\",\"lemmas\":[\"club\",\"social club\",\"society\",\"guild\",\"gild\",\"lodge\",\"order\"],\"definition\":\"a formal association of peo