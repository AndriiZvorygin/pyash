su text "derived-compound-d27af367e5c2eef2e5c58525" ob text "{\"language\":\"canonical\",\"surface\":\"abstraction\",\"target\":\"abstraction\",\"sourceMorphemes\":[\"abstract\",\"ion\"],\"morphemes\":[\"abstract\",\"ion\"],\"componentGlosses\":[\"abstract\",\"ion\"],\"pyashSequence\":[\"srut\",\"lyun\"],\"componentLayers\":[19,16],\"maxLayer\":19,\"head\":\"ion\",\"modifiers\":[\"abstract\"],\"componentRoles\":[\"lexeme\",\"lexeme-or-ending\"],\"morphologyStatus\":\"ending-overlap-review\",\"morphologySignals\":[{\"ending\":\"ion\",\"kind\":\"derivational-ending\",\"component\":\"ion\",\"boundary\":\"component\",\"evidence\":\"English nominalizing ending\"}],\"sourceSurfaces\":{\"chinese\":\"抽象化\",\"french\":\"abstraction\",\"hindi\":\"मतिहीनता\",\"interlingua\":\"abstraction\",\"russian\":\"абстракция\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"抽象化\"],\"french\":[\"abstraction\"],\"hindi\":[\"मतिहीनता\"],\"interlingua\":[\"abstraction\"],\"russian\":[\"абстракция\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"rejected-deterministic\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ia.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-d27af367e5c2eef2e5c58525\",\"componentSenseEvidence\":[{\"component\":\"ion\",\"source\":\"n:09338065-n\",\"lemmas\":[\"ion\"],\"definition\":\"a particle that is electrically charged (positive or negative)\"},{\"component\":\"abstract\",\"source\":\"a:00011776-a\",\"lemmas\":[\"abstract\"],\"definition\":\"existing only in the mind\"},{\"component\":\"abstract\",\"source\":\"n:05862715-n\",\"lemmas\":[\"abstraction\",\"abstract\"],\"definition\":\"a concept or idea not associated with any specific instance\"},{\"component\":\"abstract\",\"source\":\"v:00694095-v\",\"lemmas\":[\"abstract\"],\"definition\":\"consider a concept without thinking of a specific example\"},{\"component\":\"abstract\",\"source\":\"n:06480622-n\",\"lemmas\":[\"outline\",\"synopsis\",\"abstract\",\"precis\"],\"definition\":\"a sketchy summary of the main points of an argument or theory\"}],\"targetSenseEvidence\":[{\"source\":\"n:00393656-n\",\"pos\":\"n\",\"lemmas\":[\"abstraction\"],\"definition\":\"the act of withdrawing or removing something\"},{\"source\":\"n:02671631-n\",\"pos\":\"n\",\"lemmas\":[\"abstraction\"],\"definition\":\"an abstract painting\"},{\"source\":\"n:05788101-n\",\"pos\":\"n\",\"lemmas\":[\"abstraction\",\"generalisation\",\"generalization\"],\"definition\":\"the process of formulating general concepts by abstracting common properties of instances\"},{\"source\":\"n:00002137-n\",\"pos\":\"n\",\"lemmas\":[\"abstract entity\",\"abstraction\"],\"definition\":\"a general concept formed by extracting common features from specific examples\"}],\"certainty\":\"deterministic\",\"certaintyScore\":0.65,\"verificationStatus\":\"rejected-deterministic\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation terminates at a known derivational or grammatical ending\"],\"decisionRevision\":\"wordnet-target-and-head-sense-evidence-v5\",\"previousDecision\":{\"decisionRevision\":\"wordnet-component-sense-evidence-v4\",\"status\":\"rejected-deterministic\",\"rationale\":\"closed-word segmentation terminates at a known derivational or grammatical ending\"},\"coverageStatus\":\"candidate-closed\",\"candidateId\":\"derived-compound-d27af367e5c2eef2e5c58525\"}" ya
su text "derived-compound-d28a946df51e8f0b9c6078db" ob text "{\"language\":\"canonical\",\"surface\":\"thunderstorm\",\"target\":\"thunderstorm\",\"sourceMorphemes\":[\"thunder\",\"storm\"],\"morphemes\":[\"thunder\",\"storm\"],\"componentGlosses\":[\"thunder\",\"storm\"],\"pyashSequence\":[\"grit\",\"hfup\"],\"componentLayers\":[24,16],\"maxLayer\":24,\"head\":\"storm\",\"modifiers\":[\"thunder\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"chinese\":\"雷雨\",\"french\":\"orage\",\"hindi\":\"आंधी तूफान\",\"russian\":\"гроза\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"雷雨\"],\"french\":[\"orage\"],\"hindi\":[\"आंधी\",\"तूफान\"],\"russian\":[\"гроза\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"accepted-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-d28a946df51e8f0b9c6078db\",\"componentSenseEvidence\":[{\"component\":\"thunder\",\"source\":\"n:07392282-n\",\"lemmas\":[\"boom\",\"roar\",\"roaring\",\"thunder\"],\"definition\":\"a deep prolonged loud noise\"},{\"component\":\"thunder\",\"source\":\"v:00917558-v\",\"lemmas\":[\"thunder\",\"roar\"],\"definition\":\"utter words loudly and forcefully\"},{\"component\":\"thunder\",\"source\":\"n:07411955-n\",\"lemmas\":[\"thunder\"],\"definition\":\"a booming or crashing noise caused by air expanding along the path of a bolt of lightning\"},{\"component\":\"thunder\",\"source\":\"v:02093059-v\",\"lemmas\":[\"thunder\"],\"definition\":\"move fast, noisily, and heavily\"},{\"component\":\"storm\",\"source\":\"n:11482925-n\",\"lemmas\":[\"storm\",\"violent storm\"],\"definition\":\"a violent weather condition with winds 64-72 knots (11 on the Beaufort scale) and precipitation and thunder and lightning\"},{\