su text "derived-compound-d8c6aa94035aa82cac804e86" ob text "{\"language\":\"canonical\",\"surface\":\"daystar\",\"target\":\"daystar\",\"sourceMorphemes\":[\"day\",\"star\"],\"morphemes\":[\"day\",\"star\"],\"componentGlosses\":[\"day\",\"star\"],\"pyashSequence\":[\"tcin\",\"srat\"],\"componentLayers\":[16,19],\"maxLayer\":19,\"head\":\"star\",\"modifiers\":[\"day\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"chinese\":\"晨星\",\"french\":\"vedette du matin\",\"hindi\":\"सुबह का तारा\",\"russian\":\"Дейстар\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"晨星\"],\"french\":[\"vedette\",\"du\",\"matin\"],\"hindi\":[\"सुबह\",\"का\",\"तारा\"],\"russian\":[\"Дейстар\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"accepted-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-d8c6aa94035aa82cac804e86\",\"componentSenseEvidence\":[{\"component\":\"day\",\"source\":\"n:15180180-n\",\"lemmas\":[\"day\",\"twenty four hours\",\"twenty four hour period\",\"24 hour interval\",\"solar day\",\"mean solar day\"],\"definition\":\"time for Earth to make a complete rotation on its axis\"},{\"component\":\"day\",\"source\":\"n:15148032-n\",\"lemmas\":[\"day\"],\"definition\":\"a point or period in time\"},{\"component\":\"day\",\"source\":\"n:15182185-n\",\"lemmas\":[\"day\"],\"definition\":\"a day assigned to a particular purpose or observance\"},{\"component\":\"day\",\"source\":\"n:15190004-n\",\"lemmas\":[\"day\",\"daytime\",\"daylight\"],\"definition\":\"the time after sunrise and before sunset while it is light outside\"},{\"component\":\"star\",\"source\":\"n:09467004-n\",\"lemmas\":[\"star\"],\"definition\":\"(astronomy) a celestial body of hot gases that radiates ener