su text "derived-compound-5b67d85c2dbe216646026177" ob text "{\"language\":\"canonical\",\"surface\":\"downfall\",\"target\":\"downfall\",\"sourceMorphemes\":[\"down\",\"fall\"],\"morphemes\":[\"down\",\"fall\"],\"componentGlosses\":[\"down\",\"fall\"],\"pyashSequence\":[\"hcic\",\"hfut\"],\"componentLayers\":[16,16],\"maxLayer\":16,\"head\":\"fall\",\"modifiers\":[\"down\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"chinese\":\"倒台\",\"french\":\"chute\",\"hindi\":\"अपकर्ष\",\"russian\":\"ниспровержение\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"倒台\"],\"french\":[\"chute\"],\"hindi\":[\"अपकर्ष\"],\"russian\":[\"ниспровержение\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"accepted-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-5b67d85c2dbe216646026177\",\"componentSenseEvidence\":[{\"component\":\"down\",\"source\":\"r:00095870-r\",\"lemmas\":[\"down\",\"downwards\",\"downward\",\"downwardly\"],\"definition\":\"spatially or metaphorically from a higher to a lower level or position\"},{\"component\":\"down\",\"source\":\"r:00096162-r\",\"lemmas\":[\"down\"],\"definition\":\"away from a more central or a more northerly place\"},{\"component\":\"down\",\"source\":\"a:02501639-a\",\"lemmas\":[\"down\"],\"definition\":\"being or moving lower in position or less in some value\"},{\"component\":\"down\",\"source\":\"v:01242426-v\",\"lemmas\":[\"down\",\"knock down\",\"cut down\",\"push down\",\"pull down\"],\"definition\":\"cause to come or go down\"},{\"component\":\"fall\",\"source\":\"n:07442328-n\",\"lemmas\":[\"fall\",\"downfall\"],\"definition\":\"a sudden decline in strength or number or importance\"},{\"component\":\"fall\",\"source\":\"v:01976312-v\",\"lemmas\":[\"fall\"],\"definition\":\"descend in free fall under the influence of gravity\"},{\"component\":\"fall\",\"source\":\"v:01974840-v\",\"lemmas\":[\"descend\",\"fall\",\"go down\",\"come down\"],\"definition\":\"move downward and lower, but not necessarily all the way\"},{\"component\":\"fall\",\"source\":\"v:00147635-v\",\"lemmas\":[\"fall\"],\"definition\":\"pass suddenly and passively into a state of body or mind\"}],\"targetSenseEvidence\":[{\"source\":\"n:07442328-n\",\"pos\":\"n\",\"lemmas\":[\"downfall\",\"fall\"],\"definition\":\"a sudden decline in strength or number or importance\",\"compatibleHeadSenseIds\":[\"n:07442328-n\"]},{\"source\":\"n:07332733-n\",\"pos\":\"n\",\"lemmas\":[\"downfall\",\"ruin\",\"ruination\"],\"definition\":\"failure that results in a loss of position or reputation\",\"compatibleHeadSenseIds\":[]},{\"source\":\"n:11515038-n\",\"pos\":\"n\",\"lemmas\":[\"downfall\",\"precipitation\"],\"definition\":\"the falling to earth of any form of water (rain or snow or hail or sleet or mist)\",\"compatibleHeadSenseIds\":[]}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"accepted-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1,\"verifier\":\"mind\",\"verificationRationale\":\"Modifier 'down' (r:00095870-r) is literal; head 'fall' (n:07442328-n) matches target definition.\",\"verificationHeadKind\":\"lexical-head\",\"verificationSenseId\":\"n:07442328-n\",\"verificationHeadSenseId\":\"n:07442328-n\",\"verificationModifierSenseIds\":[\"r:00095870-r\"],\"verificationModifierEvidence\":[\"down contributes the sense of moving from a higher to a lower level, which literally modifies fall to specify a decline\"],\"verificationModifierRelations\":[\