su text "derived-compound-fe51d749a3d112913ae05af0" ob text "{\"language\":\"canonical\",\"surface\":\"country doctor\",\"target\":\"country doctor\",\"sourceMorphemes\":[\"country\",\"doctor\"],\"morphemes\":[\"country\",\"doctor\"],\"componentGlosses\":[\"country\",\"doctor\"],\"pyashSequence\":[\"klac\",\"tsut\"],\"componentLayers\":[16,16],\"maxLayer\":16,\"head\":\"doctor\",\"modifiers\":[\"country\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"country doctor\"},\"sourceMorphemesByLanguage\":{\"english\":[\"country\",\"doctor\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-fe51d749a3d112913ae05af0\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"country\",\"source\":\"n:08514304-n\",\"lemmas\":[\"area\",\"country\"],\"definition\":\"a particular geographical region of indefinite boundary (usually serving some special purpose or distinguished by its people or culture or geography)\"},{\"component\":\"country\",\"source\":\"n:08185877-n\",\"lemmas\":[\"state\",\"nation\",\"country\",\"land\",\"commonwealth\",\"res publica\",\"body politic\"],\"definition\":\"a politically organized body of people under a single government\"},{\"component\":\"country\",\"source\":\"n:08562388-n\",\"lemmas\":[\"country\",\"state\",\"land\"],\"definition\":\"the territory occupied by a nation\"},{\"component\":\"country\",\"source\":\"n:08183451-n\",\"lemmas\":[\"nation\",\"land\",\"country\"],\"definition\":\"the people who live in a nation or country\"},{\"component\":\"doctor\",\"source\":\"n:10040615-n\",\"lemmas\":[\"doctor\",\"doc\",\"physician\",\"md\",\"dr.\",\"medico\"],\"definition\":\"a licensed medical practit