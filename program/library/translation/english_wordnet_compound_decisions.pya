su text "derived-compound-40b267132dbbc9f62fd2f0ce" ob text "{\"language\":\"canonical\",\"surface\":\"light bulb\",\"target\":\"light bulb\",\"sourceMorphemes\":[\"light\",\"bulb\"],\"morphemes\":[\"light\",\"bulb\"],\"componentGlosses\":[\"light\",\"bulb\"],\"pyashSequence\":[\"kwan\",\"blop\"],\"componentLayers\":[16,24],\"maxLayer\":24,\"head\":\"bulb\",\"modifiers\":[\"light\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"light bulb\"},\"sourceMorphemesByLanguage\":{\"english\":[\"light\",\"bulb\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-40b267132dbbc9f62fd2f0ce\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":2,\"componentSenseEvidence\":[{\"component\":\"light\",\"source\":\"n:11494354-n\",\"lemmas\":[\"light\",\"visible light\",\"visible radiation\"],\"definition\":\"(physics) electromagnetic radiation that can produce a visual sensation\"},{\"component\":\"light\",\"source\":\"n:03670692-n\",\"lemmas\":[\"light\",\"light source\"],\"definition\":\"any device serving as a source of illumination\"},{\"component\":\"light\",\"source\":\"a:01189951-a\",\"lemmas\":[\"light\"],\"definition\":\"of comparatively little physical weight or density\"},{\"component\":\"light\",\"source\":\"n:06220526-n\",\"lemmas\":[\"light\"],\"definition\":\"a particular perspective or aspect of a situation\"},{\"component\":\"bulb\",\"source\":\"n:03671250-n\",\"lemmas\":[\"light bulb\",\"lightbulb\",\"bulb\",\"incandescent lamp\",\"electric light\",\"electric light bulb\"],\"definition\":\"electric lamp consisting of a transparent or translucent glass housing containing a wire filament (usually tungsten) that emits light when heated by electricity\"},{\"component\":\"bulb\",\"source\":\"n:13154818-n\",\"lemmas\":[\"bulb\"],\"definition\":\"a modified bud consisting of a thickened globular underground stem serving as a reproductive structure\"},{\"component\":\"bulb\",\"source\":\"n:02918826-n\",\"lemmas\":[\"bulb\"],\"definition\":\"a rounded part of a cylindrical instrument (usually at one end)\"},{\"component\":\"bulb\",\"source\":\"n:05234409-n\",\"lemmas\":[\"bulb\"],\"definition\":\"a rounded dilation or expansion in a canal or vessel or organ\"}],\"targetSenseEvidence\":[{\"source\":\"n:03671250-n\",\"pos\":\"n\",\"lemmas\":[\"bulb\",\"electric light\",\"electric light bulb\",\"incandescent lamp\",\"light bulb\",\"lightbulb\"],\"definition\":\"electric lamp consisting of a transparent or translucent glass housing containing a wire filament (usually tungsten) that emits light when heated by electricity\",\"compatibleHeadSenseIds\":[\"n:03671250-n\"]}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"accepted-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1,\"verifier\":\"mind\",\"verificationRationale\":\"Modifier 'light' (source n:03670692-n) literally denotes the device's function, matching target definition.\",\"verificationHeadKind\":\"lexical-head\",\"verificationSenseId\":\"n:03671250-n\",\"verificationHeadSenseId\":\"n:03671250-n\",\"verificationModifierSenseIds\":[\"n:03670692-n\"],\"verificationModifierEvidence\":[\"light as a source of illumination modifies bulb to specify the device's function\"],\"verificationModifierRelations\":[\"literal\"],\"verificationHeadRelation\":\"supported\",\"verificationEvidence\":\"{\\\"model\\\":\\\"qwen3.5:9b\\\",\\\"created_at\\\":\\\"2026-11-02T02:51:07.161026Z\\\",\\\"response\\\":\\\"{\\\\\\\"v