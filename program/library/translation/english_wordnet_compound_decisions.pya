su text "derived-compound-e978b792a5d4ad302e2546e3" ob text "{\"language\":\"canonical\",\"surface\":\"blackjack\",\"target\":\"blackjack\",\"sourceMorphemes\":[\"black\",\"jack\"],\"morphemes\":[\"black\",\"jack\"],\"componentGlosses\":[\"black\",\"jack\"],\"pyashSequence\":[\"hkis\",\"djak\"],\"componentLayers\":[16,24],\"maxLayer\":24,\"head\":\"jack\",\"modifiers\":[\"black\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"chinese\":\"酒杯\",\"french\":\"blackjack\",\"hindi\":\"लाठी\",\"russian\":\"Блэк Джек\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"酒杯\"],\"french\":[\"blackjack\"],\"hindi\":[\"लाठी\"],\"russian\":[\"Блэк\",\"Джек\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"rejected-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-e978b792a5d4ad302e2546e3\",\"componentSenseEvidence\":[{\"component\":\"black\",\"source\":\"a:00393873-a\",\"lemmas\":[\"black\"],\"definition\":\"being of the achromatic color of maximum darkness\"},{\"component\":\"black\",\"source\":\"n:09659490-n\",\"lemmas\":[\"black\",\"african american\",\"negro\",\"negroid\"],\"definition\":\"a person with African ancestry, ‘Negro’ and ‘Negroid’ are archaic and pejorative today\"},{\"component\":\"black\",\"source\":\"s:01053787-s\",\"lemmas\":[\"black\",\"calamitous\",\"disastrous\",\"fatal\",\"fateful\"],\"definition\":\"(of events) having extremely unfortunate or dire consequences\"},{\"component\":\"black\",\"source\":\"s:01135435-s\",\"lemmas\":[\"black\",\"dark\",\"sinister\"],\"definition\":\"stemming from evil characteristics or forces\"},{\"component\":\"jack\",\"source\":\"n:10260997-n\",\"lemmas\":[\"laborer\",\"manual laborer\",\"labourer\",\"jack\"],\"definition\":\"someone who works with their hands\"},{\"component\":\"jack\",\"source\":\"n:10314263-n\",\"lemmas\":[\"mariner\",\"seaman\",\"tar\",\"jack tar\",\"jack\",\"old salt\",\"seafarer\",\"gob\",\"sea dog\"],\"definition\":\"a man who serves as a sailor\"},{\"component\":\"jack\",\"source\":\"n:02392595-n\",\"lemmas\":[\"jack\",\"jackass\"],\"definition\":\"male donkey\"},{\"component\":\"jack\",\"source\":\"n:02579206-n\",\"lemmas\":[\"jack\"],\"definition\":\"any of several fast-swimming predacious fishes of tropical to warm temperate seas\"}],\"targetSenseEvidence\":[{\"source\":\"n:00491361-n\",\"pos\":\"n\",\"lemmas\":[\"blackjack\",\"twenty one\",\"vingt et un\"],\"definition\":\"a gambling game using cards\"},{\"source\":\"n:02850247-n\",\"pos\":\"n\",\"lemmas\":[\"black flag\",\"blackjack\",\"jolly roger\",\"pirate flag\"],\"definition\":\"a flag usually bearing a white skull and crossbones on a black background\"},{\"source\":\"n:02850699-n\",\"pos\":\"n\",\"lemmas\":[\"blackjack\",\"cosh\",\"sap\"],\"definition\":\"a piece of metal covered by leather with a flexible handle\"},{\"source\":\"n:12295380-n\",\"pos\":\"n\",\"lemmas\":[\"blackjack\",\"blackjack oak\",\"jack oak\",\"quercus marilandica\"],\"definition\":\"a common scrubby deciduous tree of central and southeastern United States having dark bark and broad three-lobed (club-shaped) leaves\"}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"rejected-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1,\"verifier\":\"mind\",\"verificationRationale\":\"No target sense is a kind of 'jack' (donkey/fish/laborer); meanings are metaphorical or unrelated.\",\"verificationHeadKind\":\"lexical-head\",\"verificationEvidence\":\"{\\\"mod