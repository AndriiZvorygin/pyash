su text "derived-compound-616b1b54da164bfa256a3f16" ob text "{\"language\":\"canonical\",\"surface\":\"expense account\",\"target\":\"expense account\",\"sourceMorphemes\":[\"expense\",\"account\"],\"morphemes\":[\"expense\",\"account\"],\"componentGlosses\":[\"expense\",\"account\"],\"pyashSequence\":[\"fyin\",\"hkun\"],\"componentLayers\":[16,16],\"maxLayer\":16,\"head\":\"account\",\"modifiers\":[\"expense\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"expense account\"},\"sourceMorphemesByLanguage\":{\"english\":[\"expense\",\"account\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-616b1b54da164bfa256a3f16\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"expense\",\"source\":\"n:13296518-n\",\"lemmas\":[\"expense\",\"disbursal\",\"disbursement\"],\"definition\":\"amounts paid for goods and services that may be currently tax deductible (as opposed to capital expenditures)\"},{\"component\":\"expense\",\"source\":\"n:07435271-n\",\"lemmas\":[\"expense\"],\"definition\":\"a detriment or sacrifice\"},{\"component\":\"expense\",\"source\":\"n:13298909-n\",\"lemmas\":[\"expense\"],\"definition\":\"money spent to perform work and usually reimbursed by an employer\"},{\"component\":\"expense\",\"source\":\"v:00316757-v\",\"lemmas\":[\"expense\",\"write off\",\"write down\"],\"definition\":\"reduce the estimated value of something\"},{\"component\":\"account\",\"source\":\"n:13376000-n\",\"lemmas\":[\"account\",\"accounting\",\"account statement\"],\"definition\":\"a statement of recent transactions and the resulting balance\"},{\"component\":\"account\",\"source\":\"v:00967067-v\",\"lemmas\":[\"report\",\"des