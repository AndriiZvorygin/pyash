su text "derived-compound-72654098b8793e36db8d0207" ob text "{\"language\":\"canonical\",\"surface\":\"night club\",\"target\":\"night club\",\"sourceMorphemes\":[\"night\",\"club\"],\"morphemes\":[\"night\",\"club\"],\"componentGlosses\":[\"night\",\"club\"],\"pyashSequence\":[\"hyam\",\"klup\"],\"componentLayers\":[16,16],\"maxLayer\":16,\"head\":\"club\",\"modifiers\":[\"night\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"night club\"},\"sourceMorphemesByLanguage\":{\"english\":[\"night\",\"club\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-72654098b8793e36db8d0207\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":6,\"componentSenseEvidence\":[{\"component\":\"night\",\"source\":\"n:15192074-n\",\"lemmas\":[\"night\",\"nighttime\",\"dark\"],\"definition\":\"the time after sunset and before sunrise while it is dark outside\"},{\"component\":\"night\",\"source\":\"n:14007202-n\",\"lemmas\":[\"night\"],\"definition\":\"darkness\"},{\"component\":\"night\",\"source\":\"n:15180707-n\",\"lemmas\":[\"night\"],\"definition\":\"the dark part of the diurnal cycle considered a time unit\"},{\"component\":\"night\",\"source\":\"n:15192521-n\",\"lemmas\":[\"night\"],\"definition\":\"the period spent sleeping\"},{\"component\":\"club\",\"source\":\"n:02934801-n\",\"lemmas\":[\"cabaret\",\"nightclub\",\"night club\",\"club\",\"nightspot\"],\"definition\":\"a spot that is open late at night and that provides entertainment (as singers or dancers) as well as dancing and food and drink\"},{\"component\":\"club\",\"source\":\"n:08096490-n\",\"lemmas\":[\"baseball club\",\"ball club\",\"club\",\"nine\"],\"definition\":\"a team of professional baseball players who pla