su text "derived-compound-6ef6d4fcd6fef5418696f990" ob text "{\"language\":\"canonical\",\"surface\":\"castration\",\"target\":\"castration\",\"sourceMorphemes\":[\"cast\",\"ration\"],\"morphemes\":[\"cast\",\"ration\"],\"componentGlosses\":[\"cast\",\"ration\"],\"pyashSequence\":[\"tsas\",\"hr6n\"],\"componentLayers\":[16,28],\"maxLayer\":28,\"head\":\"ration\",\"modifiers\":[\"cast\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"ending-overlap-review\",\"morphologySignals\":[{\"ending\":\"ion\",\"kind\":\"derivational-ending\",\"component\":\"ration\",\"boundary\":\"inside-component\",\"evidence\":\"English nominalizing ending\"}],\"sourceSurfaces\":{\"chinese\":\"阉割\",\"french\":\"castration\",\"hindi\":\"बधिया करना\",\"interlingua\":\"castration\",\"russian\":\"кастрация\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"阉割\"],\"french\":[\"castration\"],\"hindi\":[\"बधिया\",\"करना\"],\"interlingua\":[\"castration\"],\"russian\":[\"кастрация\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"rejected-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ia.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-6ef6d4fcd6fef5418696f990\",\"componentSenseEvidence\":[{\"component\":\"cast\",\"source\":\"v:00983308-v\",\"lemmas\":[\"frame\",\"redact\",\"cast\",\"put\",\"couch\"],\"definition\":\"formulate in a particular style or language\"},{\"component\":\"cast\",\"source\":\"v:01885173-v\",\"lemmas\":[\"roll\",\"wander\",\"swan\",\"stray\",\"tramp\",\"roam\",\"cast\",\"ramble\",\"rove\",\"range\",\"drift\",\"vagabond\"],\"definition\":\"move about aimlessly or without any destination, often in search of food or employment\"},{\"component\":\"cast\",\"source\":\"v:01636439-v\",\"lemmas\":[\"project\",\"cast\",\"contrive\",\"throw\"],\"definition\