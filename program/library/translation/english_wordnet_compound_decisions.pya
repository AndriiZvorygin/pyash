etary\"],\"definition\":\"a person who is head of an administrative department of government\"},{\"component\":\"secretary\",\"source\":\"n:04171929-n\",\"lemmas\":[\"secretary\",\"writing table\",\"escritoire\",\"secretaire\"],\"definition\":\"a desk used for writing\"},{\"component\":\"secretary\",\"source\":\"n:10541521-n\",\"lemmas\":[\"repository\",\"secretary\"],\"definition\":\"a person to whom a secret is entrusted\"}],\"targetSenseEvidence\":[{\"source\":\"n:10089788-n\",\"pos\":\"n\",\"lemmas\":[\"executive secretary\"],\"definition\":\"a secretary having administrative duties and responsibilities\",\"compatibleHeadSenseIds\":[\"n:10589188-n\"]}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"accepted-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1,\"verifier\":\"mind\",\"verificationRationale\":\"Modifier 'executive' (admin person) literally restricts head 'secretary' to match target definition.\",\"verificationHeadKind\":\"lexical-head\",\"verificationSenseId\":\"n:10089788-n\",\"verificationHeadSenseId\":\"n:10589188-n\",\"verificationModifierSenseIds\":[\"n:10089452-n\"],\"verificationModifierEvidence\":[\"executive as a person responsible for administration modifies secretary to specify administrative duties\"],\"verificationModifierRelations\":[\"literal\"],\"verificationHeadRelation\":\"supported\",\"verificationEvidence\":\"{\\\"model\\\":\\\"qwen3.5:9b\\\",\\\"created_at\\\":\\\"2026-11-02T03:00:35.540478Z\\\",\\\"response\\\":\\\"{\\\\\\\"verdict\\\\\\\":\\\\\\\"accept\\\\\\\",\\\\\\\"candidateId\\\\\\\":\\\\\\\"derived-compound-1db0ca7e872d267025e9eb1a\\\\\\\",\\\\\\\"headKind\\\\\\\":\\\\\\\"lexical-head\\\\\\\",\\\\\\\"targetSenseId\\\\\\\":\\\\\\\"n:10089788-n\\