su text "derived-compound-f1cdd245b135dcdc6e8fa75b" ob text "{\"language\":\"canonical\",\"surface\":\"red blood cell\",\"target\":\"red blood cell\",\"sourceMorphemes\":[\"red\",\"blood\",\"cell\"],\"morphemes\":[\"red\",\"blood\",\"cell\"],\"componentGlosses\":[\"red\",\"blood\",\"cell\"],\"pyashSequence\":[\"hyuk\",\"cyac\",\"hcep\"],\"componentLayers\":[16,16,19],\"maxLayer\":19,\"head\":\"cell\",\"modifiers\":[\"red\",\"blood\"],\"componentRoles\":[\"lexeme\",\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"red blood cell\"},\"sourceMorphemesByLanguage\":{\"english\":[\"red\",\"blood\",\"cell\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-f1cdd245b135dcdc6e8fa75b\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":5,\"componentSenseEvidence\":[{\"component\":\"red\",\"source\":\"s:00382159-s\",\"lemmas\":[\"red\",\"reddish\",\"ruddy\",\"blood red\",\"carmine\",\"cerise\",\"cherry\",\"cherry red\",\"crimson\",\"ruby\",\"ruby red\",\"scarlet\"],\"definition\":\"of a color at the end of the color spectrum (next to orange)\"},{\"component\":\"red\",\"source\":\"n:04969961-n\",\"lemmas\":[\"red\",\"redness\"],\"definition\":\"red color or pigment\"},{\"component\":\"red\",\"source\":\"s:00249427-s\",\"lemmas\":[\"crimson\",\"red\",\"violent\"],\"definition\":\"characterized by violence or bloodshed\"},{\"component\":\"red\",\"source\":\"s:00396687-s\",\"lemmas\":[\"crimson\",\"red\",\"reddened\",\"red faced\",\"flushed\"],\"definition\":\"(especially of the face) reddened or suffused with or as if with blood from emotion or exertion\"},{\"component\":\"blood\",\"source\":\"n:05407190-n\",\"lemmas\":[\"blood\"],\"definition\":\"the fluid (red in vertebrates) that is pumped through the body by the heart and contains plasma, blood cells, and platelets\"},{\"component\":\"blood\",\"source\":\"n:08118903-n\",\"lemmas\":[\"lineage\",\"line\",\"line of descent\",\"descent\",\"bloodline\",\"blood line\",\"blood\",\"pedigree\",\"ancestry\",\"origin\",\"parentage\",\"stemma\",\"stock\"],\"definition\":\"the hereditary derivation of an individual\"},{\"component\":\"blood\",\"source\":\"n:04636104-n\",\"lemmas\":[\"blood\"],\"definition\":\"temperament or disposition\"},{\"component\":\"blood\",\"source\":\"n:10525535-n\",\"lemmas\":[\"rake\",\"rakehell\",\"profligate\",\"rip\",\"blood\",\"roue\"],\"definition\":\"a dissolute man in fashionable society\"},{\"component\":\"cell\",\"source\":\"n:00006484-n\",\"lemmas\":[\"cell\"],\"definition\":\"(biology) the basic structural and functional unit of all organisms\"},{\"component\":\"cell\",\"source\":\"n:02995166-n\",\"lemmas\":[\"cell\"],\"definition\":\"any small compartment\"},{\"component\":\"cell\",\"source\":\"n:02994503-n\",\"lemmas\":[\"cell\",\"electric cell\"],\"definition\":\"a device that delivers an electric current as the result of a chemical reaction\"},{\"component\":\"cell\",\"source\":\"n:08375521-n\",\"lemmas\":[\"cell\",\"cadre\"],\"definition\":\"a small unit serving as part of or as the nucleus of a larger political movement\"}],\"targetSenseEvidence\":[{\"source\":\"n:05461646-n\",\"pos\":\"n\",\"lemmas\":[\"erythrocyte\",\"rbc\",\"red blood cell\"],\"definition\":\"a mature blood cell that contains hemoglobin to carry oxygen to the bodily tissues\",\"compatibleHeadSenseIds\":[\"n:00006484-n\"]}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"accepted-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1