su text "derived-compound-75f52eb015d50e1129379580" ob text "{\"language\":\"canonical\",\"surface\":\"cootie\",\"target\":\"cootie\",\"sourceMorphemes\":[\"coo\",\"tie\"],\"morphemes\":[\"coo\",\"tie\"],\"componentGlosses\":[\"coo\",\"tie\"],\"pyashSequence\":[\"hku7k\",\"rwat\"],\"componentLayers\":[32,19],\"maxLayer\":32,\"head\":\"tie\",\"modifiers\":[\"coo\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"chinese\":\"虱\",\"french\":\"poux\",\"hindi\":\"जूं\",\"russian\":\"платяная вошь\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"虱\"],\"french\":[\"poux\"],\"hindi\":[\"जूं\"],\"russian\":[\"платяная\",\"вошь\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"rejected-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-75f52eb015d50e1129379580\",\"componentSenseEvidence\":[{\"component\":\"tie\",\"source\":\"v:01288043-v\",\"lemmas\":[\"tie\",\"bind\"],\"definition\":\"fasten or secure with a rope, string, or cord\"},{\"component\":\"tie\",\"source\":\"v:01357376-v\",\"lemmas\":[\"connect\",\"link\",\"tie\",\"link up\"],\"definition\":\"connect, fasten, or put together two or more pieces\"},{\"component\":\"tie\",\"source\":\"n:03679297-n\",\"lemmas\":[\"link\",\"linkup\",\"tie\",\"tie in\"],\"definition\":\"a fastener that serves to join or connect\"},{\"component\":\"tie\",\"source\":\"n:03821155-n\",\"lemmas\":[\"necktie\",\"tie\"],\"definition\":\"neckwear consisting of a long narrow piece of material worn (mostly by men) under a collar and tied in knot at the front\"},{\"component\":\"coo\",\"source\":\"n:07395929-n\",\"lemmas\":[\"coo\"],\"definition\":\"the sound made by a pigeon\"},{\"component\":\"coo\",\"source\":\"v:00911849-v\",\"lemmas\":[\"