su text "derived-compound-0ab34d214211587293f80a2c" ob text "{\"language\":\"canonical\",\"surface\":\"millstone\",\"target\":\"millstone\",\"sourceMorphemes\":[\"mill\",\"stone\"],\"morphemes\":[\"mill\",\"stone\"],\"componentGlosses\":[\"mill\",\"stone\"],\"pyashSequence\":[\"hmok\",\"pwac\"],\"componentLayers\":[19,16],\"maxLayer\":19,\"head\":\"stone\",\"modifiers\":[\"mill\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"interlingua\":\"mola\"},\"sourceMorphemesByLanguage\":{\"interlingua\":[\"mola\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"accepted-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_ia.json\",\"id\":\"derived-compound-0ab34d214211587293f80a2c\",\"componentSenseEvidence\":[{\"component\":\"mill\",\"source\":\"n:03321351-n\",\"lemmas\":[\"factory\",\"mill\",\"manufacturing plant\",\"manufactory\"],\"definition\":\"a plant consisting of one or more buildings with facilities for manufacturing\"},{\"component\":\"mill\",\"source\":\"v:00332827-v\",\"lemmas\":[\"mill\"],\"definition\":\"grind with a mill\"},{\"component\":\"mill\",\"source\":\"v:01906119-v\",\"lemmas\":[\"mill\",\"mill about\",\"mill around\"],\"definition\":\"move about in a confused manner\"},{\"component\":\"mill\",\"source\":\"n:00359116-n\",\"lemmas\":[\"grind\",\"mill\",\"pulverization\",\"pulverisation\"],\"definition\":\"the act of grinding to a powder or dust\"},{\"component\":\"stone\",\"source\":\"n:04333222-n\",\"lemmas\":[\"stone\"],\"definition\":\"building material consisting of a piece of rock hewn in a definite shape for a special purpose\"},{\"component\":\"stone\",\"source\":\"n:09438954-n\",\"lemmas\":[\"rock\",\"stone\"],\"definition\":\"a lump or mass of hard consolidated mineral matter\"},{\"component\":\"stone\",\"source\":\"n:14720954-n\",\"lemmas\":[\"rock\",\"stone\"],\"definition\":\"material consisting of the aggregate of minerals like those making up the Earth's crust\"},{\"component\":\"stone\",\"source\":\"v:01326182-v\",\"lemmas\":[\"stone\",\"lapidate\"],\"definition\":\"kill by throwing stones at\"}],\"targetSenseEvidence\":[{\"source\":\"n:03772470-n\",\"pos\":\"n\",\"lemmas\":[\"millstone\"],\"definition\":\"one of a pair of heavy flat disk-shaped stones that are rotated against one another to grind the grain\",\"compatibleHeadSenseIds\":[\"n:04333222-n\"]},{\"source\":\"n:03772647-n\",\"pos\":\"n\",\"lemmas\":[\"millstone\"],\"definition\":\"any load that is difficult to carry\",\"compatibleHeadSenseIds\":[]},{\"source\":\"n:05697450-n\",\"pos\":\"n\",\"lemmas\":[\"albatross\",\"millstone\"],\"definition\":\"(figurative) something that hinders or handicaps\",\"compatibleHeadSenseIds\":[]}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"accepted-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1,\"verifier\":\"mind\",\"verificationRationale\":\"Mill (grinding action) literally modifies stone (rock material) to form millstone.\",\"verificationHeadKind\":\"lexical-head\",\"verificationSenseId\":\"n:03772470-n\",\"verificationHeadSenseId\":\"n:04333222-n\",\"verificationModifierSenseIds\":[\"n:00359116-n\"],\"verificationModifierEvidence\":[\"mill as the act of grinding provides the literal function for the stone head\"],\"verificationModifierRelations\":[\"literal\"],\"verificationHeadRelation\":\"supported\",\"verificationEvidence\":\"{\\\"model\\\":\\\"qwen3.5:9b\\\",\\\"created_at\\\":\\\"2026-11-02T01:22:42.501585Z\\\",\\\"response\\\":\\\"{\\\\\\\"verdict\\\\\\\":\\\\\\\"accept\\\\\\\",\\\\\\\"candidateId\\\\\\\":\\\\\\\"derived-compound-0ab34d214211587293f80a2