su text "derived-compound-c5a91399a9613f612c0f069f" ob text "{\"language\":\"canonical\",\"surface\":\"flash flood\",\"target\":\"flash flood\",\"sourceMorphemes\":[\"flash\",\"flood\"],\"morphemes\":[\"flash\",\"flood\"],\"componentGlosses\":[\"flash\",\"flood\"],\"pyashSequence\":[\"flac\",\"hnos\"],\"componentLayers\":[16,19],\"maxLayer\":19,\"head\":\"flood\",\"modifiers\":[\"flash\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"flash flood\"},\"sourceMorphemesByLanguage\":{\"english\":[\"flash\",\"flood\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-c5a91399a9613f612c0f069f\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"flash\",\"source\":\"n:15271921-n\",\"lemmas\":[\"blink of an eye\",\"flash\",\"heartbeat\",\"instant\",\"jiffy\",\"split second\",\"trice\",\"twinkling\",\"wink\",\"new york minute\"],\"definition\":\"a very short time (as the time it takes the eye to blink or the heart to beat)\"},{\"component\":\"flash\",\"source\":\"v:02164320-v\",\"lemmas\":[\"flash\",\"blink\",\"wink\",\"twinkle\",\"winkle\"],\"definition\":\"gleam or glow intermittently\"},{\"component\":\"flash\",\"source\":\"n:07426692-n\",\"lemmas\":[\"flash\"],\"definition\":\"a sudden intense burst of radiant energy\"},{\"component\":\"flash\",\"source\":\"v:02065423-v\",\"lemmas\":[\"dart\",\"dash\",\"scoot\",\"scud\",\"flash\",\"shoot\"],\"definition\":\"run or move very quickly or hastily\"},{\"component\":\"flood\",\"source\":\"n:11475008-n\",\"lemmas\":[\"flood\",\"inundation\",\"deluge\",\"alluvion\"],\"definition\":\"the rising of a body of water and its overflowing onto normally dry land\"},{\"component\":\"flood\",\"source\":\"v:01527311-v\",\"lemmas\":[\"deluge\",\"flood\",\"inundate\",\"swamp\"],\"definition\":\"fill quickly beyond capacity\"},{\"component\":\"flood\",\"source\":\"v:00217578-v\",\"lemmas\":[\"flood\"],\"definition\":\"cover with liquid, usually water\"},{\"component\":\"flood\",\"source\":\"n:00330645-n\",\"lemmas\":[\"flood\",\"overflow\",\"outpouring\"],\"definition\":\"a large flow\"}],\"targetSenseEvidence\":[{\"source\":\"n:11475509-n\",\"pos\":\"n\",\"lemmas\":[\"flash flood\",\"flashflood\"],\"definition\":\"a sudden local flood of great volume and short duration\",\"compatibleHeadSenseIds\":[\"n:11475008-n\"]}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"accepted-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1,\"verifier\":\"mind\",\"verificationRationale\":\"Flash (time) + Flood (water rise) = sudden local flood; literal composition matches target definition.\",\"verificationHeadKind\":\"lexical-head\",\"verificationSenseId\":\"n:11475509-n\",\"verificationHeadSenseId\":\"n:11475008-n\",\"verificationModifierSenseIds\":[\"n:07426692-n\"],\"verificationModifierEvidence\":[\"flash as 'a very short time' modifies flood to imply suddenness\"],\"verificationModifierRelations\":[\"literal\"],\"verificationHeadRelation\":\"supported\",\"verificationEvidence\":\"{\\\"model\\\":\\\"qwen3.5:9b\\\",\\\"created_at\\\":\\\"2026-11-02T03:01:04.45807Z\\\",\\\"response\\\":\\\"{\\\\\\\"verdict\\\\\\\":\\\\\\\"accept\\\\\\\",\\\\\\\"candidateId\\\\\\\":\\\\\\\"derived-compound-c5a91399a9613f612c0f069f\\\\\\\",\\\\\\\"headKind\\\\\\\":\\\\\\\"lexical-head\\\\\\\",\\\\\\\"targetSenseId\\\\\\\":\\\\\\\"n:11475509-n\\\\\\\",\\\\\\\"headSenseId\\\\\\\":\\\\\\\"n:11475008-n\\\\\\\",\\