su text "derived-compound-f48e23c55e9a8698dc5c55a9" ob text "{\"language\":\"canonical\",\"surface\":\"pitch black\",\"target\":\"pitch black\",\"sourceMorphemes\":[\"pitch\",\"black\"],\"morphemes\":[\"pitch\",\"black\"],\"componentGlosses\":[\"pitch\",\"black\"],\"pyashSequence\":[\"pric\",\"hkis\"],\"componentLayers\":[19,16],\"maxLayer\":19,\"head\":\"black\",\"modifiers\":[\"pitch\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"english\":\"pitch black\"},\"sourceMorphemesByLanguage\":{\"english\":[\"pitch\",\"black\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"rejected-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-f48e23c55e9a8698dc5c55a9\",\"frequencyRank\":24784,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"pitch\",\"source\":\"v:01515257-v\",\"lemmas\":[\"flip\",\"toss\",\"sky\",\"pitch\"],\"definition\":\"throw or toss with a light motion\"},{\"component\":\"pitch\",\"source\":\"n:04992447-n\",\"lemmas\":[\"pitch\"],\"definition\":\"the property of sound that varies with variation in the frequency of vibration\"},{\"component\":\"pitch\",\"source\":\"v:01868620-v\",\"lemmas\":[\"lurch\",\"pitch\",\"shift\"],\"definition\":\"move abruptly\"},{\"component\":\"pitch\",\"source\":\"n:00107092-n\",\"lemmas\":[\"pitch\",\"delivery\"],\"definition\":\"the act of throwing a baseball or softball by the pitcher towards home plate, which initiates play by giving the batter a chance to hit it\"},{\"component\":\"black\",\"source\":\"n:04967454-n\",\"lemmas\":[\"black\",\"blackness\",\"inkiness\"],\"definition\":\"the quality or state of the achromatic color of least lightness (bearing the least resemblance to white)\"},{\"component\":\"black\",\"source\":\"s:00274934-s\",\"lemmas\":[\"black\",\"pitch black\",\"pitch dark\"],\"definition\":\"extremely dark\"},{\"component\":\"black\",\"source\":\"a:00393873-a\",\"lemmas\":[\"black\"],\"definition\":\"being of the achromatic color of maximum darkness\"},{\"component\":\"black\",\"source\":\"n:09659490-n\",\"lemmas\":[\"black\",\"african american\",\"negro\",\"negroid\"],\"definition\":\"a person with African ancestry, ‘Negro’ and ‘Negroid’ are archaic and pejorative today\"}],\"targetSenseEvidence\":[{\"source\":\"n:04967759-n\",\"pos\":\"n\",\"lemmas\":[\"coal black\",\"ebony\",\"jet black\",\"pitch black\",\"sable\",\"soot black\"],\"definition\":\"a very dark black\",\"compatibleHeadSenseIds\":[\"n:04967454-n\"]},{\"source\":\"s:00274934-s\",\"pos\":\"s\",\"lemmas\":[\"black\",\"pitch black\",\"pitch dark\"],\"definition\":\"extremely dark\",\"compatibleHeadSenseIds\":[\"s:00274934-s\"]}],\"certainty\":\"llm\",\"certaintyScore\":0.65,\"verificationStatus\":\"rejected-llm\",\"deterministicChecks\":{\"sourceBoundary\":false,\"atomicComponents\":true,\"layerMetadata\":true,\"semanticHead\":true},\"reasons\":[\"closed-word segmentation has semantic uncertainty\",\"LLM selection is limited to this candidate\"],\"coverageStatus\":\"candidate-closed\",\"verificationAttempts\":1,\"verifier\":\"mind\",\"verificationRationale\":\"Modifier 'pitch' (throw) is metaphorical, violating literal composition requirement.\",\"verificationHeadKind\":\"lexical-head\",\"verificationSenseId\":\"n:04967759-n\",\"verificationHeadSenseId\":\"n:04967454-n\",\"verificationModifierSenseIds\":[\"v:01515257-v\"],\"verificationModifierEvidence\":[\"pitch as 'throw' does not literally modify black to mean very dark\"],\"verificationModifierRelations\":[\"metaphorical\"],\"verificationHeadRelation\":\"supported\",\"verificationEvidence\":\"{\\\"model\\\":\\\"qwen3.5:9b\\\",\\\"created_at\\\":\\\"2026-11-02T02:36:42.433833Z\\\",\\\"response\\\":\\\"{\\\\\\\"verdict\\\\\\\":\\\\\\\"reject\\\\\\\",\\\\\\\"candidateId\\\\\\\":\\\\\\\"derived-compound-f4