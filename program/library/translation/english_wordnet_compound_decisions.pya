su text "derived-compound-4efa276a24fd300797504262" ob text "{\"language\":\"canonical\",\"surface\":\"colour television\",\"target\":\"colour television\",\"sourceMorphemes\":[\"colour\",\"television\"],\"morphemes\":[\"colour\",\"television\"],\"componentGlosses\":[\"colour\",\"television\"],\"pyashSequence\":[\"hron\",\"twes\"],\"componentLayers\":[19,19],\"maxLayer\":19,\"head\":\"television\",\"modifiers\":[\"colour\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"ending-overlap-review\",\"morphologySignals\":[{\"ending\":\"ion\",\"kind\":\"derivational-ending\",\"component\":\"television\",\"boundary\":\"inside-component\",\"evidence\":\"English nominalizing ending\"}],\"sourceSurfaces\":{\"english\":\"colour television\"},\"sourceMorphemesByLanguage\":{\"english\":[\"colour\",\"television\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-4efa276a24fd300797504262\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"colour\",\"source\":\"n:04963771-n\",\"lemmas\":[\"color\",\"colour\",\"coloring\",\"colouring\"],\"definition\":\"a visual attribute of things that results from the light they emit or transmit or reflect\"},{\"component\":\"colour\",\"source\":\"v:00284671-v\",\"lemmas\":[\"color\",\"colorize\",\"colorise\",\"colourise\",\"colourize\",\"colour\",\"color in\",\"colour in\"],\"definition\":\"add color to\"},{\"component\":\"colour\",\"source\":\"a:00395196-a\",\"lemmas\":[\"color\",\"colour\"],\"definition\":\"having or capable of producing colors\"},{\"component\":\"colour\",\"source\":\"n:05200606-n\",\"lemmas\":[\"color\",\"colour\",\"vividness\"],\"definition\":\"interest and variety and intensity\"},{\"component\":\"television\",\"source\":\"n:04411547-n\",\"lemmas\":[