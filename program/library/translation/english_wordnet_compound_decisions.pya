su text "derived-compound-4ed26c302adddca14a974096" ob text "{\"language\":\"canonical\",\"surface\":\"civil authority\",\"target\":\"civil authority\",\"sourceMorphemes\":[\"civil\",\"authority\"],\"morphemes\":[\"civil\",\"authority\"],\"componentGlosses\":[\"civil\",\"authority\"],\"pyashSequence\":[\"swin\",\"cyik\"],\"componentLayers\":[16,16],\"maxLayer\":16,\"head\":\"authority\",\"modifiers\":[\"civil\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"ending-overlap-review\",\"morphologySignals\":[{\"ending\":\"ity\",\"kind\":\"derivational-ending\",\"component\":\"authority\",\"boundary\":\"inside-component\",\"evidence\":\"English nominalizing ending\"}],\"sourceSurfaces\":{\"english\":\"civil authority\"},\"sourceMorphemesByLanguage\":{\"english\":[\"civil\",\"authority\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-4ed26c302adddca14a974096\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"civil\",\"source\":\"s:01522244-s\",\"lemmas\":[\"civil\"],\"definition\":\"applying to ordinary citizens as contrasted with the military\"},{\"component\":\"civil\",\"source\":\"a:00645401-a\",\"lemmas\":[\"civil\",\"polite\"],\"definition\":\"not rude\"},{\"component\":\"civil\",\"source\":\"a:00645956-a\",\"lemmas\":[\"civil\"],\"definition\":\"(of divisions of time) legally recognized in ordinary affairs of life\"},{\"component\":\"civil\",\"source\":\"a:02707657-a\",\"lemmas\":[\"civil\",\"civic\"],\"definition\":\"of or relating to or befitting citizens as individuals\"},{\"component\":\"authority\",\"source\":\"n:09844011-n\",\"lemmas\":[\"authority\"],\"definition\":\"(usually plural) persons who exercise (administrative) control over others\"},{\"component\":\"authority\",\"source