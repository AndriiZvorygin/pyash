su text "derived-compound-06792e54b49b4c255e7f8cbb" ob text "{\"language\":\"canonical\",\"surface\":\"gall bladder\",\"target\":\"gall bladder\",\"sourceMorphemes\":[\"gall\",\"bladder\"],\"morphemes\":[\"gall\",\"bladder\"],\"componentGlosses\":[\"gall\",\"bladder\"],\"pyashSequence\":[\"hyo7t\",\"xwak\"],\"componentLayers\":[32,28],\"maxLayer\":32,\"head\":\"bladder\",\"modifiers\":[\"gall\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"ending-overlap-review\",\"morphologySignals\":[{\"ending\":\"er\",\"kind\":\"derivational-ending\",\"component\":\"bladder\",\"boundary\":\"inside-component\",\"evidence\":\"English comparative or agentive ending\"},{\"ending\":\"er\",\"kind\":\"derivational-ending\",\"component\":\"bladder\",\"boundary\":\"inside-component\",\"evidence\":\"explicit Pyash affix marker in vocabulary row 6051\"}],\"sourceSurfaces\":{\"english\":\"gall bladder\"},\"sourceMorphemesByLanguage\":{\"english\":[\"gall\",\"bladder\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-06792e54b49b4c255e7f8cbb\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":1,\"componentSenseEvidence\":[{\"component\":\"gall\",\"source\":\"n:07564444-n\",\"lemmas\":[\"resentment\",\"bitterness\",\"gall\",\"rancor\",\"rancour\"],\"definition\":\"a feeling of deep and bitter anger and ill-will\"},{\"component\":\"gall\",\"source\":\"n:04923043-n\",\"lemmas\":[\"crust\",\"gall\",\"impertinence\",\"impudence\",\"insolence\",\"cheekiness\",\"freshness\"],\"definition\":\"the trait of being rude and impertinent\"},{\"component\":\"gall\",\"source\":\"v:02124124-v\",\"lemmas\":[\"chafe\",\"gall\",\"fret\"],\"definition\":\"become or make sore by or as if by rubbing\"},{\"component\":\"gall\",\"source\":\"n:05413913-n\",\"lemmas\":[\"bile\",\"gall\"]