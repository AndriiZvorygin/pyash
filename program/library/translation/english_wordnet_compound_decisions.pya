su text "derived-compound-7513de2f4b8afe948b319d87" ob text "{\"language\":\"canonical\",\"surface\":\"conditional reaction\",\"target\":\"conditional reaction\",\"sourceMorphemes\":[\"conditional\",\"reaction\"],\"morphemes\":[\"conditional\",\"reaction\"],\"componentGlosses\":[\"conditional\",\"reaction\"],\"pyashSequence\":[\"gyot\",\"ryak\"],\"componentLayers\":[24,19],\"maxLayer\":24,\"head\":\"reaction\",\"modifiers\":[\"conditional\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"ending-overlap-review\",\"morphologySignals\":[{\"ending\":\"ion\",\"kind\":\"derivational-ending\",\"component\":\"reaction\",\"boundary\":\"inside-component\",\"evidence\":\"English nominalizing ending\"}],\"sourceSurfaces\":{\"english\":\"conditional reaction\"},\"sourceMorphemesByLanguage\":{\"english\":[\"conditional\",\"reaction\"]},\"confidence\":\"wordnet-lexical-boundary\",\"status\":\"accepted-llm\",\"evidence\":\"Open English WordNet multiword lemma boundary; semantic composition requires review\",\"provenance\":\"Open English WordNet multiword lemma\",\"id\":\"derived-compound-7513de2f4b8afe948b319d87\",\"frequencyRank\":9007199254740991,\"frequencyTagCount\":7,\"componentSenseEvidence\":[{\"component\":\"conditional\",\"source\":\"s:01919794-s\",\"lemmas\":[\"conditional\"],\"definition\":\"qualified by reservations\"},{\"component\":\"conditional\",\"source\":\"a:00557545-a\",\"lemmas\":[\"conditional\"],\"definition\":\"imposing or depending on or containing a condition\"},{\"component\":\"reaction\",\"source\":\"n:00860679-n\",\"lemmas\":[\"reaction\",\"response\"],\"definition\":\"a bodily process occurring due to the effect of some antecedent stimulus or agent\"},{\"component\":\"reaction\",\"source\":\"n:13468534-n\",\"lemmas\":[\"chemical reaction\",\"reaction\"],\"definition\":\"(chemistry) a process in which one or more substances are changed into others\"},{\"component\":\"reaction\",\"source\":\"n:05925922-n\",\"lemmas\":[\"reaction\"],\"de