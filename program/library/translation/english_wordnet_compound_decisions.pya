su text "derived-compound-5fffccd629d20baf17c93dee" ob text "{\"language\":\"canonical\",\"surface\":\"nightwear\",\"target\":\"nightwear\",\"sourceMorphemes\":[\"night\",\"wear\"],\"morphemes\":[\"night\",\"wear\"],\"componentGlosses\":[\"night\",\"wear\"],\"pyashSequence\":[\"hyam\",\"hban\"],\"componentLayers\":[16,24],\"maxLayer\":24,\"head\":\"wear\",\"modifiers\":[\"night\"],\"componentRoles\":[\"lexeme\",\"lexeme\"],\"morphologyStatus\":\"lexical-compound\",\"morphologySignals\":[],\"sourceSurfaces\":{\"chinese\":\"睡衣\",\"french\":\"vêtement de nuit\",\"hindi\":\"रात\",\"russian\":\"ночное белье\"},\"sourceMorphemesByLanguage\":{\"chinese\":[\"睡衣\"],\"french\":[\"vêtement\",\"de\",\"nuit\"],\"hindi\":[\"रात\"],\"russian\":[\"ночное\",\"белье\"]},\"confidence\":\"orthographic-candidate\",\"status\":\"accepted-llm\",\"evidence\":\"closed-word segmentation requires semantic review\",\"provenance\":\"caterer/pyac/lyac/dictionary_fr.json; caterer/pyac/lyac/dictionary_hi.json; caterer/pyac/lyac/dictionary_ru.json; caterer/pyac/lyac/dictionary_zh.json\",\"id\":\"derived-compound-5fffccd629d20baf17c93dee\",\"componentSenseEvidence\":[{\"component\":\"night\",\"source\":\"n:15192074-n\",\"lemmas\":[\"night\",\"nighttime\",\"dark\"],\"definition\":\"the time after sunset and before sunrise while it is dark outside\"},{\"component\":\"night\",\"source\":\"n:14007202-n\",\"lemmas\":[\"night\"],\"definition\":\"darkness\"},{\"component\":\"night\",\"source\":\"n:15180707-n\",\"lemmas\":[\"night\"],\"definition\":\"the dark part of the diurnal cycle considered a time unit\"},{\"component\":\"night\",\"source\":\"n:15192521-n\",\"lemmas\":[\"night\"],\"definition\":\"the period spent sleeping\"},{\"component\":\"wear\",\"source\":\"n:03055525-n\",\"lemmas\":[\"clothing\",\"article of clothing\",\"vesture\",\"wear\",\"wearable\",\"habiliment\"],\"definition\":\"a covering designed to be worn on a person's body\"},{\"component\":\"wear\",\"source\":\"v:00052091-v\",\"lemmas\"