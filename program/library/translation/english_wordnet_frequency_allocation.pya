su name allotment be map def
su text "format" ob text "english-wordnet-frequency-allocation-v1" ya
su text "primary-order" ob text "English30k rank ascending" ya
su text "tie-break" ob text "exact WordNet 3.1 tag count descending when English30k ranks tie" ya
su text "exact-key-required" ob text "true" ya
su text "one-target-per-sense" ob text "true" ya
su text "one-sense-per-target" ob text "true" ya
su text "alias-target-policy" ob text "dictionary aliases are eligible only when their canonical target is an atomic or accepted compound anchor with the identical Pyash sequence; grammatical targets remain residual" ya
su text "unresolved-ties" ob text "compound-worklist" ya
su text "preserve-existing" ob text "curated and deterministic links" ya
su text "model-link-reconciliation" ob text "retain only when the frequency allocation selects the same Pyac identity" ya
su text "atom-coverage-format" ob text "english-wordnet-atom-coverage-v1" ya
su text "atom-coverage-scope" ob text "every distinct Pyac identity in pyashWords" ya
su text "atom-coverage-batch-size" ob num 500 ya
su text "atom-unlinked-policy" ob text "preserve candidate senses and explicit coverage status; defer unsupported links to a later sense-candidate stage" ya
su text "allocation-batch-size" ob num 1000 ya
su text "maximum-compound-components" ob num 2 ya
su text "compound-candidate-source" ob text "english30k-closed-wordnet-multiword-existing-atoms-v1" ya
su text "compound-candidate-order" ob text "english30k-rank-ascending-princeton-tag-count-descending" ya
su text "compound-verification-batch-size" ob num 64 ya
su text "compound-verification-parallelism" ob num 8 ya
su text "compound-verification-revision" ob text "wordnet-two-component-literalness-v11" ya
su text "compound-head-relation-policy" ob text "advisory" ya
prah
