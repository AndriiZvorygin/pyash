su text "your" ob text "{\"surface\":\"your\",\"kind\":\"possessive-determiner\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"lwonprom person-deixis grammar particle you_ is sa; possessive_marker_ is ye. The lexical you root remains hnan for compound words.\"}" ya
su text "thy" ob text "{\"surface\":\"thy\",\"kind\":\"possessive-determiner\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"English archaic possessive determiner thy follows the you_ plus possessive_marker_ construction.\"}" ya
su text "thine" ob text "{\"surface\":\"thine\",\"kind\":\"possessive-pronoun\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"standalone\",\"evidence\":\"English archaic possessive pronoun thine follows the you_ plus possessive_marker_ construction.\"}" ya
su text "my" ob text "{\"surface\":\"my\",\"kind\":\"possessive-determiner\",\"components\":[\"me_\",\"possessive_marker_\"],\"pyashSequence\":[\"mi\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"lwonprom person-deixis grammar particle me_ is mi; possessive_marker_ is ye. The lexical me root remains hman for compound words.\"}" ya
su text "ours" ob text "{\"surface\":\"ours\",\"kind\":\"possessive-pronoun\",\"components\":[\"us_\",\"possessive_marker_\"],\"pyashSequence\":[\"nyah\",\"ye\"],\"position\":\"prefix\",\"evidence\":\"same grammar construction as our: us_ is nyah followed by possessive_marker_ ye; lexical us remains hwam for compound words.\"}" ya
su text "yours" ob text "{\"surface\":\"yours\",\"kind\":\"possessive-pronoun\",\"components\":[\"you_\",\"possessive_marker_\"],\"pyashSequence\":[\"sa\",\"ye\"],\"position\":\"standalone\",\"evidence\":\"same grammar construction as your: you_ is sa followed by possessive_marker_ ye; lexical you root remains hnan for compound words.\"}" ya
su text "and" ob text "{\"surface\":\"and\",\"kind\":\"conjunction\",\"components\":[\"and_\"],\"pyashSequence\":[\"wa\"],\"position\":\"link\",\"evidence\":\"lwonprom conjunction grammar particle and_ is wa; lexical and root remains hwan for compound words.\"}" ya
su text "also" ob text "{\"surface\":\"also\",\"kind\":\"conjunction\",\"components\":[\"also_\"],\"pyashSequence\":[\"pcah\"],\"position\":\"link\",\"evidence\":\"lwonprom conjunction grammar particle also_ is pcah; lexical also root remains hyac for compound words.\"}" ya
su text "there are" ob text "{\"surface\":\"there are\",\"kind\":\"existential-clause\",\"components\":[\"existential_clause_\"],\"pyashSequence\":[\"syi7h\"],\"position\":\"suffix\",\"evidence\":\"English there are lowers to the existential sentence mood syi7h, which closes the sentence.\"}" ya
su text "there is" ob text "{\"surface\":\"there is\",\"kind\":\"existential-clause\",\"components\":[\"existential_clause_\"],\"pyashSequence\":[\"syi7h\"],\"position\":\"suffix\",\"evidence\":\"English there is lowers to the existential sentence mood syi7h, which closes the sentence.\"}" ya
su text "there exists" ob text "{\"surface\":\"there exists\",\"kind\":\"existential-clause\",\"components\":[\"existential_clause_\"],\"pyashSequence\":[\"syi7h\"],\"position\":\"suffix\",\"evidence\":\"English there exists lowers to the existential sentence mood syi7h, which closes the sentence.\"}" ya
su text "there can be" ob text "{\"surface\":\"there can be\",\"kind\":\"existential-clause\",\"components\":[\"potential_mood_\",\"existential_clause_\"],\"pyashSequence\":[\"tseh\",\"syi7h\"],\"position\":\"suffix\",\"evidence\":\"English there can be composes potential_mood_ tseh with existential_clause_ syi7h; the existential marker remains final.\"}" ya
su text "there could be" ob text "{\"surface\":\"there could be\",\"kind\":\"existential-clause\",\"components\":[\"potential_mood_\",\"existential_clause_\"],\"pyashSequence\":[\"tseh\",\"syi7h\"],\"position\":\"suffix\",\"evidence\":\"English there could be composes potential_mood_ tseh with existential_clause_ syi7h; the existential marker remains final.\"}" ya
su text "self" ob text "{\"surface\":\"self\",\"kind\":\"reflexive-marker\",\"components\":[\"reflexive_voice_\"],\"pyashSequence\":[\"fyoh\"],\"position\":\"compound-only\",\"evidence\":\"English self- compounds use reflexive_voice_ fyoh as a compact lexicalized form. A shared-head list expands self-X into the nominal self target plus its grammatical case.\"}" ya
su text "self target" ob text "{\"surface\":\"self target\",\"kind\":\"pronoun\",\"components\":[\"reflexive_voice\"],\"pyashSequence\":[\"fyif\"],\"position\":\"standalone\",\"evidence\":\"The nominal self target uses reflexive_voice root fyif; the separate reflexive_voice_ suffix fyoh marks verbal voice.\"}" ya
su text "can" ob text "{\"surface\":\"can\",\"kind\":\"modal-mood\",\"components\":[\"potential_mood_\"],\"pyashSequence\":[\"tseh\"],\"position\":\"suffix\",\"evidence\":\"English can expresses the potential mood; potential_mood_ is tseh.\"}" ya
su text "could" ob text "{\"surface\":\"could\",\"kind\":\"modal-mood\",\"components\":[\"potential_mood_\"],\"pyashSequence\":[\"tseh\"],\"position\":\"suffix\",\"evidence\":\"English could expresses the potential mood; potential_mood_ is tseh.\"}" ya
su text "often" ob text "{\"surface\":\"often\",\"kind\":\"aspect-marker\",\"components\":[\"frequentative_aspect_\"],\"pyashSequence\":[\"ra2\"],\"position\":\"verb-aspect\",\"evidence\":\"English often marks repeated occurrence; Pyac frequentative_aspect_ ra2 expresses a repetitive process.\"}" ya
su text "frequently" ob text "{\"surface\":\"frequently\",\"kind\":\"aspect-marker\",\"components\":[\"frequentative_aspect_\"],\"pyashSequence\":[\"ra2\"],\"position\":\"verb-aspect\",\"evidence\":\"English frequently marks repeated occurrence; Pyac frequentative_aspect_ ra2 expresses a repetitive process.\"}" ya
su text "may" ob text "{\"surface\":\"may\",\"kind\":\"modal-mood\",\"components\":[\"permissive_mood_\"],\"pyashSequence\":[\"mwih\"],\"position\":\"suffix\",\"evidence\":\"English may uses the permissive mood marker mwih; the sentence context distinguishes permission from the month or shrub senses.\"}" ya
su text "but" ob text "{\"surface\":\"but\",\"kind\":\"conjunction\",\"components\":[\"but_\"],\"pyashSequence\":[\"pyuh\"],\"position\":\"link\",\"evidence\":\"lwonprom conjunction grammar particle but_ is pyuh; lexical but root remains hlan for compound words.\"}" ya
su text "not" ob text "{\"surface\":\"not\",\"kind\":\"negation\",\"components\":[\"negatory_quantifier_\"],\"pyashSequence\":[\"no\"],\"position\":\"prefix\",\"evidence\":\"lwonprom negatory quantifier grammar particle negatory_quantifier_ is no.\"}" ya
su text "never" ob text "{\"surface\":\"never\",\"kind\":\"negation\",\"components\":[\"negatory_quantifier_\"],\"pyashSequence\":[\"no\"],\"position\":\"prefix\",\"evidence\":\"English negative adverb never lowers to the negatory quantifier particle no for this sentence layer.\"}" ya
su text "plural" ob text "{\"surface\":\"plural\",\"kind\":\"number-marker\",\"components\":[\"plural_number_\"],\"pyashSequence\":[\"pu\"],\"position\":\"suffix\",\"evidence\":\"lwonprom noun phrase grammar uses plural-number as the noun suffix; current grammar marker is pu\"}" ya
