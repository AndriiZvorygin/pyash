su text "these" ob text "{\"surface\":\"these\",\"kind\":\"pronoun\",\"components\":[\"demonstrative_\",\"plural_number_\"],\"pyashSequence\":[\"tsah\",\"pu\"],\"position\":\"standalone\",\"evidence\":\"English proximal demonstrative these composes demonstrative_ tsah with plural-number pu\"}" ya
su text "those" ob text "{\"surface\":\"those\",\"kind\":\"pronoun\",\"components\":[\"distal_demonstrative_\",\"plural_number_\"],\"pyashSequence\":[\"tsuh\",\"pu\"],\"position\":\"standalone\",\"evidence\":\"English distal demonstrative those composes distal_demonstrative_ tsuh with plural-number pu\"}" ya
