su text "another" ob text "{\"surface\":\"another\",\"kind\":\"pronoun\",\"components\":[\"other_\",\"assertive_quantifier_\"],\"pyashSequence\":[\"clah\",\"tlih\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes other_ clah with assertive_quantifier_ tlih for one other item\"}" ya
su text "chinese-character-link:d50339b018a7" ob text "{\"character\":\"之\",\"targetId\":\"grammar:it_:ya\",\"pya\":\"ya\",\"components\":[\"it_\"],\"english\":\"it\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD Chinese-GSDSimp data shows '之' tagged as PART (pronoun) in contexts like '學而時習之' (learn and practice it), directly supporting the grammatical target 'it'. The Unihan definition explicitly lists 'it, him her, them', and CC-CEDICT defines a literary equivalent for possessive/objective usage. No\"}" ya
su text "chinese-character-link:d69c28b0e4db" ob text "{\"character\":\"也\",\"targetId\":\"grammar:also_:pcah\",\"pya\":\"pcah\",\"components\":[\"also_\"],\"english\":\"also\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '也' is attested in Classical Chinese (Analects) and modern usage (UD Chinese-GSDSimp) as a particle indicating affirmation or addition ('also', 'too'). The UD data explicitly tags it as SCONJ with the semantic value of 'also'. This directly matches the supplied target 'grammar:also_:p'\"}" ya
su text "chinese-character-link:5a19b28210d0" ob text "{\"character\":\"而\",\"targetId\":\"grammar:and_:wa\",\"pya\":\"wa\",\"components\":[\"and_\"],\"english\":\"and\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '而' is attested with the meaning 'and' in multiple Classical sources (Analects contexts like '學而時習之') and modern UD data (SCONJ). This aligns directly with the target 'grammar:and_:wa' which represents the conjunction 'and'. The evidence supports a specific grammatical function rather呢\"}" ya
su text "chinese-character-link:020f4a37ac6d" ob text "{\"character\":\"而\",\"targetId\":\"grammar:but_:pyuh\",\"pya\":\"pyuh\",\"components\":[\"but_\"],\"english\":\"but\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '而' is explicitly defined in CC-CEDICT and Unihan with the sense 'but (not)', and UD data shows usage as a contrastive conjunction. This matches the target 'grammar:but_:pyuh' representing 'but'. The evidence supports this specific grammatical function.\"}" ya
su text "chinese-character-link:f9a890627280" ob text "{\"character\":\"於\",\"targetId\":\"grammar:perlative_case_:lwah\",\"pya\":\"lwah\",\"components\":[\"perlative_case_\"],\"english\":\"within\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\"],\"rationale\":\"The character '於' is attested in the Analects with definitions including 'in', 'at', 'on', and 'within'. The target 'grammar:perlative_case_:lwah' covers these spatial prepositions (within, in, on, under, inside). Contexts like '至於是邦也' (arrived at this state) and general locative usage support the '\"}" ya
su text "chinese-character-link:ebe004cda34f" ob text "{\"character\":\"吾\",\"targetId\":\"grammar:me_:mi\",\"pya\":\"mi\",\"components\":[\"me_\"],\"english\":\"i\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\"],\"rationale\":\"The character '吾' is attested in multiple Classical Chinese sources (Analects Legge and Wen Yen) with the specific grammatical function of a first-person singular pronoun ('I', 'my'). The provided Pyash target 'grammar:me_:mi' corresponds exactly to this meaning. The evidence supports a direct, unid\"}" ya
su text "chinese-character-link:471ef6186e17" ob text "{\"character\":\"且\",\"targetId\":\"grammar:and_:wa\",\"pya\":\"wa\",\"components\":[\"and_\"],\"english\":\"and\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '且' is attested in Classical Chinese contexts (Analects) with the meaning 'and' or 'moreover' (e.g., '有恥且格', '富且貴'). The UD Chinese-GSDSimp data explicitly tags '且' as CCONJ (coordinating conjunction) in modern examples, aligning with the target definition 'and'. The evidence supports\"}" ya
su text "chinese-character-link:146f1363b547" ob text "{\"character\":\"于\",\"targetId\":\"grammar:destination_case_:ma\",\"pya\":\"ma\",\"components\":[\"destination_case_\"],\"english\":\"to\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '于' is attested in Classical Chinese contexts (Analects) and modern UD data as a preposition indicating direction or goal (e.g., '志于學' - determined on learning, '浮于海' - float to the sea). This aligns directly with the target meaning 'to'. The relation is 'same-sense' as the core gramm义\"}" ya
su text "chinese-character-link:70a22f52b341" ob text "{\"character\":\"于\",\"targetId\":\"grammar:source_case_:so\",\"pya\":\"so\",\"components\":[\"source_case_\"],\"english\":\"from\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '于' is used in contexts indicating origin or source (e.g., '禱爾于上下神祗' - pray to/from the gods above and below, '分布于...海域' - distributed in/within regions). This aligns with the target meaning 'from'. The relation is 'same-sense'.\"}" ya
su text "chinese-character-link:b9fc47b1afe0" ob text "{\"character\":\"于\",\"targetId\":\"grammar:way_case_:ga\",\"pya\":\"ga\",\"components\":[\"way_case_\"],\"english\":\"at\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '于' functions as a locative preposition indicating location (e.g., '栖息于森林' - inhabit in the forest, '施於有政' - apply to politics). This aligns with the target meaning 'at'. The relation is 'same-sense'.\"}" ya
su text "chinese-character-link:3010c15cfa66" ob text "{\"character\":\"于\",\"targetId\":\"grammar:agentive_case_:je\",\"pya\":\"je\",\"components\":[\"agentive_case_\"],\"english\":\"by\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '于' is used to introduce an agent or means (e.g., '友于兄弟' - friendly towards/between brothers, often implying the relationship/agent of the action). While less frequent than locative uses in this specific dataset, the UD tag ADP covers general prepositional functions including agentive.\"}" ya
su text "chinese-character-link:a56722710e0a" ob text "{\"character\":\"为\",\"targetId\":\"grammar:benefactive_case_:pwah\",\"pya\":\"pwah\",\"components\":[\"benefactive_case_\"],\"english\":\"for\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD tag 'ADP' in the context '以发为冢' (take hair as a tomb) and general usage aligns with the benefactive/for sense ('to', 'for') found in CC-CEDICT definitions. The target 'grammar:benefactive_case_:pwah' corresponds to English 'for'. Although UD often tags this as ADP, the semantic mapping to 'to\"}" ya
su text "chinese-character-link:101e657c200a" ob text "{\"character\":\"则\",\"targetId\":\"grammar:but_:pyuh\",\"pya\":\"pyuh\",\"components\":[\"but_\"],\"english\":\"but\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '则' is attested in multiple UD Chinese-GSDSimp contexts (112 instances) tagged as SCONJ. The provided CC-CEDICT definition explicitly lists '(conjunction used to express contrast with a previous clause) but' as a sense for 'ze2'. This aligns directly with the supplied target 'grammar:但\"}" ya
su text "chinese-character-link:efee0d0601a0" ob text "{\"character\":\"和\",\"targetId\":\"grammar:and_:wa\",\"pya\":\"wa\",\"components\":[\"and_\"],\"english\":\"and\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD Chinese-GSDSimp data explicitly tags '和' as CCONJ (conjunction) in contexts listing items or clauses (e.g., 'Paris... and imagination', 'cancer... and Alzheimer's'), directly supporting the grammatical function of 'and'. This aligns with the target 'grammar:and_:wa'.\"}" ya
su text "chinese-character-link:23b4819ca42c" ob text "{\"character\":\"和\",\"targetId\":\"grammar:comitative_case_:mwah\",\"pya\":\"mwah\",\"components\":[\"comitative_case_\"],\"english\":\"with\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD Chinese-GSDSimp data tags '和' as ADP (adposition) in contexts indicating accompaniment or association (e.g., 'Shanghai and Caojiadu', 'Roy and Ceron'), supporting the grammatical function of 'with'. This aligns with the target 'grammar:comitative_case_:mwah'.\"}" ya
su text "chinese-character-link:d619584f0e87" ob text "{\"character\":\"与\",\"targetId\":\"grammar:and_:wa\",\"pya\":\"wa\",\"components\":[\"and_\"],\"english\":\"and\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '与' is attested in UD Chinese-GSDSimp with POS tags ADP (preposition) and CCONJ (coordinating conjunction). The definitions provided ('and', 'together with') align directly with the target meaning 'and'. The usage examples show '与' functioning as a preposition introducing an object (e-\"}" ya
su text "chinese-character-link:d880e4da2cc0" ob text "{\"character\":\"这\",\"targetId\":\"grammar:demonstrative_:tsah\",\"pya\":\"tsah\",\"components\":[\"demonstrative_\"],\"english\":\"this\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '这' is attested in UD Chinese-GSDSimp with the POS tag 'DET' (determiner) and 'PRON' (pronoun), functioning as a demonstrative meaning 'this' or 'these'. This directly supports the supplied target 'grammar:demonstrative_:tsah' (English: 'this'). The evidence is consistent across 393 UD\"}" ya
su text "chinese-character-link:e3c888110a58" ob text "{\"character\":\"中\",\"targetId\":\"grammar:perlative_case_:lwah\",\"pya\":\"lwah\",\"components\":[\"perlative_case_\"],\"english\":\"within\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD Chinese-GSDSimp data shows '中' tagged as ADP (Adposition) in contexts like '昏迷中的婆婆' (in the coma), '其他许多鸟类中' (among other birds), and '摄影技术中' (in photography). These correspond directly to the target meaning 'within/inside/among'. The classical attestations ('在縲絏之中', '祿在其中') also support this\"}" ya
su text "chinese-character-link:3887ce462d21" ob text "{\"character\":\"中\",\"targetId\":\"grammar:temporal_case_:myah\",\"pya\":\"myah\",\"components\":[\"temporal_case_\"],\"english\":\"during\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The CC-CEDICT definitions explicitly list 'during' as a meaning for '中'. While the provided UD contexts are spatial, the lexical definition supports the grammatical function of marking time intervals (e.g., '在...中'), which maps to the target 'during'.\"}" ya
su text "chinese-character-link:cbe90832fa60" ob text "{\"character\":\"中\",\"targetId\":\"grammar:associative_case_:sa7\",\"pya\":\"sa7\",\"components\":[\"associative_case_\"],\"english\":\"among\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD context '其他许多鸟类中' translates to 'among other many bird species', and CC-CEDICT lists 'among' as a definition. This supports the associative case target.\"}" ya
su text "chinese-character-link:a16f723839f5" ob text "{\"character\":\"并\",\"targetId\":\"grammar:and_:wa\",\"pya\":\"wa\",\"components\":[\"and_\"],\"english\":\"and\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD Chinese-GSDSimp data shows '并' used as a conjunction (SCONJ) in contexts like '该专辑并在 2007 年...' and '...兴奋不已，并决定...', which corresponds to the English meaning 'and'. This aligns with the target 'grammar:and_:wa'.\"}" ya
su text "chinese-character-link:e670d5d4499d" ob text "{\"character\":\"并\",\"targetId\":\"grammar:also_:pcah\",\"pya\":\"pcah\",\"components\":[\"also_\"],\"english\":\"also\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD Chinese-GSDSimp data includes contexts where '并' functions as an additive conjunction meaning 'also' or 'furthermore' (e.g., implied in the additive nature of SCONJ usage alongside other conjunctions, and supported by CC-CEDICT definitions including 'also', 'furthermore'). This aligns with 'p\"}" ya
su text "chinese-character-link:24cdbe1335a3" ob text "{\"character\":\"后\",\"targetId\":\"grammar:terminative_case_:tweh\",\"pya\":\"tweh\",\"components\":[\"terminative_case_\"],\"english\":\"until\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD Chinese-GSDSimp data provides multiple attested instances (240 counts) where the character '后' functions as a preposition (ADP) indicating a temporal endpoint or subsequent state (e.g., 'after', 'later'). This aligns directly with the supplied target meaning 'until/after'. The classical and U\"}" ya
su text "chinese-character-link:9cc71243738e" ob text "{\"character\":\"及\",\"targetId\":\"grammar:and_:wa\",\"pya\":\"wa\",\"components\":[\"and_\"],\"english\":\"and\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD Chinese-GSDSimp data explicitly tags '及' as CCONJ (coordinating conjunction) in contexts like '和欧洲及世界各地', where it functions exactly as the English 'and'. This aligns perfectly with the existing target 'grammar:and_:wa' defined as 'and'. The classical attestations ('非爾所及也', '其愚不可及也') support,\"}" ya
su text "chinese-character-link:84c76c2d213c" ob text "{\"character\":\"但\",\"targetId\":\"grammar:but_:pyuh\",\"pya\":\"pyuh\",\"components\":[\"but_\"],\"english\":\"but\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '但' is attested in multiple UD Chinese-GSDSimp contexts with the POS tag SCONJ, consistently translating to the adversative conjunction 'but'. This aligns directly with the supplied target 'grammar:but_:pyuh' (english: 'but'). The evidence supports a specific grammatical function (conj\"}" ya
su text "chinese-character-link:bd1ef342ced5" ob text "{\"character\":\"不\",\"targetId\":\"grammar:negatory_quantifier_:no\",\"pya\":\"no\",\"components\":[\"negatory_quantifier_\"],\"english\":\"not\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '不' functions as a negative adverb (ADV) in the provided UD Chinese-GSDSimp contexts, consistently translating to 'not' or 'no'. This aligns perfectly with the supplied target 'grammar:negatory_quantifier_:no' which has the English definition 'not' and aliases including 'never' and 'no\"}" ya
su text "chinese-character-link:4e9212999839" ob text "{\"character\":\"对\",\"targetId\":\"grammar:way_case_:ga\",\"pya\":\"ga\",\"components\":[\"way_case_\"],\"english\":\"at\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD tag 'ADP' in contexts like '对...造成破坏' (causing destruction to...) and '对巴黎...兴奋不已' (excited about Paris...) aligns with the target meaning 'at' or 'towards', representing a directional or locative case marker.\"}" ya
su text "chinese-character-link:8963715e9af9" ob text "{\"character\":\"对\",\"targetId\":\"grammar:destination_case_:ma\",\"pya\":\"ma\",\"components\":[\"destination_case_\"],\"english\":\"to\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"In contexts such as '对广大的观众交代' (account to the audience) and '对君主的制约作用' (constraint on the monarch), the character functions as a preposition indicating direction or target, matching the target meaning 'to/towards'.\"}" ya
su text "chinese-character-link:d4921921080c" ob text "{\"character\":\"对\",\"targetId\":\"grammar:benefactive_case_:pwah\",\"pya\":\"pwah\",\"components\":[\"benefactive_case_\"],\"english\":\"for\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The usage in '对...交代' (account to...) and similar constructions where the action is directed towards a beneficiary or recipient aligns with the target meaning 'for', functioning as a benefactive marker.\"}" ya
su text "chinese-character-link:2affab2295ee" ob text "{\"character\":\"此\",\"targetId\":\"grammar:demonstrative_:tsah\",\"pya\":\"tsah\",\"components\":[\"demonstrative_\"],\"english\":\"this\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '此' is attested in UD Chinese-GSDSimp with POS tags PRON (129 instances) and DET (65 instances), both corresponding to the demonstrative meaning 'this/these'. The provided Pyash target 'grammar:demonstrative_:tsah' explicitly defines the sense 'this'. The evidence directly supports a 1\"}" ya
su text "chinese-character-link:cf0ebe9c50f0" ob text "{\"character\":\"或\",\"targetId\":\"grammar:and_or_:ba\",\"pya\":\"ba\",\"components\":[\"and_or_\"],\"english\":\"or\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '或' is attested in Classical Chinese (Analects) and Modern Chinese (UD treebank) with the grammatical function of a disjunctive conjunction meaning 'or'. The UD data explicitly tags instances as CCONJ, and the CC-CEDICT/Unihan definitions confirm the sense 'or'. This directly maps to '\"}" ya
su text "chinese-character-link:5eb7a3a770e2" ob text "{\"character\":\"都\",\"targetId\":\"grammar:universal_quantifier_:wi\",\"pya\":\"wi\",\"components\":[\"universal_quantifier_\"],\"english\":\"all\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '都' is attested in multiple UD Chinese-GSDSimp contexts with the POS tag SCONJ (151 instances), functioning as a universal quantifier meaning 'all' or 'both'. This directly aligns with the supplied target 'grammar:universal_quantifier_:wi' defined as 'all'. The usage is specific and un\"}" ya
