su text "chinese-character-link:b851ef802002" ob text "{\"character\":\"全\",\"targetId\":\"grammar:universal_quantifier_:wi\",\"pya\":\"wi\",\"components\":[\"universal_quantifier_\"],\"english\":\"all\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '全' is attested in UD Chinese-GSDSimp contexts functioning as a Determiner (DET) meaning 'all' or 'entire' (e.g., '全 115 集', '风靡全台湾'). This directly supports the supplied grammatical target 'universal_quantifier_' with the English gloss 'all'. The usage is consistent across multiple例句,\"}" ya
su text "chinese-character-link:0ab21b853ef4" ob text "{\"character\":\"间\",\"targetId\":\"grammar:associative_case_:sa7\",\"pya\":\"sa7\",\"components\":[\"associative_case_\"],\"english\":\"among\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '间' is attested in multiple UD Chinese-GSDSimp contexts as an Adposition (ADP) indicating spatial or temporal association (e.g., 'between', 'among', 'during'). This directly supports the grammatical target 'among' (associative_case_), which corresponds to the base sense of the preposit\"}" ya
su text "chinese-character-link:06236267202c" ob text "{\"character\":\"常\",\"targetId\":\"grammar:frequentative_aspect_:ra2\",\"pya\":\"ra2\",\"components\":[\"frequentative_aspect_\"],\"english\":\"often\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '常' is attested in multiple independent sources (Analects, UD Chinese-GSDSimp) with the meaning 'often/frequently'. The UD data explicitly tags instances as 'ADV' (adverbial frequency), and the CC-CEDICT definition includes 'often, ever, frequently', directly supporting the supplied Py\"}" ya
su text "chinese-character-link:61638d6c4c63" ob text "{\"character\":\"你\",\"targetId\":\"grammar:you_:sa\",\"pya\":\"sa\",\"components\":[\"you_\"],\"english\":\"you\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '你' is attested as a second-person pronoun (PRON) in the UD Chinese-GSDSimp corpus with the definition 'you'. This directly matches the supplied target 'grammar:you_:sa' which defines the grammatical sense 'you'. The usage is standard and informal, aligning perfectly with the target's\"}" ya
