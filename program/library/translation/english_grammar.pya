su text "another" ob text "{\"surface\":\"another\",\"kind\":\"pronoun\",\"components\":[\"other_\",\"assertive_quantifier_\"],\"pyashSequence\":[\"clah\",\"tlih\"],\"position\":\"standalone\",\"evidence\":\"lwonprom noun grammar composes other_ clah with assertive_quantifier_ tlih for one other item\"}" ya
su text "chinese-character-link:bd1ef342ced5" ob text "{\"character\":\"不\",\"targetId\":\"grammar:negatory_quantifier_:no\",\"pya\":\"no\",\"components\":[\"negatory_quantifier_\"],\"english\":\"not\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '不' functions as a negative adverb (ADV) in the provided UD Chinese-GSDSimp contexts, directly corresponding to the Pyash target 'no' (negatory_quantifier_). The attestation frequency from UD data is 201, and classical sources (Analects) provide extensive support for this negation use.\"}" ya
su text "chinese-character-link:efee0d0601a0" ob text "{\"character\":\"和\",\"targetId\":\"grammar:and_:wa\",\"pya\":\"wa\",\"components\":[\"and_\"],\"english\":\"and\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '和' is attested as a conjunction meaning 'and' in the UD Chinese-GSDSimp corpus (769 instances, CCONJ tag) and explicitly defined in CC-CEDICT with pinyin 'he2' for 'and'. This aligns directly with the target 'grammar:and_:wa'.\"}" ya
su text "chinese-character-link:8cc679a57cf7" ob text "{\"character\":\"当\",\"targetId\":\"grammar:temporal_case_:myah\",\"pya\":\"myah\",\"components\":[\"temporal_case_\"],\"english\":\"during\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '当' is attested in UD Chinese-GSDSimp contexts exclusively as an ADP (Adposition) with the meaning 'when' or 'during'. This aligns perfectly with the existing target 'grammar:temporal_case_:myah' defined as 'during'. The frequency count of 47 supports this grammatical usage, and no Lex\"}" ya
su text "chinese-character-link:a56722710e0a" ob text "{\"character\":\"为\",\"targetId\":\"grammar:benefactive_case_:pwah\",\"pya\":\"pwah\",\"components\":[\"benefactive_case_\"],\"english\":\"for\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The UD Chinese-GSDSimp data shows '为' used as an ADP (Adposition) with the gloss 'for' in contexts like '嘱咐若不幸战死，以发为冢' (entrusted that if he died... take hair as a tomb, implying 'for' or 'on behalf of'). This aligns directly with the target 'grammar:benefactive_case_:pwah' (English: 'for'). The raw\"}" ya
su text "chinese-character-link:68c1284935cc" ob text "{\"character\":\"之\",\"targetId\":\"grammar:possessive_marker_:ye\",\"pya\":\"ye\",\"components\":[\"possessive_marker_\"],\"english\":\"possessive\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"user-approved-character-mapping\",\"sources\":[\"WALS Online Feature 86A: Order of Genitive and Noun\"],\"rationale\":\"User-directed Pyash mapping: 的 is assigned to genitive_case_ ti and 之 to possessive_marker_ ye under the one-character-to-one-atom rule, using WALS global frequency as the priority basis.\"}" ya
su text "chinese-character-link:8963715e9af9" ob text "{\"character\":\"对\",\"targetId\":\"grammar:destination_case_:ma\",\"pya\":\"ma\",\"components\":[\"destination_case_\"],\"english\":\"to\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '对' functions as a preposition indicating direction or target (e.g., 'towards', 'to face') in the provided UD contexts. This aligns with the Pyash target 'grammar:destination_case_:ma' (English: 'to'). The frequency of this usage is supported by the high count of 'ADP' tags (194) where\"}" ya
su text "chinese-character-link:f6feb7c6e52a" ob text "{\"character\":\"从\",\"targetId\":\"grammar:source_case_:so\",\"pya\":\"so\",\"components\":[\"source_case_\"],\"english\":\"from\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '从' is attested in UD Chinese-GSDSimp contexts with the POS tag 'ADP' (Adposition) defining source/origin (e.g., 'from', 'since'). This aligns directly with the target 'grammar:source_case_:so' which covers meanings like 'from'. The frequency count for this grammatical use is 140, and\"}" ya
su text "chinese-character-link:12758caeee70" ob text "{\"character\":\"多\",\"targetId\":\"grammar:multal_number_:tl6h\",\"pya\":\"tl6h\",\"components\":[\"multal_number_\"],\"english\":\"many\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '多' is attested in Classical texts (Analects) and modern UD data with the meaning 'many/much', directly mapping to the target 'many'. The frequency count for this sense is high across all sources.\"}" ya
su text "chinese-character-link:2655b3c0b4a4" ob text "{\"character\":\"会\",\"targetId\":\"grammar:potential_mood_:tseh\",\"pya\":\"tseh\",\"components\":[\"potential_mood_\"],\"english\":\"can\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '会' is attested in UD Chinese-GSDSimp with the POS tag AUX (200 instances) and PART (137 instances). The provided dictionary glosses explicitly include 'can (i.e. have the skill, know how to)', which aligns perfectly with the target definition 'can'. The high frequency of the AUX tag (\"}" ya
su text "chinese-character-link:84c76c2d213c" ob text "{\"character\":\"但\",\"targetId\":\"grammar:but_:pyuh\",\"pya\":\"pyuh\",\"components\":[\"but_\"],\"english\":\"but\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '但' is attested in UD Chinese-GSDSimp with 221 instances tagged as SCONJ (conjunction), corresponding to the English sense 'but'. This matches the existing target 'grammar:but_:pyuh' which has an alias 'but'. The usage frequency (221) supports a strong link, and no other grammatical or\"}" ya
su text "chinese-character-link:ecabf76bbbdd" ob text "{\"character\":\"到\",\"targetId\":\"grammar:terminative_case_:tweh\",\"pya\":\"tweh\",\"components\":[\"terminative_case_\"],\"english\":\"until\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '到' functions as a postposition indicating a temporal limit ('until', 'up to') in the provided UD contexts (e.g., '自 2002 年到目前', '4 年到 6 年'). This aligns with the target definition 'until'. The frequency count for this usage is 50 (sum of CCONJ and ADP tags where it acts as a limit), a\"}" ya
su text "chinese-character-link:1047294bb79d" ob text "{\"character\":\"在\",\"targetId\":\"grammar:way_case_:ga\",\"pya\":\"ga\",\"components\":[\"way_case_\"],\"english\":\"at\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '在' functions as a preposition indicating location (e.g., 'at', 'in'), which maps directly to the Pyash target 'grammar:way_case_:ga' (english: 'at'). This is supported by high-frequency attestation in UD Chinese-GSDSimp (1061 instances) and classical texts like the Analects ('父在', '神在\"}" ya
su text "chinese-character-link:c48bdeeedeff" ob text "{\"character\":\"如\",\"targetId\":\"grammar:essive_case_:swih\",\"pya\":\"swih\",\"components\":[\"essive_case_\"],\"english\":\"as\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '如' is attested in UD Chinese-GSDSimp with POS tags ADV (3 instances) and ADP (6 instances). The definitions provided ('as', 'as if', 'such as') align perfectly with the target 'grammar:essive_case_:swih' (English gloss: 'as'). The usage contexts (e.g., '视父亲如仇人' - regard father as an仇人\"}" ya
su text "chinese-character-link:06236267202c" ob text "{\"character\":\"常\",\"targetId\":\"grammar:frequentative_aspect_:ra2\",\"pya\":\"ra2\",\"components\":[\"frequentative_aspect_\"],\"english\":\"often\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '常' is attested with the grammatical function of an adverb (ADV) meaning 'often', 'frequently', or 'always' in multiple independent sources. The UD Chinese-GSDSimp corpus provides 21 instances tagged as ADV, directly supporting the target definition 'often'. This aligns perfectly with\"}" ya
su text "chinese-character-link:f568e913e188" ob text "{\"character\":\"我\",\"targetId\":\"grammar:me_:mi\",\"pya\":\"mi\",\"components\":[\"me_\"],\"english\":\"i\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '我' is attested as a first-person pronoun (I/me) in all provided sources. The UD Chinese-GSDSimp corpus explicitly tags it as 'PRON' with a frequency of 36. Classical texts (Analects) and CC-CEDICT confirm the core meaning 'I/me'. This matches the existing target 'grammar:me_:mi' which\"}" ya
su text "chinese-character-link:cf0ebe9c50f0" ob text "{\"character\":\"或\",\"targetId\":\"grammar:and_or_:ba\",\"pya\":\"ba\",\"components\":[\"and_or_\"],\"english\":\"or\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '或' is attested in Classical Chinese (Analects) and Modern Chinese (UD treebank) exclusively as a conjunction meaning 'or' or 'perhaps'. The UD counts show 164 instances tagged as CCONJ, aligning perfectly with the target definition 'or'. No other grammatical targets are available, and\"}" ya
su text "chinese-character-link:90300981ad47" ob text "{\"character\":\"数\",\"targetId\":\"grammar:paucal_number_:po\",\"pya\":\"po\",\"components\":[\"paucal_number_\"],\"english\":\"several\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '数' (shu4) has a lexical meaning of 'number' or 'several'. The UD Chinese-GSDSimp corpus provides 15 instances tagged as PART where the character functions grammatically to denote an indefinite quantity ('several', 'a number of'), directly supporting the target 'grammar:paucal_number_:\"}" ya
su text "chinese-character-link:990d40c3d628" ob text "{\"character\":\"某\",\"targetId\":\"grammar:assertive_quantifier_:tlih\",\"pya\":\"tlih\",\"components\":[\"assertive_quantifier_\"],\"english\":\"a\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '某' is attested in Classical texts (Analects) and modern UD data exclusively as an indefinite pronoun meaning 'a certain' or 'some'. The UD tag 'DET' with frequency 6 aligns perfectly with the target's definition 'a/an/some'. No other grammatical targets are supported by the provided '\"}" ya
su text "chinese-character-link:d880e4da2cc0" ob text "{\"character\":\"这\",\"targetId\":\"grammar:demonstrative_:tsah\",\"pya\":\"tsah\",\"components\":[\"demonstrative_\"],\"english\":\"this\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '这' is attested in UD Chinese-GSDSimp contexts with POS tags DET (317 instances) and PRON (76 instances), functioning as a demonstrative pronoun meaning 'this/these'. This aligns directly with the existing target 'grammar:demonstrative_:tsah' (English: 'this'). The usage is robustly e-\"}" ya
su text "chinese-character-link:ddbbc6f9a29f" ob text "{\"character\":\"甚\",\"targetId\":\"grammar:elective_quantifier_:tlah\",\"pya\":\"tlah\",\"components\":[\"elective_quantifier_\"],\"english\":\"any\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '甚' is attested in Classical contexts (Analects) with the meaning 'any' or 'what' (e.g., '唯何甚'), which aligns semantically with the target definition 'any'. Modern usage in UD Chinese-GSDSimp tags it as an ADV, but the specific lexical sense of 'any' is supported by the Classical gloss\"}" ya
su text "chinese-character-link:a2a16804a2e7" ob text "{\"character\":\"自\",\"targetId\":\"grammar:antessive_case_:tsi7h\",\"pya\":\"tsi7h\",\"components\":[\"antessive_case_\"],\"english\":\"since\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '自' is attested in UD Chinese-GSDSimp with the tag 'ADP' (preposition) meaning 'since' (e.g., '自 2006 年', '自古以来'). This aligns directly with the target 'grammar:antessive_case_:tsi7h' which covers senses 'since' and 'before'. The frequency count for this sense is high in the provided G\"}" ya
su text "chinese-character-link:93a50cc2ba68" ob text "{\"character\":\"跟\",\"targetId\":\"grammar:comitative_case_:mwah\",\"pya\":\"mwah\",\"components\":[\"comitative_case_\"],\"english\":\"with\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '跟' is attested in UD Chinese-GSDSimp contexts with the POS tag 'ADP' (Adposition) functioning as a preposition meaning 'with' or 'along with' (e.g., 'go with', 'compared with'). This aligns directly with the existing target 'grammar:comitative_case_:mwah' which covers the sense 'with'\"}" ya
su text "chinese-character-link:cbe90832fa60" ob text "{\"character\":\"中\",\"targetId\":\"grammar:associative_case_:sa7\",\"pya\":\"sa7\",\"components\":[\"associative_case_\"],\"english\":\"among\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '中' carries the meaning 'among' (e.g., 'in the midst of', 'among people'). The UD data supports this with 380 'ADP' instances. This aligns with the target 'among\"}" ya
su text "chinese-character-link:b90003e4d785" ob text "{\"character\":\"可\",\"targetId\":\"grammar:permissive_mood_:mwih\",\"pya\":\"mwih\",\"components\":[\"permissive_mood_\"],\"english\":\"may\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '可' also functions as an auxiliary verb indicating permission or possibility ('may', 'to be allowed') in contexts like '不可行' (not permissible/possible). This aligns with the target 'grammar:permissive_mood_:mwih' (English: 'may'), supported by a relevant use frequency of 106.\"}" ya
su text "chinese-character-link:3010c15cfa66" ob text "{\"character\":\"于\",\"targetId\":\"grammar:agentive_case_:je\",\"pya\":\"je\",\"components\":[\"agentive_case_\"],\"english\":\"by\",\"relation\":\"base\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"CCL-2015-112 classical function-character candidate set\",\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"In Classical Chinese, '于' can introduce the agent or instrument in passive constructions (e.g., '制於人' - controlled by people), though less frequent than locative uses. This maps to 'grammar:agentive_case_:je' (english: 'by').\"}" ya
su text "chinese-character-link:c9745df70af9" ob text "{\"character\":\"们\",\"targetId\":\"grammar:plural_number_:pu\",\"pya\":\"pu\",\"components\":[\"plural_number_\"],\"english\":\"plural\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"user-approved-character-mapping\",\"sources\":[\"CC-CEDICT\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"CC-CEDICT defines 们 as the plural marker for pronouns and nouns referring to individuals. This is a direct grammatical match for plural_number_, with the known restriction that it does not mark plural on all nouns.\"}" ya
su text "chinese-character-link:1290bcd203be" ob text "{\"character\":\"的\",\"targetId\":\"grammar:genitive_case_:ti\",\"pya\":\"ti\",\"components\":[\"genitive_case_\"],\"english\":\"genitive\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"user-approved-character-mapping\",\"sources\":[\"CC-CEDICT\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"CC-CEDICT defines 的 as 'of' and as the possessive particle. The genitive 'of' use is assigned this character under the one-character-to-one-atom rule; possessive uses in Chinese are also expressed with 的.\"}" ya
su text "chinese-character-link:6b6d4b0af189" ob text "{\"character\":\"有\",\"targetId\":\"grammar:existential_clause_:syi7h\",\"pya\":\"syi7h\",\"components\":[\"existential_clause_\"],\"english\":\"there are\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"user-approved-character-mapping\",\"sources\":[\"CC-CEDICT\"],\"rationale\":\"CC-CEDICT defines 有 as 'there is', 'there are', and 'to exist', directly matching the existential clause atom.\"}" ya
su text "chinese-character-link:47a502dfc58c" ob text "{\"character\":\"例\",\"targetId\":\"grammar:example_:fluh\",\"pya\":\"fluh\",\"components\":[\"example_\"],\"english\":\"example\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"user-approved-character-mapping\",\"sources\":[\"CC-CEDICT\",\"Unihan 18.0.0\"],\"rationale\":\"CC-CEDICT defines 例 as 'example', 'case', and 'instance', directly matching example_.\"}" ya
su text "chinese-character-link:3320b923eb99" ob text "{\"character\":\"进\",\"targetId\":\"grammar:illative_case_:twih\",\"pya\":\"twih\",\"components\":[\"illative_case_\"],\"english\":\"into\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"user-approved-character-mapping\",\"sources\":[\"CC-CEDICT\",\"Unihan 18.0.0\"],\"rationale\":\"CC-CEDICT defines 进 as 'go in', 'enter', and 'put in', matching the destination-inside meaning of illative_case_.\"}" ya
su text "chinese-character-link:1ba36dacd92f" ob text "{\"character\":\"上\",\"targetId\":\"grammar:sublative_case_:sweh\",\"pya\":\"sweh\",\"components\":[\"sublative_case_\"],\"english\":\"onto\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"user-approved-character-mapping\",\"sources\":[\"CC-CEDICT\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"CC-CEDICT defines 上 as 'on top', 'upon', and 'to get onto'. In locative constructions it marks the surface destination for sublative_case_.\"}" ya
