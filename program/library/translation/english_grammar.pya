su text "chinese-character-link:468a6683cee5" ob text "{\"character\":\"亦\",\"targetId\":\"grammar:also_:pcah\",\"pya\":\"pcah\",\"components\":[\"also_\"],\"english\":\"also\",\"relation\":\"same-sense\",\"confidence\":\"high\",\"status\":\"accepted\",\"source\":\"chinese-character-grammar-refinery\",\"sources\":[\"Project Gutenberg eBook 4094 Analects witness\",\"Project Gutenberg eBook 23839 Analects witness\",\"UD Chinese-GSDSimp @ b79a1c2f7ba7f9b264808d91c6886a67b7f847a3\"],\"rationale\":\"The character '亦' is attested in Classical texts (Analects) and modern UD data with the meaning 'also'. The UD Chinese-GSDSimp corpus explicitly tags instances of '亦' as SCONJ (subordinating conjunction/adverb) with the semantic value of addition ('also', 'too'). This aligns perfectly with the Pyash\"}" ya
