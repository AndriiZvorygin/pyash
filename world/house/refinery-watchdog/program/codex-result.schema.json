{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reporters", "root_cause", "changed_files", "tests", "reruns", "publication_urls", "remaining_risks"],
  "properties": {
    "status": { "type": "string", "enum": ["fixed", "no_action", "needs_human", "failed"] },
    "reporters": { "type": "array", "items": { "type": "string" } },
    "root_cause": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "reruns": { "type": "array", "items": { "type": "string" } },
    "publication_urls": { "type": "array", "items": { "type": "string" } },
    "remaining_risks": { "type": "array", "items": { "type": "string" } }
  }
}
