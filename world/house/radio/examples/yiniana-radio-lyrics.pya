from filename "../module/hymn_manuscript.pya" to name hymn manuscript be import do

ob ve text text topic text text radio_dir be input ya

ob text "node command/yiniana_lyrics_chain.mjs " to name radio helper command be plus do
ob name text topic to name radio helper command be plus do
ob text " " to name radio helper command be plus do
ob name text radio_dir to name radio helper command be plus do
ob name text radio helper command be command do

ob name text radio_dir to name text radio teaching path be text do
ob text "/lyrics/teaching-" to name radio teaching path be plus do
ob name text topic to name radio teaching path be plus do
ob text ".txt" to name radio teaching path be plus do
su name radio teaching filename ob name text radio teaching path to name filename radio teaching filename be filename do

su name radio song from filename of ob of radio teaching filename to name text radio song out be hymn manuscript do

ob name text radio_dir to name text radio song path be text do
ob text "/lyrics/song-" to name radio song path be plus do
ob name text topic to name radio song path be plus do
ob text ".txt" to name radio song path be plus do
su name radio song filename ob name text radio song path to name filename radio song filename be filename do
su name radio song artifact ob name text radio song out to filename of ob of radio song filename be write do

ob text "node command/yiniana_lyrics_chain.mjs --verify-song " to name radio verify command be plus do
ob name text radio song path to name radio verify command be plus do
ob name text radio verify command be command do
