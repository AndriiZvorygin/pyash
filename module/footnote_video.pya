su name footnote burn command record fromtext text command with filename output be ceremony def
  ob name run root to name text workspace root be text do
  ob name run id to name text run id text be text do

  ob text "mkdir -p \"" to name text mkdir cmd be text do
  ob name text workspace root to name mkdir cmd be plus do
  ob text "/artifacts/" to name mkdir cmd be plus do
  ob name text run id text to name mkdir cmd be plus do
  ob text "/newspaper\"" to name mkdir cmd be plus do
  ob name text mkdir cmd be command do

  ob text "basename \"" to name text basename cmd be text do
  ob filename of with of this to name text output path be text do
  ob name text output path to name basename cmd be plus do
  ob text "\"" to name basename cmd be plus do
  su name basename stage ob name text basename cmd to name text basename out be command do

  ob name text workspace root to name text command log path be text do
  ob text "/artifacts/" to name command log path be plus do
  ob name text run id text to name command log path be plus do
  ob text "/newspaper/" to name command log path be plus do
  ob text of ob of basename stage to name command log path be plus do
  ob text ".footnote-command.txt" to name command log path be plus do
  su name command log filename stage ob name text command log path to name filename command log filename be filename do
  su name command log write stage ob text of from of this to filename of ob of command log filename stage be write do
  su name command log filename stage ret
prah

su name footnote from filename subtitle fromstate wo srt with filename video become wo video to filename output be ceremony def
  ob name run root to name text workspace root be text do
  exists su name cmd ob text "node \"" be text ya
  ob name text workspace root to name cmd be plus do
  ob text "/command/footnote_video.mjs\"" to name cmd be plus do
  ob text " \"" to name cmd be plus do
  ob filename of with of this to name text video path be text do
  ob name video path to name cmd be plus do
  ob text "\"" to name cmd be plus do
  ob text " \"" to name cmd be plus do
  ob filename of from of this to name text subtitle path be text do
  ob name subtitle path to name cmd be plus do
  ob text "\"" to name cmd be plus do
  ob text " \"" to name cmd be plus do
  ob filename of to of this to name text output path be text do
  ob name output path to name cmd be plus do
  ob text "\"" to name cmd be plus do
  ob text " --mode plain" to name cmd be plus do
  su name footnote burn command stage fromtext text of ob of cmd with filename of to of this be footnote burn command record do
  ob text of cmd be command do
  su name result ret
prah

