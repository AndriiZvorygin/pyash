su name zai mind runner ob text payload be ceremony def
  exists su name cmd ob text "node command/mind_openai_runner.mjs --zai-codex" be text ya
  ob text of ob of this to name text payload text local be text do
  su name run ob text of cmd fromtext name payload text local be command do
  su name run ret
prah

su name zai mind runner ob text payload vyah stream be ceremony def
  exists su name cmd ob text "node command/mind_openai_runner.mjs --zai-codex --stream" be text ya
  ob text of ob of this to name text payload text local be text do
  su name run ob text of cmd fromtext name payload text local vyah stream be command do
  su name run ret
prah

su name zai command mind ob text payload be ceremony def
  su name run ob text of ob of this be zai mind runner do
  su name run ret
prah

su name zai command mind ob text payload vyah stream be ceremony def
  su name run ob text of ob of this vyah stream be zai mind runner do
  su name run ret
prah

exists su name zai command mind be export ya
