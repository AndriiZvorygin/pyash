from filename "./pandoc_command.pya" to name pandoc command be import do

su name read from filename input fromstate wo html become wo markdown be ceremony def
  ob name "pandoc command html markdown prefix" to name text cmd be text do
  ob filename of from of this to name text input be text do
  ob name input to name cmd be plus do
  ob name "pandoc command html markdown suffix" to name text suffix be text do
  ob name suffix to name cmd be plus do
  ob text of cmd be command do
  su name result ret
