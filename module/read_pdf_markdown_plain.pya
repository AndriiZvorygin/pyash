su name read from filename input fromstate wo pdf become wo markdown plain be ceremony def
  exists su name cmd ob text "pdftohtml -stdout -i -q \"" be text ya
  ob filename of from of this to name text input be text do
  ob name input to name cmd be plus do
  ob text "\" | pandoc --from=html-native_divs-native_spans --to=markdown --wrap=none | sed -e 's/<span[^>]*><\\/span>//g' -e '/^-----/d'" to name cmd be plus do
  ob text of cmd be command do
  su name result ret
prah

su name read from filename input fromstate wo pdf become wo markdown plain to name text output be ceremony def
  exists su name cmd ob text "pdftohtml -stdout -i -q \"" be text ya
  ob filename of from of this to name text input be text do
  ob name input to name cmd be plus do
  ob text "\" | pandoc --from=html-native_divs-native_spans --to=markdown --wrap=none | sed -e 's/<span[^>]*><\\/span>//g' -e '/^-----/d'" to name cmd be plus do
  ob text of cmd to name text output be command do
  su name output ret
prah

exists su name read be export ya
