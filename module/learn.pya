prah

su name learn from text source with text learning focus to name text teaching out be ceremony def
  ob text of with of this be equally from text "" then
  ob bool lie fromtext text "learning focus defective: give a non-empty learning focus" be guarantee do
  su name teaching card stage from text of from of this with text of with of this to name text teaching card be learn extract card do
  su name teaching stage from text of ob of teaching card with text of with of this to name text teaching out be learn refine card do
  su name learning source support verify stage from text of from of this with text of ob of teaching out to name text learning source support pass be learning source support do
  ob text of ob of learning source support pass be equally from text "FAIL" then
  ob bool lie fromtext text "learning source support defective" be guarantee do
  su name ollama discharge stage as wo ollama be discharge do
  su name teaching out ret
prah

su name learn from filename source with text learning focus to name text teaching out be ceremony def
  ob text of with of this be equally from text "" then
  ob bool lie fromtext text "learning focus defective: give a non-empty learning focus" be guarantee do
  su name learning pipeline cmd begin stage ob text "PYA_COMMAND_TIMEOUT_MS=900000 node command/learn_from_filename_pipeline.mjs \"" to name text learning pipeline cmd be text do
  ob text of from of this to name learning pipeline cmd be plus do
  ob text "\" \"" to name learning pipeline cmd be plus do
  ob text of with of this to name learning pipeline cmd be plus do
  ob text "\"" to name learning pipeline cmd be plus do
  su name teaching raw stage ob text of ob of learning pipeline cmd to name text teaching raw be command do
  ob text "node command/extract_learn_pipeline_result.mjs" fromtext name teaching raw to name text teaching out be command do
  su name teaching out ret
prah

