su name mind ob text payload be ceremony def
  exists su name cmd ob text "node command/mind_ollama_runner.mjs --payload-file " be text ya
  ob text of ob of this to filename "artifacts/mind/ollama-request.json" be write do
  ob text "artifacts/mind/ollama-request.json" to name cmd be plus do
  ob text of cmd be command do
prah
su name mind ob text payload vyah stream be ceremony def
  exists su name cmd ob text "node command/mind_ollama_runner.mjs --stream --payload-file " be text ya
  ob text of ob of this to filename "artifacts/mind/ollama-request.json" be write do
  ob text "artifacts/mind/ollama-request.json" to name cmd be plus do
  su name run ob text of cmd vyah stream be command do
  su name run ret
prah
su name begin ob text model be ceremony def
  exists su name payload ob text "{\"mode\":\"generate\",\"model\":\"" be text ya
  ob text of ob of this to name payload be plus do
  ob text "\",\"prompt\":\"\",\"keep_alive\":300" to name payload be plus do
  ob name ollama host to name text host be text do
  ob text ",\"host\":\"" to name payload be plus do
  ob name host to name payload be plus do
  ob text "\"}" to name payload be plus do
  exists su name cmd ob text "node command/mind_ollama_runner.mjs" be text ya
  ob text of cmd fromtext text of payload be command do
  ob text "ollama mind begun" ret
prah
su name begin ob text model to name text target be ceremony def
  exists su name payload ob text "{\"mode\":\"generate\",\"model\":\"" be text ya
  ob text of ob of this to name payload be plus do
  ob text "\",\"prompt\":\"\",\"keep_alive\":300" to name payload be plus do
  ob name ollama host to name text host be text do
  ob text ",\"host\":\"" to name payload be plus do
  ob name host to name payload be plus do
  ob text "\"}" to name payload be plus do
  exists su name cmd ob text "node command/mind_ollama_runner.mjs" be text ya
  ob text of cmd fromtext text of payload be command do
  ob text "ollama mind begun" ret
prah
su name discharge ob text model be ceremony def
  exists su name payload ob text "{\"mode\":\"generate\",\"model\":\"" be text ya
  ob text of ob of this to name payload be plus do
  ob text "\",\"prompt\":\"\",\"keep_alive\":0" to name payload be plus do
  ob name ollama host to name text host be text do
  ob text ",\"host\":\"" to name payload be plus do
  ob name host to name payload be plus do
  ob text "\"}" to name payload be plus do
  exists su name cmd ob text "node command/mind_ollama_runner.mjs" be text ya
  ob text of cmd fromtext text of payload be command do
  ob text "ollama mind discharged" ret
prah
su name discharge ob text model to name text target be ceremony def
  exists su name payload ob text "{\"mode\":\"generate\",\"model\":\"" be text ya
  ob text of ob of this to name payload be plus do
  ob text "\",\"prompt\":\"\",\"keep_alive\":0" to name payload be plus do
  ob name ollama host to name text host be text do
  ob text ",\"host\":\"" to name payload be plus do
  ob name host to name payload be plus do
  ob text "\"}" to name payload be plus do
  exists su name cmd ob text "node command/mind_ollama_runner.mjs" be text ya
  ob text of cmd fromtext text of payload be command do
  ob text "ollama mind discharged" ret
prah
su name restart ob text model be ceremony def
  ob text of ob of this be discharge do
  ob text of ob of this be begin do
  ob text "ollama mind restarted" ret
prah
su name restart ob text model to name text target be ceremony def
  ob text of ob of this be discharge do
  ob text of ob of this be begin do
  ob text "ollama mind restarted" ret
prah
exists su name mind be export ya
exists su name begin be export ya
exists su name discharge be export ya
exists su name restart be export ya
