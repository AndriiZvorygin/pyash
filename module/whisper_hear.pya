su name hear from filename input be ceremony def
  exists su name cmd ob text "node command/whisper_main.mjs --input " be text ya
  ob filename of from of this to name text input be text do
  ob name input to name cmd be plus do
  ob text " --bin " to name cmd be plus do
  ob name hear bin to name cmd be plus do
  ob text " --model " to name cmd be plus do
  ob name hear model to name cmd be plus do
  ob text of cmd be command do
  su name result ret
